---
import styles from "@styles/navigation.module.scss";
import classnames from "classnames";
import { nav } from "../data/index.json";

const {
  position,
  id,
  "aria-label": ariaLabel = "Ana Navigasyon",
} = Astro.props;
const classNames = classnames(
  styles.nav,
  position === "mobile"
    ? styles.mobile
    : position === "footer"
      ? styles.footer
      : styles.desktop
);
---

<nav class={classNames} aria-label={ariaLabel} id={id} role="navigation">
  <ul>
    {
      nav.map((item) => (
        <li
          class={classnames(styles["list-item"], item.items ? styles.sub : "")}
          data-sub={item.items && item.items.length > 0 ? "true" : "false"}
          aria-haspopup={item.items && item.items.length > 0 ? "true" : "false"}
          aria-expanded="false"
        >
          <a href={item.slug} class={styles["list-link"]}>
            <span>{item.name}</span>
          </a>
          {item.items && (
            <div class={styles.subnav}>
              <ul>
                {item.items.map((subItem) => (
                  <li>
                    <a href={subItem.slug}>
                      <span>{subItem.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ul>

  <slot />
</nav>
