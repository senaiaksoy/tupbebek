---
// New design system styles (2026)
import '../styles/globals.css';
import '../styles/tokens.css';
import '../styles/animations.css';

// Legacy styles (compatibility)
import '../styles/components.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SearchAutocomplete from '../components/SearchAutocomplete.astro';
import { normalizeInternalPath } from '../utils/routeAliases.mjs';
import { resolveCanonicalUrl, resolveSiteUrl, resolveSocialImageUrl } from '../utils/seo';
import { getImageDimensions } from '../utils/imageMetadata';

interface Props {
	title: string;
	description?: string;
	/** Optional OG/Twitter image URL (absolute or relative to public/) */
	image?: string;
	/** og:image intrinsic dimensions — defaults match the actual default social image
	 * (`/images/home/luxury-embryo.webp`, 1024×1024). Article pages override with their
	 * own hero dimensions resolved from the build-time manifest. Lying about dimensions
	 * breaks Twitter `summary_large_image` and Facebook crop preview. */
	imageWidth?: number;
	imageHeight?: number;
	/** og:type — defaults to "website", article pages should pass "article" */
	ogType?: string;
	canonical?: string;
	noindex?: boolean;
	robots?: string;
	hideBreadcrumbs?: boolean;
}

const {
	title,
	description = "tupbebek.com | Üreme Sağlığı Bilgisi",
	image,
	imageWidth,
	imageHeight,
	ogType = "website",
	canonical,
	noindex = false,
	robots,
	hideBreadcrumbs = false,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const normalizedPath = normalizeInternalPath(Astro.url.pathname);
const siteUrl = resolveSiteUrl(Astro.site);
const canonicalUrl = resolveCanonicalUrl({ siteUrl, pathname: normalizedPath, canonical });
const socialImageUrl = resolveSocialImageUrl({ siteUrl, image });

// og:image dimension resolution order:
//   1. Explicit imageWidth/imageHeight props (article pages pass these from build manifest)
//   2. Build-time manifest lookup for the actual image (covers static pages that pass `image` only)
//   3. Default social image dimensions (1024×1024, the bundled `luxury-embryo.webp`)
const DEFAULT_SOCIAL_DIMS = { width: 1024, height: 1024 };
const resolvedSocialDims = (imageWidth && imageHeight)
	? { width: imageWidth, height: imageHeight }
	: (getImageDimensions(image) ?? DEFAULT_SOCIAL_DIMS);
const robotsContent = noindex
	? 'noindex, follow, max-image-preview:large'
	: (robots || 'index, follow, max-image-preview:large');
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-K3VE72CSDJ';
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || '';
const googleAdsConversionLabels = {
	expert_consultation: import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_EXPERT_CONSULTATION || '',
	contact_submission: import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_CONTACT_SUBMISSION || '',
	ebook_download: import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_EBOOK_DOWNLOAD || '',
};

// Sitewide @graph: Organization + WebSite + MedicalWebPage with stable @ids.
// Organization @id is the canonical publisher node that every Article, Person,
// and WebPage on the site references. Don't rename without updating all schemas.
const ORG_ID = 'https://tupbebek.com/#organization';
const WEBSITE_ID = 'https://tupbebek.com/#website';
const LOGO_ID = 'https://tupbebek.com/#logo';
const EDITORIAL_BOARD_ID = 'https://tupbebek.com/yayin-kurulu/#editorial-board';
const pageId = `${canonicalUrl}#webpage`;

const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORG_ID,
      "name": "tupbebek.com",
      "alternateName": "tupbebek.com Yayın Kurulu",
      "url": "https://tupbebek.com/",
      "logo": {
        "@type": "ImageObject",
        "@id": LOGO_ID,
        "url": "https://tupbebek.com/images/logo-tupbebek.webp",
        "width": 2201,
        "height": 964,
        "caption": "tupbebek.com"
      },
      "image": { "@id": LOGO_ID },
      "description": "Türkiye'nin bağımsız, reklamsız, bilimsel üreme sağlığı ve infertilite referans portalı.",
      "foundingDate": "1996",
      "knowsAbout": [
        "Üreme Tıbbı",
        "Tüp Bebek (İVF)",
        "İnfertilite",
        "Kadın Hastalıkları",
        "Erkek Üreme Sağlığı",
        "Embriyoloji"
      ],
      "areaServed": { "@type": "Country", "name": "Türkiye" },
      "ethicsPolicy": "https://tupbebek.com/editoryal-politika/",
      "publishingPrinciples": "https://tupbebek.com/editoryal-politika/",
      "diversityPolicy": "https://tupbebek.com/editoryal-politika/",
      "correctionsPolicy": "https://tupbebek.com/editoryal-politika/",
      "actionableFeedbackPolicy": "https://tupbebek.com/iletisim/",
      "subjectOf": { "@id": EDITORIAL_BOARD_ID },
      "founder": { "@id": "https://senaiaksoy.net/#person" },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+90-533-254-60-40",
        "email": "dr@senaiaksoy.net",
        "contactType": "editorial inquiries",
        "availableLanguage": "Turkish"
      }
    },
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      "url": "https://tupbebek.com/",
      "name": "tupbebek.com",
      "description": "Bağımsız üreme sağlığı yayın portalı.",
      "publisher": { "@id": ORG_ID },
      "inLanguage": "tr-TR"
    },
    {
      "@type": "MedicalWebPage",
      "@id": pageId,
      "name": title,
      "description": description,
      "url": canonicalUrl,
      "inLanguage": "tr-TR",
      "isPartOf": { "@id": WEBSITE_ID },
      "publisher": { "@id": ORG_ID },
      "author": { "@id": ORG_ID },
      "reviewedBy": { "@id": EDITORIAL_BOARD_ID },
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": "Patient"
      },
      "specialty": {
        "@type": "MedicalSpecialty",
        "name": "Üreme Sağlığı"
      }
    }
  ]
};
---

<!doctype html>
<html lang="tr-TR" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="theme-color" content="#2563a8" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="tr-TR" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<meta name="robots" content={robotsContent} />

		<!-- RSS Feed -->
		<link rel="alternate" type="application/rss+xml" title="tupbebek.com RSS" href="/rss.xml" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content={String(resolvedSocialDims.width)} />
		<meta property="og:image:height" content={String(resolvedSocialDims.height)} />
		<meta property="og:site_name" content="tupbebek.com" />
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:image:alt" content={description} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:site" content="@tupbebek" />

		<!-- Google Analytics (GA4) - Consent Mode v2 advanced implementation -->
		<script define:vars={{ gaMeasurementId, googleAdsId, googleAdsConversionLabels }}>
			const analyticsConsentKey = 'cookie-consent-v1.4';
			const getAnalyticsConsentStatus = () => {
				try {
					return localStorage.getItem(analyticsConsentKey);
				} catch {
					return null;
				}
			};

			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
			window.gtag('consent', 'default', {
				analytics_storage: 'denied',
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				url_passthrough: true,
				ads_data_redaction: true,
				wait_for_update: 500
			});

			function updateAnalyticsConsent(status) {
				const isAccepted = status === 'accepted';
				window.gtag('consent', 'update', {
					analytics_storage: isAccepted ? 'granted' : 'denied',
					ad_storage: isAccepted ? 'granted' : 'denied',
					ad_user_data: isAccepted ? 'granted' : 'denied',
					ad_personalization: 'denied'
				});
			}

			function loadMeasurement() {
				if (window.gaLoaded) return;
				window.gaLoaded = true;
				window.__loadGA = loadMeasurement;
				
				// Load script
				const script = document.createElement('script');
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId || googleAdsId)}`;
				document.head.appendChild(script);

				// Init measurement destinations.
				window.gtag('js', new Date());
				const consentStatus = getAnalyticsConsentStatus();
				if (consentStatus === 'accepted' || consentStatus === 'rejected') {
					updateAnalyticsConsent(consentStatus);
				}
				if (gaMeasurementId) {
					window.gtag('config', gaMeasurementId);
				}
				if (googleAdsId) {
					window.gtag('config', googleAdsId);
				}
			}

			window.__loadGA = loadMeasurement;

			window.__trackGaEvent = function(eventName, params = {}) {
				loadMeasurement();
				if (!window.gaLoaded) return;
				window.gtag('event', eventName, params);
			};

			window.__trackLeadConversion = function(eventName, params = {}) {
				loadMeasurement();
				if (!window.gaLoaded) return;

				window.gtag('event', eventName, params);

				const conversionLabel = googleAdsConversionLabels[eventName];
				if (!googleAdsId || !conversionLabel) return;

				window.gtag('event', 'conversion', {
					...params,
					send_to: `${googleAdsId}/${conversionLabel}`,
					event_category: params.event_category || 'lead'
				});
			};

			loadMeasurement();

			window.addEventListener('cookie-consent:updated', function(event) {
				const status = event.detail?.status;
				updateAnalyticsConsent(status);
				window.gtag('event', 'cookie_consent_choice', {
					consent_status: status === 'accepted' ? 'accepted' : 'rejected',
					analytics_consent: status === 'accepted' ? 'granted' : 'denied',
					ads_consent: status === 'accepted' ? 'granted' : 'denied',
					event_category: 'privacy',
					non_interaction: true
				});
				if (status === 'accepted') {
					window.gtag('event', 'page_view', {
						page_title: document.title,
						page_location: window.location.href,
						page_path: window.location.pathname
					});
				}
			});
		</script>

		<!-- Preload Fonts -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/material-symbols.woff2" as="font" type="font/woff2" crossorigin />

		<!-- LCP preload: hero image. Pages MUST pass `image=` prop and the matching <img> must use fetchpriority="high". -->
		{image && <link rel="preload" as="image" href={image} fetchpriority="high" />}



		<style is:global>
			/* Local Font Definitions */
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 100 900;
				font-display: swap;
				src: url('/fonts/inter-latin-ext.woff2') format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			@font-face {
				font-family: 'Inter';
				font-style: normal;
				font-weight: 100 900;
				font-display: swap;
				src: url('/fonts/inter-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Manrope';
				font-style: normal;
				font-weight: 200 800;
				font-display: swap;
				src: url('/fonts/manrope-latin-ext.woff2') format('woff2');
				unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
			}
			@font-face {
				font-family: 'Manrope';
				font-style: normal;
				font-weight: 200 800;
				font-display: swap;
				src: url('/fonts/manrope-latin.woff2') format('woff2');
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			@font-face {
				font-family: 'Material Symbols Outlined';
				font-style: normal;
				font-weight: 400;
				font-display: block;
				src: url('/fonts/material-symbols.woff2') format('woff2');
			}

			.material-symbols-outlined {
				font-family: 'Material Symbols Outlined';
				font-weight: normal;
				font-style: normal;
				font-size: 24px;
				line-height: 1;
				letter-spacing: normal;
				text-transform: none !important;
				display: inline-block;
				white-space: nowrap;
				word-wrap: normal;
				direction: ltr;
				-webkit-font-feature-settings: 'liga';
				-webkit-font-smoothing: antialiased;
			}
			/* Skip Navigation Link (A11y) */
			.skip-link {
				position: absolute;
				top: -100%;
				left: 50%;
				transform: translateX(-50%);
				z-index: 9999;
				padding: 0.75rem 1.5rem;
				background-color: #35618f;
				color: #f5f7ff;
				font-size: 1rem;
				font-weight: 700;
				border-radius: 0.5rem;
				transition: top 0.15s ease-out;
			}
			.skip-link:focus,
			.skip-link:focus-visible {
				top: 1rem;
				outline: 3px solid #dbeafe;
				outline-offset: 3px;
			}

			/* Typography reset */
			html, body {
				overflow-x: hidden;
				width: 100%;
			}

			body {
				font-family: 'Manrope', sans-serif;
				font-size: 16px;
				line-height: 1.65;
				letter-spacing: -0.005em;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			/* Fluid headings with clamp */
			h1, h2, h3, h4, h5, h6, .font-headline {
				font-family: 'Inter', sans-serif;
				letter-spacing: -0.025em;
				font-weight: 800;
			}
			h1 { font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.1; }
			h2 { font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.2; }
			h3 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.3; }
			h4 { font-size: 1.25rem; line-height: 1.4; }
			h5 { font-size: 1.125rem; line-height: 1.4; }
			h6 { font-size: 1rem; line-height: 1.4; }

			/* Improved paragraph & link spacing */
			p, li { line-height: 1.65; color: #4b5563; }
			a { line-height: 1.6; }

			/* Animations */
			@keyframes pulse-soft {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.8; transform: scale(0.98); }
			}

			@keyframes gradient-move {
				0% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
				100% { background-position: 0% 50%; }
			}

			@keyframes glow {
				0%, 100% { box-shadow: 0 0 5px rgba(53, 97, 143, 0.2); }
				50% { box-shadow: 0 0 20px rgba(53, 97, 143, 0.4); }
			}

			.animate-pulse-soft { animation: pulse-soft 3s infinite ease-in-out; }
			.animate-gradient { background-size: 200% auto; animation: gradient-move 5s linear infinite; }
			.hover-glow:hover { animation: glow 2s infinite ease-in-out; }

			/* Glassmorphism */
			.glass-nav {
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}

			.glass-card {
				background: rgba(255, 255, 255, 0.7);
				backdrop-filter: blur(20px);
				border: 1px solid rgba(255, 255, 255, 0.3);
				box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
			}
		</style>

		<!-- Sitewide JSON-LD: Organization + WebSite + MedicalWebPage @graph (E-E-A-T + YMYL) -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph)} />
	</head>
	<body class="bg-gray-50 text-gray-900 selection:bg-primary-50 selection:text-primary-800">
			<a href="#main-content" class="skip-link">Ana içeriğe geç</a>
		{!isHome && !hideBreadcrumbs && <Breadcrumbs />}
		<slot />
		<SearchAutocomplete />
		<CookieConsent />

		<!-- Prestige Badge removed — trust indicators now in HeroSection trust bar -->

		<!-- A11y: Hide decorative Material Symbols icons from screen readers -->
		<script is:inline>
			document.querySelectorAll('.material-symbols-outlined').forEach(function(el){el.setAttribute('aria-hidden','true')});
		</script>
	</body>
</html>
