---
import Logo from "../logo.astro";
import LangNav from "./LangNav.astro";
import Navigation from "./Navigation.astro";
import NavigationMobile from "./NavigationMobile.astro";
import Search from "../components/Search.astro";
---

<header class="header" id="header" role="banner">
  <div class="inner">
    <div class="logo">
      <a href="/" title="Home" aria-label="Dr. Senai Aksoy Anasayfa"><Logo /></a>
    </div>

    <Navigation aria-label="Ana Navigasyon" role="navigation" />

    <LangNav class="desktop" />

    <div class="header-actions">
      <button type="button" id="toggle-search" aria-label="Open Search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </button>

      <div class="menu">
        <button type="button" id="toggle-menu" aria-label="Toggle Menu">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <NavigationMobile />

  <div id="search-modal" class="modal">
    <div class="modal-content">
      <button id="close-search" class="close-button">&times;</button>
      <Search />
    </div>
  </div>
</header>

<script>
  let header = document.getElementById("header");

  document.addEventListener("astro:after-swap", () => {
    header = document.getElementById("header");
  });

  document.addEventListener(
    "astro:page-load",
    () => {
      if (!header) return;

      let scrollPos = window.scrollY;
      if (scrollPos > header.getBoundingClientRect().height * 2) {
        header.classList.add("stuck");
      }
      const scrollDirection = () => {
        if (!header) return;

        if (window.scrollY < header.getBoundingClientRect().height * 2) {
          header.classList.remove("stuck");
        } else {
          header.classList.add("stuck");
        }
        scrollPos = window.scrollY;
      };

      window.addEventListener("scroll", scrollDirection);

      // Search Modal Logic
      const searchToggle = document.getElementById("toggle-search");
      const searchModal = document.getElementById("search-modal");
      const closeSearch = document.getElementById("close-search");

      searchToggle?.addEventListener("click", () => {
        searchModal?.classList.add("active");
        document.body.style.overflow = "hidden";
        setTimeout(() => {
          const input = searchModal?.querySelector('input');
          input?.focus();
        }, 300);
      });

      const hideSearch = () => {
        searchModal?.classList.remove("active");
        document.body.style.overflow = "";
      };

      closeSearch?.addEventListener("click", hideSearch);
      
      searchModal?.addEventListener("click", (e) => {
        if (e.target === searchModal) hideSearch();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") hideSearch();
      });
    },
    { once: true }
  );
</script>

<style lang="scss">
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  #toggle-search {
    cursor: pointer;
    width: 24px;
    aspect-ratio: 1;
    padding: 0;
    border: none;
    background: none;
    display: block;
    color: var(--color-gray-90);
  }

  .menu {
    button {
      cursor: pointer;
      width: 24px;
      aspect-ratio: 1;
      padding: 0;
      border: none;
      background: none;
      display: block;
    }

    @media screen and (min-width: 1280px) {
      display: none;
    }
  }

  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 10vh;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;

    &.active {
      opacity: 1;
      visibility: visible;
    }
  }

  .modal-content {
    background: white;
    width: 90%;
    max-width: 700px;
    padding: 2rem;
    border-radius: 12px;
    position: relative;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: var(--color-gray-60);
    line-height: 1;

    &:hover {
      color: var(--color-gray-90);
    }
  }
</style>
