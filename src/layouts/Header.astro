---
import Logo from "../logo.astro";
import LangNav from "./LangNav.astro";
import Navigation from "./Navigation.astro";
import NavigationMobile from "./NavigationMobile.astro";
import SearchComponent from "../components/Search.astro";
import Icon from "../icons/index.astro";
---

<header class="header" id="header" role="banner">
  <div class="inner">
    <div class="logo">
      <a href="/" title="Home" aria-label="Dr. Senai Aksoy Anasayfa"><Logo /></a>
    </div>

    <div class="nav-container">
      <Navigation aria-label="Ana Navigasyon" role="navigation" />
    </div>

    <div class="header-actions">
      <LangNav class="desktop" />
      <SearchComponent />
      <div class="menu">
        <button type="button" id="toggle-menu" aria-label="Toggle Menu" class="action-btn" id="mobile-menu-toggle">
          <Icon name="menu" />
        </button>
      </div>
    </div>
  </div>
  <NavigationMobile />
</header>

<script>
  let header = document.getElementById("header");
  let toggleButton = document.getElementById("mobile-menu-toggle");

  document.addEventListener("astro:after-swap", () => {
    header = document.getElementById("header");
    toggleButton = document.getElementById("mobile-menu-toggle");
  });

  document.addEventListener(
    "astro:page-load",
    () => {
      if (!header) return;

      let scrollPos = window.scrollY;
      if (scrollPos > 100) {
        header.classList.add("stuck");
      }
      const scrollDirection = () => {
        if (!header) return;

        if (window.scrollY < 80) {
          header.classList.remove("stuck");
        } else {
          header.classList.add("stuck");
        }
        scrollPos = window.scrollY;
      };

      window.addEventListener("scroll", scrollDirection);
    },
    { once: true }
  );
</script>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    background: transparent;

    &.stuck {
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      border-bottom: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      padding: 0.5rem 0;
    }
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: var(--spacing-medium) var(--spacing-large);
    box-sizing: border-box;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;

    :global(svg) {
      height: 48px;
      width: auto;
    }
  }

  .nav-container {
      flex: 1;
      display: flex;
      justify-content: center;
      
      @media (max-width: 1279px) {
          display: none;
      }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-medium);
    flex-shrink: 0;
    justify-content: flex-end;

    @media (max-width: 1279px) {
      gap: var(--spacing-small);
      flex: 1;
    }
  }

  .action-btn {
    cursor: pointer;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-primary);
    border-radius: 50%;
    transition: all 0.3s ease;

    &:hover {
      background: rgba(40, 64, 157, 0.05);
      border-color: var(--glass-border);
    }
    
    :global(.icon) {
      width: 24px;
      height: 24px;
    }
  }

  .menu {
    @media screen and (min-width: 1280px) {
      display: none;
    }
  }
</style>
