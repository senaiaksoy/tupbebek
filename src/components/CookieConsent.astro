---
interface Props {
  version?: string;
}

const { version = "1.0" } = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 bg-gray-50 border-t border-gray-300 px-3 py-3 md:p-6 shadow-2xl z-50 translate-y-full transition-transform duration-300 ease-out"
  role="alertdialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
  aria-hidden="true"
>
  <div class="max-w-5xl mx-auto md:px-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 md:gap-4">
      <div class="flex-1 min-w-0">
        <h3 id="cookie-title" class="font-bold text-gray-900 text-sm md:text-base mb-1 md:mb-2">Çerez Kullanımı</h3>
        <p id="cookie-description" class="text-xs md:text-sm text-gray-600 leading-snug">
          Web sitesinin işlevselliğini sağlamak ve kullanıcı deneyimini iyileştirmek için çerezler kullanıyoruz.
          <a href="/cerez-politikasi" class="text-primary-600 hover:underline">Çerez Politikası</a>.
        </p>
      </div>
      <div class="flex gap-2 md:gap-4 flex-shrink-0 w-full md:w-auto">
        <button
          id="cookie-reject"
          class="flex-1 md:flex-initial px-4 md:px-5 py-2.5 md:py-3 min-h-[44px] rounded-lg border border-gray-300 text-gray-900 hover:bg-gray-100 transition-colors text-sm font-medium"
        >
          Reddet
        </button>
        <button
          id="cookie-accept"
          class="flex-1 md:flex-initial px-4 md:px-5 py-2.5 md:py-3 min-h-[44px] rounded-lg bg-primary-600 text-white hover:opacity-90 transition-opacity text-sm font-medium"
        >
          Kabul Et
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ version }}>
  // Default-hidden via translate-y-full; reveal only if consent missing.
  // Avoids the flash where SSR shows the banner then JS hides it.
  const consentKey = `cookie-consent-v${version}`;
  const banner = document.getElementById('cookie-consent');
  const hasConsent = localStorage.getItem(consentKey);

  const hide = () => {
    banner.classList.add('translate-y-full');
    banner.setAttribute('aria-hidden', 'true');
    // Remove from layout after slide-out animation
    setTimeout(() => { banner.style.display = 'none'; }, 320);
  };

  const show = () => {
    requestAnimationFrame(() => {
      banner.classList.remove('translate-y-full');
      banner.setAttribute('aria-hidden', 'false');
    });
  };

  if (!hasConsent) {
    show();
  } else {
    banner.style.display = 'none';
  }

  document.getElementById('cookie-accept').addEventListener('click', () => {
    localStorage.setItem(consentKey, 'accepted');
    hide();
  });

  document.getElementById('cookie-reject').addEventListener('click', () => {
    localStorage.setItem(consentKey, 'rejected');
    hide();
  });
</script>

<style>
  p {
    margin: 0;
  }
</style>
