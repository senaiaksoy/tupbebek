---
interface Props {
  version?: string;
}

const { version = "1.2" } = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 bg-gray-50 border-t border-gray-300 px-3 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] md:p-6 shadow-2xl z-[120] translate-y-full transition-transform duration-300 ease-out"
  role="alertdialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
  aria-hidden="true"
>
  <div class="max-w-5xl mx-auto md:px-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 md:gap-4">
      <div class="flex-1 min-w-0">
        <h3 id="cookie-title" class="font-bold text-gray-900 text-sm md:text-base mb-1 md:mb-2">Çerez ve Analitik Onayı</h3>
        <p id="cookie-description" class="text-xs md:text-sm text-gray-600 leading-snug">
          Zorunlu çerezler siteyi çalıştırır. Onay vermediğinizde GA4 çerez kullanmadan sınırlı ölçüm sinyalleri alabilir; analitik çerezler yalnızca “Analitikleri kabul et” seçeneğiyle kullanılır.
          <a href="/cerez-politikasi" class="text-primary-600 hover:underline">Çerez Politikası</a>.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-2 md:flex md:gap-4 flex-shrink-0 w-full md:w-auto">
        <button
          id="cookie-reject"
          class="px-4 md:px-5 py-2.5 md:py-3 min-h-[44px] rounded-lg border border-gray-300 text-gray-900 hover:bg-gray-100 transition-colors text-sm font-medium"
        >
          Reddet
        </button>
        <button
          id="cookie-accept"
          class="px-4 md:px-5 py-2.5 md:py-3 min-h-[44px] rounded-lg bg-primary-600 text-white hover:opacity-90 transition-opacity text-sm font-semibold"
        >
          Analitikleri Kabul Et
        </button>
      </div>
    </div>
  </div>
</div>

<button
  id="cookie-preferences-toggle"
  type="button"
  class="fixed left-3 bottom-20 md:left-5 md:bottom-5 z-[95] hidden rounded-full border border-gray-300 bg-white px-4 py-2 text-xs font-bold text-gray-800 shadow-lg transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:ring-offset-2"
  aria-controls="cookie-consent"
>
  Çerez tercihleri
</button>

<script define:vars={{ version }}>
  // Default-hidden via translate-y-full; reveal only if consent missing.
  // Avoids the flash where SSR shows the banner then JS hides it.
  const consentKey = `cookie-consent-v${version}`;
  const banner = document.getElementById('cookie-consent');
  const toggle = document.getElementById('cookie-preferences-toggle');
  const readConsent = () => {
    try {
      return localStorage.getItem(consentKey);
    } catch {
      return null;
    }
  };
  const saveConsent = (status) => {
    try {
      localStorage.setItem(consentKey, status);
    } catch {
      // If storage is unavailable, keep the visible interaction working.
    }
    window.dispatchEvent(new CustomEvent('cookie-consent:updated', { detail: { status } }));
  };

  const hide = () => {
    banner.classList.add('translate-y-full');
    banner.setAttribute('aria-hidden', 'true');
    toggle.classList.remove('hidden');
    // Remove from layout after slide-out animation
    setTimeout(() => { banner.style.display = 'none'; }, 320);
  };

  const show = () => {
    banner.style.display = '';
    toggle.classList.add('hidden');
    requestAnimationFrame(() => {
      banner.classList.remove('translate-y-full');
      banner.setAttribute('aria-hidden', 'false');
    });
  };

  if (!readConsent()) {
    show();
  } else {
    banner.style.display = 'none';
    toggle.classList.remove('hidden');
  }

  document.getElementById('cookie-accept').addEventListener('click', () => {
    saveConsent('accepted');
    hide();
  });

  document.getElementById('cookie-reject').addEventListener('click', () => {
    saveConsent('rejected');
    hide();
  });

  toggle.addEventListener('click', show);
</script>

<style>
  p {
    margin: 0;
  }
</style>
