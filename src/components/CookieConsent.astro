---
interface Props {
  version?: string;
}

const { version = "1.2" } = Astro.props;
---

<div
  id="cookie-consent-overlay"
  class="fixed inset-0 z-[120] hidden place-items-center bg-gray-950/55 px-4 py-6 opacity-0 backdrop-blur-sm transition-opacity duration-200"
>
  <div
    id="cookie-consent"
    class="w-full max-w-lg rounded-lg border border-gray-200 bg-white p-5 shadow-2xl md:p-6"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="cookie-title"
    aria-describedby="cookie-description"
    aria-hidden="true"
  >
    <div class="space-y-4">
      <div class="space-y-2">
        <h3 id="cookie-title" class="text-base font-bold text-gray-900 md:text-lg">Çerez ve Analitik Onayı</h3>
        <p id="cookie-description" class="text-sm leading-relaxed text-gray-600">
          Zorunlu çerezler siteyi çalıştırır. Onay vermediğinizde GA4 çerez kullanmadan sınırlı ölçüm sinyalleri alabilir; analitik çerezler yalnızca “Analitikleri kabul et” seçeneğiyle kullanılır.
          <a href="/cerez-politikasi" class="font-medium text-primary-600 hover:underline">Çerez Politikası</a>.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <button
          id="cookie-reject"
          type="button"
          class="min-h-[44px] rounded-lg border border-gray-300 px-4 py-3 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:ring-offset-2"
        >
          Reddet
        </button>
        <button
          id="cookie-accept"
          type="button"
          class="min-h-[44px] rounded-lg bg-primary-600 px-4 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:ring-offset-2"
        >
          Analitikleri Kabul Et
        </button>
      </div>
    </div>
  </div>
</div>

<button
  id="cookie-preferences-toggle"
  type="button"
  class="fixed left-3 bottom-20 md:left-5 md:bottom-5 z-[95] hidden rounded-full border border-gray-300 bg-white px-4 py-2 text-xs font-bold text-gray-800 shadow-lg transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:ring-offset-2"
  aria-controls="cookie-consent"
>
  Çerez tercihleri
</button>

<script define:vars={{ version }}>
  // Default-hidden; reveal only if consent is missing.
  // GA4 loads separately with Consent Mode denied until this choice is made.
  const consentKey = `cookie-consent-v${version}`;
  const overlay = document.getElementById('cookie-consent-overlay');
  const banner = document.getElementById('cookie-consent');
  const toggle = document.getElementById('cookie-preferences-toggle');
  const acceptButton = document.getElementById('cookie-accept');
  const rejectButton = document.getElementById('cookie-reject');
  let previousBodyOverflow = '';
  let lastFocusedElement = null;

  const readConsent = () => {
    try {
      return localStorage.getItem(consentKey);
    } catch {
      return null;
    }
  };
  const saveConsent = (status) => {
    try {
      localStorage.setItem(consentKey, status);
    } catch {
      // If storage is unavailable, keep the visible interaction working.
    }
    window.dispatchEvent(new CustomEvent('cookie-consent:updated', { detail: { status } }));
  };

  const getFocusableElements = () => Array.from(
    banner.querySelectorAll('a[href], button:not([disabled])')
  );

  const lockPage = () => {
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
  };

  const unlockPage = () => {
    document.body.style.overflow = previousBodyOverflow;
  };

  const keepFocusInModal = (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      return;
    }

    if (event.key !== 'Tab') return;

    const focusableElements = getFocusableElements();
    if (focusableElements.length === 0) return;

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    if (event.shiftKey && document.activeElement === firstElement) {
      event.preventDefault();
      lastElement.focus();
    } else if (!event.shiftKey && document.activeElement === lastElement) {
      event.preventDefault();
      firstElement.focus();
    }
  };

  const hide = () => {
    overlay.classList.add('opacity-0');
    banner.setAttribute('aria-hidden', 'true');
    toggle.classList.remove('hidden');
    document.removeEventListener('keydown', keepFocusInModal);
    unlockPage();
    setTimeout(() => {
      overlay.classList.add('hidden');
      overlay.classList.remove('grid');
      if (lastFocusedElement instanceof HTMLElement) {
        lastFocusedElement.focus();
      }
    }, 220);
  };

  const show = () => {
    lastFocusedElement = document.activeElement;
    overlay.classList.remove('hidden');
    overlay.classList.add('grid');
    toggle.classList.add('hidden');
    lockPage();
    requestAnimationFrame(() => {
      overlay.classList.remove('opacity-0');
      banner.setAttribute('aria-hidden', 'false');
      acceptButton.focus();
      document.addEventListener('keydown', keepFocusInModal);
    });
  };

  if (!readConsent()) {
    show();
  } else {
    toggle.classList.remove('hidden');
  }

  acceptButton.addEventListener('click', () => {
    saveConsent('accepted');
    hide();
  });

  rejectButton.addEventListener('click', () => {
    saveConsent('rejected');
    hide();
  });

  toggle.addEventListener('click', show);
</script>

<style>
  p {
    margin: 0;
  }
</style>
