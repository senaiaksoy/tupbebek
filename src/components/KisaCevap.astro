---
interface Props {
  id: string;
  title?: string;
  class?: string;
}

const { id, title = 'Kısa cevap', class: className } = Astro.props;
---

<section class:list={['border-l-4 border-primary-500 bg-primary-50/60 px-5 py-4', className]} aria-labelledby={id}>
  <h2 id={id} class="font-headline text-sm font-bold text-primary-900 uppercase tracking-wider mb-2">
    {title}
  </h2>
  <slot />
</section>
