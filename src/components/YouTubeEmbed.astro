---
/**
 * YouTubeEmbed — Makale içi eğitsel video bloğu
 *
 * Google video taraması için embed iframe HTML'de yer alır (loading="lazy").
 * Schema Article.video altında iç içe tanımlanır; ayrı VideoObject sayfası değildir.
 */
interface Props {
    /** YouTube video ID */
    id: string;
    /** Video başlığı (erişilebilirlik + görsel) */
    title?: string;
    /** Kısa açıklama (isteğe bağlı) */
    caption?: string;
    /** Video formatı */
    format?: 'landscape' | 'shorts';
}

const {
    id,
    title,
    caption,
    format = 'landscape',
} = Astro.props;

const isShorts = format === 'shorts';
const embedUrl = `https://www.youtube.com/embed/${id}`;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
const iframeTitle = title || 'YouTube video';
---

<figure class={`yt-embed my-12 md:my-16 ${isShorts ? 'max-w-sm mx-auto' : ''}`} data-yt-id={id} role="figure" aria-label={iframeTitle}>

    {title && (
        <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
            </div>
            <h4 class="font-headline text-base font-bold text-gray-900">{title}</h4>
        </div>
    )}

    <div class={`yt-embed__player relative overflow-hidden rounded-2xl bg-gray-900 shadow-lg ${isShorts ? 'aspect-[9/16]' : 'aspect-video'}`}>
        <iframe
            src={embedUrl}
            title={iframeTitle}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="absolute inset-0 h-full w-full border-0"
        ></iframe>
    </div>

    <p class="sr-only">
        <a href={watchUrl}>Videoyu YouTube'da izle</a>
    </p>

    {caption && (
        <figcaption class="mt-3 text-xs text-gray-500 text-center leading-relaxed italic">
            {caption}
        </figcaption>
    )}
</figure>
