---
/**
 * YouTubeEmbed — Makale içi eğitsel video bloğu
 *
 * İlk yüklemede üçüncü taraf YouTube iframe'i çalıştırılmaz. Kullanıcı oynatmayı
 * seçtiğinde iframe oluşturulur; ArticleSchema video metadata'sı ayrı korunur.
 */
interface Props {
    /** YouTube video ID */
    id: string;
    /** Video başlığı (erişilebilirlik + görsel) */
    title?: string;
    /** Kısa açıklama (isteğe bağlı) */
    caption?: string;
    /** Video formatı */
    format?: 'landscape' | 'shorts';
}

const {
    id,
    title,
    caption,
    format = 'landscape',
} = Astro.props;

const isShorts = format === 'shorts';
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
const iframeTitle = title || 'YouTube video';
---

<figure class={`yt-embed my-12 md:my-16 ${isShorts ? 'max-w-sm mx-auto' : ''}`} data-yt-id={id} role="figure" aria-label={iframeTitle}>

    {title && (
        <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
            </div>
            <p class="font-headline text-base font-bold text-gray-900">{title}</p>
        </div>
    )}

    <div class={`yt-embed__player relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-950 via-slate-900 to-primary-950 shadow-lg ${isShorts ? 'aspect-[9/16]' : 'aspect-video'}`}>
        <a
            href={watchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center text-white transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-200"
            data-youtube-facade
            data-youtube-id={id}
            data-youtube-title={iframeTitle}
            aria-label={`${iframeTitle} videosunu oynat`}
        >
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600 shadow-xl" aria-hidden="true">
                <span class="material-symbols-outlined text-4xl">play_arrow</span>
            </span>
            <span class="max-w-md text-sm font-semibold leading-relaxed">Videoyu oynatmak için dokunun</span>
        </a>
    </div>

    {caption && (
        <figcaption class="mt-3 text-xs text-gray-500 text-center leading-relaxed italic">
            {caption}
        </figcaption>
    )}
</figure>

<script is:inline>
    (() => {
        const initYouTubeFacades = () => {
            document.querySelectorAll('[data-youtube-facade]').forEach((facade) => {
                if (facade.dataset.youtubeBound === 'true') return;
                facade.dataset.youtubeBound = 'true';

                facade.addEventListener('click', (event) => {
                    event.preventDefault();
                    const videoId = facade.dataset.youtubeId;
                    if (!videoId) return;

                    const iframe = document.createElement('iframe');
                    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
                    iframe.title = facade.dataset.youtubeTitle || 'YouTube video';
                    iframe.loading = 'eager';
                    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
                    iframe.allowFullscreen = true;
                    iframe.className = 'absolute inset-0 h-full w-full border-0';
                    facade.replaceWith(iframe);
                }, { once: true });
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initYouTubeFacades, { once: true });
        } else {
            initYouTubeFacades();
        }
        document.addEventListener('astro:after-swap', initYouTubeFacades);
    })();
</script>
