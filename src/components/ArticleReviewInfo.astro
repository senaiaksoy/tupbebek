---
interface Props {
    evidenceAsOf?: Date;
    reviewScope?: string;
    editorialMethodNote?: string;
}

const { evidenceAsOf, reviewScope, editorialMethodNote } = Astro.props;
const evidenceDate = evidenceAsOf?.toLocaleDateString('tr-TR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---

{(evidenceDate || reviewScope || editorialMethodNote) && (
    <details class="article-review-details mt-10 border-y border-gray-200 py-3 text-sm text-gray-600">
        <summary class="min-h-11 cursor-pointer select-none py-2 font-semibold text-gray-800 marker:text-primary-600">
            Bilimsel inceleme ayrıntıları
        </summary>
        <dl class="space-y-2 pb-2 pt-1 leading-relaxed">
            {evidenceDate && (
                <div>
                    <dt class="inline font-semibold text-gray-700">Kaynakların son tarandığı tarih:</dt>{' '}
                    <dd class="inline">{evidenceDate}</dd>
                </div>
            )}
            {reviewScope && (
                <div>
                    <dt class="inline font-semibold text-gray-700">İnceleme kapsamı:</dt>{' '}
                    <dd class="inline">{reviewScope}</dd>
                </div>
            )}
            {editorialMethodNote && (
                <div>
                    <dt class="inline font-semibold text-gray-700">Bu güncellemede:</dt>{' '}
                    <dd class="inline">{editorialMethodNote}</dd>
                </div>
            )}
        </dl>
    </details>
)}
