---
const readings = [
  {
    href: '/makaleler/tup-bebek-nedir/',
    icon: 'science',
    title: 'Tüp bebek nedir?',
    text: 'IVF/ICSI farkı, kimlere uygulanır ve süreç hangi adımlardan oluşur?'
  },
  {
    href: '/makaleler/embriyo-transferi-sonrasi-bakim/',
    icon: 'event_available',
    title: 'Embriyo transferi sonrası',
    text: 'Yatış, günlük yaşam, ilaçlar ve ne zaman hekime haber verileceği.'
  },
  {
    href: '/makaleler/dusuk-amh-hamilelik/',
    icon: 'egg',
    title: 'Düşük AMH',
    text: 'AMH sonucu yaş, AFC ve tedavi planıyla birlikte nasıl okunur?'
  },
  {
    href: '/makaleler/azospermi-mikro-tese/',
    icon: 'male',
    title: 'Azospermi',
    text: 'Menide sperm olmaması, OA/NOA ayrımı ve mikro-TESE kararı.'
  },
  {
    href: '/pgt-merkezi/',
    icon: 'genetics',
    title: 'PGT nedir?',
    text: 'PGT-A, PGT-M ve PGT-SR arasındaki farklar ve sınırlar.'
  },
  {
    href: '/basari-oranlari/',
    icon: 'query_stats',
    title: 'Tüp bebek başarı oranı',
    text: 'Yaş, canlı doğum, kümülatif başarı ve oranları doğru yorumlama.'
  },
  {
    href: '/makaleler/endometriozis-tup-bebek/',
    icon: 'gynecology',
    title: 'Endometriozis ve tüp bebek',
    text: 'Cerrahi, rezerv, ağrı ve IVF sıralaması nasıl birlikte düşünülür?'
  }
];
---

<section class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-16" aria-labelledby="essential-reading-title">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-8">
    <div class="max-w-2xl">
      <p class="text-primary-600 font-label uppercase tracking-[0.25em] text-xs font-bold mb-3">Temel okuma yolu</p>
      <h2 id="essential-reading-title" class="font-headline text-3xl md:text-4xl text-gray-900 mb-3">IVF ve infertilite için nereden başlamalı?</h2>
      <p class="text-gray-600 leading-relaxed">
        En çok karıştırılan başlıkları tek bir okuma sırasına aldık. Önce temel kavramı, sonra kişisel durumu etkileyen başlıkları okuyabilirsiniz.
      </p>
    </div>
    <a href="/rehberler/" class="inline-flex items-center gap-2 text-primary-700 font-semibold text-sm hover:underline">
      Tüm rehberleri gör
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {readings.map((item, index) => (
      <a href={item.href} class={`group block rounded-2xl border border-gray-200 bg-white p-5 hover:border-primary-200 hover:shadow-lg transition-all ${index === 6 ? 'lg:col-span-2' : ''}`}>
        <div class="flex items-start gap-4">
          <span class="w-11 h-11 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0 group-hover:bg-primary-600 group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-[22px]" aria-hidden="true">{item.icon}</span>
          </span>
          <span>
            <span class="block font-headline font-bold text-gray-900 mb-1">{item.title}</span>
            <span class="block text-sm text-gray-600 leading-relaxed">{item.text}</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
