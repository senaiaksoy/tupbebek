---
import HeroSection from './HeroSection.astro';
---

<div class="bg-[#f7f4ee] border-b border-gray-200/70 pt-[76px] pb-1">
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-2 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-xs sm:text-sm text-gray-700">
    <span class="inline-flex items-center gap-1.5 bg-white/90 border border-gray-300/60 rounded-md px-3 py-1 font-medium shadow-2xs">
      <span class="material-symbols-outlined text-primary-600 text-base">verified</span>
      <span><strong class="font-bold text-gray-900">Doç. Dr. Senai Aksoy</strong> editörlüğünde yayın</span>
    </span>
    <span class="inline-flex items-center gap-1.5 bg-white/90 border border-gray-300/60 rounded-md px-3 py-1 font-medium shadow-2xs">
      <span class="material-symbols-outlined text-primary-600 text-base">groups</span>
      <span>Yayın kurulu denetimli içerikler</span>
    </span>
    <span class="inline-flex items-center gap-1.5 bg-white/90 border border-gray-300/60 rounded-md px-3 py-1 font-medium shadow-2xs">
      <span class="material-symbols-outlined text-primary-600 text-base">update</span>
      <span>Düzenli güncellenen kanıt temelli rehberler</span>
    </span>
    <span class="inline-flex items-center gap-1.5 bg-white/90 border border-gray-300/60 rounded-md px-3 py-1 font-medium shadow-2xs">
      <span class="material-symbols-outlined text-primary-600 text-base">verified_user</span>
      <span>%100 Bağımsız & Reklamsız</span>
    </span>
  </div>
</div>

<HeroSection />
