---
import QuickGuideCards from './QuickGuideCards.astro';
import SituationSelector from './SituationSelector.astro';
import PatientJourney from '../PatientJourney.astro';
---

<QuickGuideCards />

<SituationSelector />

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <div class="mb-10 lg:mb-14">
      <span class="text-primary-600 font-label uppercase tracking-ultra text-xs font-bold mb-3 block">TEDAVI REHBERI</span>
      <h2 class="text-2xl lg:text-3xl font-headline font-bold text-gray-900 mb-3">Tedavi Surecine Genel Bakis</h2>
      <p class="text-base text-gray-500 max-w-xl">Tup bebek surecinin temel adimlarini ve hangi asamada hangi bilgilere ihtiyac duyulabilecegini ozetler.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-6 lg:gap-8 items-start">
      <div class="lg:sticky lg:top-24">
        <div class="relative rounded-2xl overflow-hidden shadow-lg aspect-[4/3] lg:aspect-[3/4]">
          <img
            src="/images/tedavi-yontemleri/clinical-lab.webp"
            alt="Tup bebek sureci ve laboratuvar ortami"
            class="w-full h-full object-cover"
            width="480"
            height="640"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-900/70 via-gray-900/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="text-xs font-bold uppercase tracking-wider text-primary-300 block mb-2">Adim Adim</span>
            <p class="text-white text-lg lg:text-xl font-headline font-bold leading-snug">Tup Bebek Surecini Sistematik Olarak Inceleyin</p>
            <a href="/tedavi-sureci" class="mt-4 inline-flex items-center gap-2 text-white text-sm font-semibold underline underline-offset-4 hover:gap-3 transition-all">
              Icerigi Incele
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-primary-600 text-xl">groups</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Kimler Icin Uygun Olabilir?</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-gray-600 mb-4">
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>En az 1 yildir duzenli iliskiye ragmen gebelik saglayamayan ciftler</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Tupleri tikali olan kadinlar</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Ciddi erkek kaynakli infertilite</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Yumurtlama bozuklugu (PCOS vb.)</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Azalmis yumurtalik rezervi</span>
            </li>
          </ul>
          <a href="/kadin-infertilitesi" class="inline-flex items-center gap-1.5 text-primary-600 text-sm font-semibold hover:gap-2.5 transition-all duration-300">
            Konuyu Incele <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-mint-50 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-mint-600 text-xl">payments</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Maliyet ve Kapsam</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-gray-600 mb-4">
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Ilk denemede %50'ye varan devlet destegi</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>SGK kapsaminda 3 deneme hakki</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Ilac maliyetlerinin buyuk kismi karsilanir</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Yasa gore degisen ek tetkik ucretleri</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Tamamlayici saglik sigortasi secenekleri</span>
            </li>
          </ul>
          <a href="/sss" class="inline-flex items-center gap-1.5 text-mint-600 text-sm font-semibold hover:gap-2.5 transition-all duration-300">
            Bilgiyi Incele <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-apricot-50 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-apricot-600 text-xl">event_repeat</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Surec ve Zaman Cizelgesi</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-gray-600 mb-4">
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>On tetkikler: ~1 adet dongu</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Yumurtalik uyarimi: 10-14 gun</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Laboratuvar (ICSI/IVF): 3-5 gun</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Embriyo transferi: 5. veya 6. gun</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Toplam surec: ~4-6 hafta</span>
            </li>
          </ul>
          <a href="/tedavi-yontemleri" class="inline-flex items-center gap-1.5 text-apricot-600 text-sm font-semibold hover:gap-2.5 transition-all duration-300">
            Sureci Incele <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<PatientJourney />
