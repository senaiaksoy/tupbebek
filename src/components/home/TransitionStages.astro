---
import QuickGuideCards from './QuickGuideCards.astro';
import SituationSelector from './SituationSelector.astro';
import PatientJourney from '../PatientJourney.astro';
---

<QuickGuideCards />

<SituationSelector />

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <div class="mb-10 lg:mb-14">
      <span class="text-primary-600 font-label uppercase tracking-ultra text-xs font-bold mb-3 block">TEDAVİ REHBERİ</span>
      <h2 class="text-2xl lg:text-3xl font-headline font-bold text-gray-900 mb-3">Tedavi Sürecine Genel Bakış</h2>
      <p class="text-base text-gray-500 max-w-xl">Tüp bebek sürecinin temel adımlarını ve hangi aşamada hangi bilgilere ihtiyaç duyulabileceğini özetler.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-6 lg:gap-8 items-start">
      <div class="lg:sticky lg:top-24">
        <div class="relative rounded-2xl overflow-hidden shadow-lg aspect-[4/3] lg:aspect-[3/4]">
          <img
            src="/images/tedavi-yontemleri/clinical-lab.webp"
            alt="Tüp bebek süreci ve laboratuvar ortamı"
            class="w-full h-full object-cover"
            width="480"
            height="640"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-900/70 via-gray-900/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="text-xs font-bold uppercase tracking-wider text-primary-300 block mb-2">Adım Adım</span>
            <p class="text-white text-lg lg:text-xl font-headline font-bold leading-snug">Tüp Bebek Sürecini Sistematik Olarak İnceleyin</p>
            <a href="/tedavi-yontemleri" class="mt-4 inline-flex items-center gap-2 text-white text-sm font-semibold underline underline-offset-4 hover:gap-3 transition-all">
              İçeriği İncele
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-primary-600 text-xl">groups</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Kimler İçin Uygun Olabilir?</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-gray-600 mb-4">
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>En az 1 yıldır düzenli ilişkiye rağmen gebelik sağlayamayan çiftler</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Tüpleri tıkalı olan kadınlar</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Ciddi erkek kaynaklı infertilite</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Yumurtlama bozukluğu (PCOS vb.)</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Azalmış yumurtalık rezervi</span>
            </li>
          </ul>
          <a href="/kadin-infertilitesi" class="inline-flex items-center gap-1.5 text-primary-600 text-sm font-semibold hover:gap-2.5 transition-all duration-300">
            Konuyu İncele <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-mint-50 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-mint-600 text-xl">payments</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Maliyet ve Kapsam</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-gray-600 mb-4">
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Devlet destekleri ve SGK kapsamı başvuru koşullarına göre değişebilir</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Kapsam; yaş, sigortalılık süresi ve tanıya göre değerlendirilir</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>İlaç ve ek işlem kapsamında kurum bazlı farklar olabilir</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Ek tetkik ve laboratuvar uygulamaları plana göre değişebilir</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-mint-500 text-sm mt-0.5 shrink-0">check_circle</span>
              <span>Güncel mevzuat bilgisi için resmi kurum duyuruları izlenmelidir</span>
            </li>
          </ul>
          <a href="/sss" class="inline-flex items-center gap-1.5 text-mint-600 text-sm font-semibold hover:gap-2.5 transition-all duration-300">
            Bilgiyi İncele <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-apricot-50 rounded-lg flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-apricot-600 text-xl">event_repeat</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Süreç ve Zaman Çizelgesi</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-gray-600 mb-4">
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Ön tetkikler: ~1 adet döngü</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Yumurtalık uyarımı: 10-14 gün</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Laboratuvar (ICSI/IVF): 3-5 gün</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Embriyo transferi: 5. veya 6. gün</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-apricot-600 text-sm mt-0.5 shrink-0">schedule</span>
              <span>Toplam süreç: ~4-6 hafta</span>
            </li>
          </ul>
          <a href="/tedavi-yontemleri" class="inline-flex items-center gap-1.5 text-apricot-600 text-sm font-semibold hover:gap-2.5 transition-all duration-300">
            Süreci İncele <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<PatientJourney />
