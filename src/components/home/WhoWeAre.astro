---
import Icon from "@icons/index.astro";
import { Image } from "astro:assets";
import CTA from "../global/CTA.astro";
import Section from "../global/Section.astro";
import Title from "../global/Title.astro";
import Row from "./Row.astro";
import image from "/public/draksoy-klinik.png";
---

<Row>
  <Section class="who-we-are">
    <div class="column image-container">
      <Image
        src={image}
        width={image.width}
        height={image.height}
        alt="Dr. Senai Aksoy"
        class="masked-image"
      />
    </div>

    <div class="column">
      <Title size="big">Biz Kimiz</Title>
      <p class="text">
        Türkiye’nin üreme sağlığı, infertilite ve tüp bebek alanındaki lider
        online platformuna Tupbebek.com’a hoş geldiniz. 1996 yılından beri
        kesintisiz yayın yapmanın gururu içinde, bu önemli sağlık konularında
        bilinç, eğitim ve desteği artırma misyonumuzla, alandaki öncü
        çabalarımızı sürdürmenin mutluluğunu yaşıyoruz.
      </p>
      <p>
        <CTA
          href="/hakkimizda"
          variant="secondary"
          size="small"
          title="Dr.Senai Aksoy Tüp Bebek Merkezi Hakkında"
        >
          Hakkımızda
          <Icon name="arrowRight" />
        </CTA>
      </p>
    </div>
  </Section>
</Row>

<style lang="scss">
  .image-container {
    display: flex;
    justify-content: center;
    align-items: center;
    
    .masked-image {
      width: 100%;
      max-width: 400px;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      /* Odak noktasını fotoğrafın sağında bulunan doktora al altta da offset olmasin */
      object-position: 60% 15%;
      
      /* Artistik kesim (blob shape) */
      border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      margin: auto;
      transition: all 0.4s ease;
      
      &:hover {
        /* Hover durumunda artistik form değişimi */
        border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
        transform: translateY(-5px) scale(1.02);
      }
    }
  }

  .column {

    @media screen and (min-width: 768px) {
      grid-template-columns: 1fr 380px;

      &:last-child {
        order: -1;
      }
    }
  }
</style>
