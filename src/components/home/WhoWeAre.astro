---
import Icon from "@icons/index.astro";
import { Image } from "astro:assets";
import CTA from "../global/CTA.astro";
import Section from "../global/Section.astro";
import Title from "../global/Title.astro";
import Row from "./Row.astro";
import image from "/public/senai-aksoy.png";
---

<Row>
  <Section class="who-we-are">
    <div class="column image-container">
      <Image
        src={image}
        width={image.width}
        height={image.height}
        alt="Dr. Senai Aksoy"
        class="masked-image"
      />
    </div>

    <div class="column">
      <Title size="big">Biz Kimiz</Title>
      <p class="text">
        Türkiye’nin üreme sağlığı, infertilite ve tüp bebek alanındaki lider
        online platformuna Tupbebek.com’a hoş geldiniz. 1996 yılından beri
        kesintisiz yayın yapmanın gururu içinde, bu önemli sağlık konularında
        bilinç, eğitim ve desteği artırma misyonumuzla, alandaki öncü
        çabalarımızı sürdürmenin mutluluğunu yaşıyoruz.
      </p>
      <p>
        <CTA
          href="/hakkimizda"
          variant="secondary"
          size="small"
          title="Dr.Senai Aksoy Tüp Bebek Merkezi Hakkında"
        >
          Hakkımızda
          <Icon name="arrowRight" />
        </CTA>
      </p>
    </div>
  </Section>
</Row>

<style lang="scss">
  .image-container {
    display: flex;
    justify-content: center;
    align-items: center;
    
    .masked-image {
      width: 100%;
      max-width: 450px;
      aspect-ratio: 1;
      object-fit: cover;
      object-position: center top;
      -webkit-mask-image: url("/drawing.svg");
      mask-image: url("/drawing.svg");
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: contain;
      mask-size: contain;
      margin: auto;
      transition: transform 0.3s ease;
      
      &:hover {
        transform: scale(1.02);
      }
    }
  }

  .column {

    @media screen and (min-width: 768px) {
      grid-template-columns: 1fr 380px;

      &:last-child {
        order: -1;
      }
    }
  }
</style>
