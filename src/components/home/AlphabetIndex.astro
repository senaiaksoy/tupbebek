---
/**
 * Alphabet Index — Makale arşivine A-Z hızlı erişim
 * Türkçe alfabe şeridi + harfe göre gruplanmış kompakt makale listesi.
 */
import { getPublishedArticles } from '../../utils/articles';

const turkishAlphabet = ['A','B','C','Ç','D','E','F','G','Ğ','H','I','İ','J','K','L','M','N','O','Ö','P','R','S','Ş','T','U','Ü','V','Y','Z'];

// Map first character → bucket letter (uppercase, Turkish-aware)
function bucketOf(title: string): string {
    const first = title.trim().charAt(0).toLocaleUpperCase('tr-TR');
    return turkishAlphabet.includes(first) ? first : '#';
}

const articles = await getPublishedArticles();

const grouped = new Map<string, { title: string; slug: string }[]>();
for (const a of articles) {
    const letter = bucketOf(a.data.title);
    if (!grouped.has(letter)) grouped.set(letter, []);
    grouped.get(letter)!.push({ title: a.data.title, slug: a.slug });
}

// Sort within each bucket (Turkish collation)
const collator = new Intl.Collator('tr-TR', { sensitivity: 'base' });
for (const list of grouped.values()) {
    list.sort((x, y) => collator.compare(x.title, y.title));
}

// Build display order — only letters that have articles, in Turkish alphabet order, plus optional "#"
const lettersInOrder = turkishAlphabet.filter(l => grouped.has(l));
if (grouped.has('#')) lettersInOrder.push('#');

const totalArticles = articles.length;
---

<section class="py-16 lg:py-20 bg-gradient-to-b from-white to-gray-50" aria-labelledby="alphabet-index-title">
    <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">

        <!-- Section Header -->
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 lg:mb-10">
            <div>
                <span class="text-xs font-bold text-primary-600 uppercase tracking-widest mb-2 block">Makale Arşivi</span>
                <h2 id="alphabet-index-title" class="text-2xl lg:text-3xl font-headline font-bold text-gray-900 mb-2">A'dan Z'ye Tüm Rehberler</h2>
                <p class="text-base text-gray-500">Aradığınız konuyu harf bantından seçin veya tüm arşivi gözden geçirin.</p>
            </div>
            <a href="/makaleler" class="text-primary-600 font-semibold text-sm hover:underline flex items-center gap-1.5 shrink-0">
                Tüm Makaleler ({totalArticles}) <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
        </div>

        <!-- Alphabet Strip -->
        <div class="sticky top-20 z-20 -mx-4 md:mx-0 mb-8 px-4 md:px-0">
            <nav class="flex flex-wrap gap-1.5 md:gap-2 p-3 md:p-4 bg-white/95 backdrop-blur-sm rounded-2xl border border-gray-200 shadow-sm" aria-label="Alfabetik makale indeksi">
                {turkishAlphabet.map(letter => {
                    const has = grouped.has(letter);
                    const count = grouped.get(letter)?.length ?? 0;
                    return has ? (
                        <a
                            href={`#harf-${letter}`}
                            class="alphabet-chip relative inline-flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-lg text-sm font-bold text-gray-700 bg-gray-50 hover:bg-primary-600 hover:text-white border border-gray-200 hover:border-primary-600 transition-all duration-200"
                            aria-label={`${letter} harfi (${count} makale)`}
                        >
                            {letter}
                            <span class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-mint-600 text-white text-[10px] font-bold flex items-center justify-center leading-none">{count}</span>
                        </a>
                    ) : (
                        <span
                            class="inline-flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-lg text-sm font-semibold text-gray-300 bg-gray-50 border border-gray-100 cursor-not-allowed select-none"
                            aria-hidden="true"
                        >{letter}</span>
                    );
                })}
            </nav>
        </div>

        <!-- Grouped Article List -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 md:p-8 lg:p-10">
            <div class="columns-1 sm:columns-2 lg:columns-3 gap-x-10 gap-y-0">
                {lettersInOrder.map(letter => (
                    <div class="break-inside-avoid mb-8" id={`harf-${letter}`}>
                        <div class="flex items-baseline gap-3 mb-3 pb-2 border-b-2 border-primary-100">
                            <span class="font-headline text-3xl font-bold text-primary-600 leading-none">{letter}</span>
                            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">{grouped.get(letter)!.length} makale</span>
                        </div>
                        <ul class="space-y-1.5">
                            {grouped.get(letter)!.map(item => (
                                <li>
                                    <a
                                        href={`/makaleler/${item.slug}`}
                                        class="group flex items-start gap-2 text-sm text-gray-700 hover:text-primary-700 leading-snug py-1 transition-colors"
                                    >
                                        <span class="material-symbols-outlined text-[14px] text-gray-300 group-hover:text-primary-500 mt-0.5 shrink-0">chevron_right</span>
                                        <span class="group-hover:underline underline-offset-2 decoration-primary-300">{item.title}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>

        <!-- Bottom CTA -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 px-6 py-5 bg-primary-50 border border-primary-100 rounded-xl">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-primary-600 text-2xl">menu_book</span>
                <p class="text-sm text-gray-700">
                    <strong class="text-gray-900">{totalArticles} bilimsel rehber</strong> · Yayın kurulu onaylı, kanıt seviyesi belirtilmiş.
                </p>
            </div>
            <a
                href="/makaleler"
                class="inline-flex items-center gap-2 px-5 py-2.5 min-h-[44px] bg-primary-600 hover:bg-primary-700 text-white font-semibold text-sm rounded-lg transition-colors shadow-sm"
            >
                Arşivde Ara ve Filtrele
                <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
        </div>

    </div>
</section>

<style>
    /* Smooth anchor scroll offset to clear sticky header + alphabet strip */
    [id^="harf-"] {
        scroll-margin-top: 180px;
    }
</style>
