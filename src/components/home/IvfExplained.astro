---
import Section from "@components/Section.astro";
import Title from "@components/Title.astro";

import Video from "@components/Video.astro";
import Row from "./Row.astro";
---

<Row>
  <Section class="ivf-explained">
    <Title size="big">Tüp bebek aşamaları</Title>

    <Video id="_YJmXBdAE0c" />
  </Section>
</Row>
<style lang="scss">
  iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 1rem;
  }

  .text {
    font-family: var(--font-secondary);
    font-size: 1.25rem;
    text-wrap: balance;
  }
</style>
