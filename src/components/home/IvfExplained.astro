---
import Section from "@components/Section.astro";
import Title from "@components/Title.astro";

import Row from "./Row.astro";
const videoSource =
  Astro.currentLocale === "fr"
    ? "https://www.youtube.com/embed/TrGR2vqQ0d4?si=K1YpJ7nY01gHt5L5"
    : "https://www.youtube.com/embed/10mj7kJH6H8?si=JwwcZzxuLUGd8Wk-";
---

<Row>
  <Section class="ivf-explained">
    <Title size="big">IVF Nedir?</Title>

    <iframe
      width="560"
      src={videoSource}
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      loading="lazy"
      allowfullscreen></iframe>
  </Section>
</Row>
<style lang="scss">
  iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 1rem;
  }

  .text {
    font-family: var(--font-secondary);
    font-size: 1.25rem;
    text-wrap: balance;
  }
</style>
