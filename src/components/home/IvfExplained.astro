---
import Section from "@components/Section.astro";
import Title from "@components/Title.astro";

import Row from "./Row.astro";
const videoSource = "https://www.youtube.com/embed/_YJmXBdAE0c";
---

<Row>
  <Section class="ivf-explained">
    <Title size="big">Tüp bebek aşamaları</Title>

    <iframe
      width="560"
      src={videoSource}
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      loading="lazy"
      allowfullscreen></iframe>
  </Section>
</Row>
<style lang="scss">
  iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 1rem;
  }

  .text {
    font-family: var(--font-secondary);
    font-size: 1.25rem;
    text-wrap: balance;
  }
</style>
