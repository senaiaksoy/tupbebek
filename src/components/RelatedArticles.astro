---
/**
 * RelatedArticles — Aynı kategoriden ilgili makaleler
 * Mevcut makaleyle aynı kategorideki diğer makaleleri gösterir.
 * variant="sidebar" ile kompakt sidebar görünümü destekler.
 */

interface Props {
    currentSlug: string;
    category: string;
    limit?: number;
    variant?: 'default' | 'sidebar';
}

const { currentSlug, category, limit = 3, variant = 'default' } = Astro.props;
const clusterPriorityMap: Record<string, string[]> = {
    'tup-bebek-nedir': [
        'tup-bebek-sureci-rehber',
        'embriyo-transferi-sonrasi-bakim',
        'yasa-gore-tup-bebek-basari-oranlari'
    ],
    'embriyo-transferi-sonrasi-bakim': [
        'embriyo-transferi-gun-secimi',
        'beta-hcg-testi',
        'taze-dondurulmus-transfer'
    ],
    'dusuk-amh-hamilelik': [
        'kac-yumurta-gerekir',
        'yasa-gore-tup-bebek-basari-oranlari',
        'yumurta-dondurma-rehberi'
    ],
    'azospermi-mikro-tese': [
        'cerrahi-sperm-arama-tese',
        'mikroenjeksiyon-icsi-nedir',
        'varikosel-nedir-ne-zaman-ameliyat-gerekir'
    ],
    'pgt-a-bas-editor-kosesi': [
        'pgt-m',
        'pgt-cinsiyet-secimi',
        'embryoscope-yapay-zeka'
    ],
    'akraba-evliligi': [
        'pgt-m',
        'pgt-cinsiyet-secimi',
        'tup-bebek-nedir'
    ],
    'erkek-dogurganlik-besin-takviyeleri': [
        'varikosel-nedir-ne-zaman-ameliyat-gerekir',
        'alkol-ve-fertilite',
        'cep-telefonu-sperm-kalitesi'
    ],
    'tup-bebek-yanlis-bilinenler': [
        'tup-bebek-nedir',
        'yasa-gore-tup-bebek-basari-oranlari',
        'iui-nedir'
    ],
    'yumurtalik-kistleri-dogurganlik': [
        'endometrioma',
        'endometriozis-tup-bebek',
        'dusuk-amh-hamilelik'
    ],
    'endometriozis-tup-bebek': [
        'endometrioma',
        'endometriozis-akilli-stratejiler',
        'yumurtalik-kistleri-dogurganlik'
    ],
    'endometrioma': [
        'endometriozis-tup-bebek',
        'yumurtalik-kistleri-dogurganlik',
        'dusuk-amh-hamilelik'
    ],
    'cerrahi-sperm-arama-tese': [
        'azospermi-mikro-tese',
        'mikroenjeksiyon-icsi-nedir',
        'varikosel-nedir-ne-zaman-ameliyat-gerekir'
    ],
    'bagisiklik-tedavileri': [
        'era-testi-iluzyon',
        'endometriyal-scratching',
        'ivf-oncesi-histeroskopi'
    ],
    'kanser-ve-fertilite': [
        'yumurta-dondurma-rehberi',
        'taze-dondurulmus-transfer',
        'dusuk-amh-hamilelik'
    ],
    'yumurta-dondurma-rehberi': [
        'kanser-ve-fertilite',
        'dusuk-amh-hamilelik',
        'taze-dondurulmus-transfer'
    ]
};

const { getPublishedArticles, sanitizeImage } = await import('../utils/articles');
const allArticles = await getPublishedArticles();
const articlesBySlug = new Map(allArticles.map(article => [article.slug, article]));
const prioritizedRelated = (clusterPriorityMap[currentSlug] ?? [])
    .map(slug => articlesBySlug.get(slug))
    .filter((article): article is (typeof allArticles)[number] => Boolean(article));
const prioritizedSlugs = new Set(prioritizedRelated.map(article => article.slug));
const categoryRelated = allArticles
    .filter(a => a.slug !== currentSlug && a.data.category === category && !prioritizedSlugs.has(a.slug))
    .sort((a, b) => (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0))
const related = [...prioritizedRelated, ...categoryRelated].slice(0, limit);
---

{related.length > 0 && variant === 'sidebar' && (
    <div class="space-y-4">
        {related.map(article => (
            <a href={`/makaleler/${article.slug}/`} class="group flex gap-3 items-start">
                {article.data.image && (
                    <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
                        <img
                            src={sanitizeImage(article.data.image)}
                            alt={article.data.imageAlt || article.data.title}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            width="64" height="64" loading="lazy"
                        />
                    </div>
                )}
                <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold text-gray-800 leading-snug line-clamp-2 group-hover:text-primary-600 transition-colors">
                        {article.data.title}
                    </h4>
                    <span class="text-[10px] text-gray-400 mt-1 block">{article.data.category}</span>
                </div>
            </a>
        ))}
    </div>
)}

{related.length > 0 && variant === 'default' && (
    <section class="mt-20 pt-12 border-t border-gray-200">
        <h2 class="font-headline text-2xl font-bold text-gray-900 mb-8">İlgili Makaleler</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map(article => (
                <a href={`/makaleler/${article.slug}/`} class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md hover:border-primary-100 transition-all duration-300">
                    {article.data.image && (
                        <div class="aspect-video overflow-hidden">
                            <img
                                src={sanitizeImage(article.data.image)}
                                alt={article.data.imageAlt || article.data.title}
                                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                                width="400" height="225" loading="lazy"
                            />
                        </div>
                    )}
                    <div class="p-5">
                        <span class="text-[10px] font-bold text-primary-600 uppercase tracking-widest">{article.data.category}</span>
                        <h3 class="font-headline text-sm font-bold text-gray-900 mt-2 mb-2 group-hover:text-primary-600 transition-colors leading-snug">
                            {article.data.title}
                        </h3>
                        <p class="text-xs text-gray-500 leading-relaxed line-clamp-2">{article.data.description}</p>
                    </div>
                </a>
            ))}
        </div>
    </section>
)}
