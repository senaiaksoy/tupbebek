        name: 'Tüp bebek (IVF)',
        alternateName: ['In vitro fertilizasyon', 'IVF']
    },
    'embriyo-transferi-sonrasi-bakim': {
        type: 'MedicalProcedure',
        name: 'Embriyo transferi'
    },
    'dusuk-amh-hamilelik': {
        type: 'MedicalTest',
        name: 'Anti-Müllerian hormon (AMH)',
        alternateName: ['AMH', 'Yumurtalık rezervi']
    },
    'azospermi-mikro-tese': {
        type: 'MedicalCondition',
        name: 'Azospermi'
    },
    'pgt-a-bas-editor-kosesi': {
        type: 'MedicalTest',
        name: 'PGT-A',
        alternateName: ['Preimplantasyon genetik test', 'Preimplantation genetic testing for aneuploidy']
    },
    'pgt-m': {
        type: 'MedicalTest',
        name: 'PGT-M',
        alternateName: ['Preimplantasyon genetik monogenik test']
    },
