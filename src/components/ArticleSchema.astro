---
/**
 * ArticleSchema — Makale bazli JSON-LD yapilandirilmis veri
 *
 * Her makale icin MedicalWebPage + Article + reviewedBy + citation
 * schema.org markup'i uretir. BaseLayout'taki genel MedicalWebPage
 * semasinin uzerine makaleye ozel detaylar ekler.
 *
 * Kullanim:
 *   <ArticleSchema entry={entry} url={articleUrl} />
 */

interface Reference {
    title: string;
    authors?: string;
    journal?: string;
    year?: number;
    url?: string;
    doi?: string;
    pmid?: string;
}

interface Props {
    entry: {
        data: {
            title: string;
            description: string;
            author: string | { name: string; title?: string; credentials?: string; url?: string };
            authorTitle?: string;
            authorCredentials?: string;
            authorYoutube?: string;
            medicalReviewer?: string;
            reviewerTitle?: string;
            publishDate?: Date;
            lastModified?: Date;
            reviewDate?: Date;
            category: string;
            image?: string;
            imageAlt?: string;
            references?: Reference[];
        };
    };
    url: string;
}

// Sitewide canonical @ids (mirror src/layouts/BaseLayout.astro — keep in sync)
const ORG_ID = 'https://tupbebek.com/#organization';
const WEBSITE_ID = 'https://tupbebek.com/#website';
const EDITORIAL_BOARD_ID = 'https://tupbebek.com/yayin-kurulu/#editorial-board';
// Canonical Person @id — portföy genelinde Dr. Aksoy tek entity'ye çözülür.
// senaiaksoy.net Block A'da deklare edilmiş tek kanonik kayıt; bu site
// yazar/senai-aksoy/ sayfasında tamamlayıcı attributes (alumniOf, memberOf
// vb.) ile aynı @id'yi extend eder.
const SENAI_AKSOY_PERSON_ID = 'https://senaiaksoy.net/#person';

const { entry, url } = Astro.props;
const canonicalUrl = new URL(url);
canonicalUrl.hash = '';
const d = entry.data;
const pubMedSearchUrl = (term: string) =>
    `https://pubmed.ncbi.nlm.nih.gov/?term=${encodeURIComponent(term)}`;

// Resolve and normalize author
const DEFAULT_AUTHOR_NAME = 'Doç. Dr. Senai Aksoy';
const DEFAULT_AUTHOR_TITLE = 'Kadın Hastalıkları ve Doğum Uzmanı';
const DEFAULT_AUTHOR_CREDENTIALS = 'Üreme Tıbbı ve Yardımcı Üreme Teknikleri';
const DEFAULT_AUTHOR_YOUTUBE = 'https://www.youtube.com/@DocentDrSenaiAksoy';

const rawAuthorName = typeof d.author === 'string' ? d.author : d.author?.name;
const rawAuthorTitle = typeof d.author === 'string' ? d.authorTitle : d.author?.title;
const rawAuthorCredentials = typeof d.author === 'string' ? d.authorCredentials : d.author?.credentials;
const rawAuthorUrl = typeof d.author === 'string' ? undefined : d.author?.url;

const isBoardAuthor = !rawAuthorName || /yay[ıi]n kurulu/i.test(rawAuthorName);
const isEditorialTitle = !rawAuthorTitle || /editoryal ekip/i.test(rawAuthorTitle);
const isEditorialCredentials = !rawAuthorCredentials || /edit[öo]rl[üu][ğg]ünde/i.test(rawAuthorCredentials);

const authorName = isBoardAuthor ? DEFAULT_AUTHOR_NAME : rawAuthorName;
const authorTitle = (isBoardAuthor || isEditorialTitle) ? DEFAULT_AUTHOR_TITLE : rawAuthorTitle;
const authorCredentials = (isBoardAuthor || isEditorialCredentials) ? DEFAULT_AUTHOR_CREDENTIALS : rawAuthorCredentials;
const authorYoutube =
    d.authorYoutube
    || (rawAuthorUrl && /youtube\.com/i.test(rawAuthorUrl) ? rawAuthorUrl : undefined)
    || (isBoardAuthor ? DEFAULT_AUTHOR_YOUTUBE : undefined);

// Build author schema. For Dr. Aksoy (default editor), reference the canonical
// Person entity at /yazar/senai-aksoy/ so AI engines can resolve a stable
// knowledge-graph node across all articles.
const isSenaiAksoy = /senai\s+aksoy/i.test(authorName || '');
const authorSchema: Record<string, unknown> = isSenaiAksoy
    ? { "@id": SENAI_AKSOY_PERSON_ID }
    : {
        "@type": "Person",
        "name": authorName,
        ...(authorTitle ? { "jobTitle": authorTitle } : {}),
        ...(authorCredentials ? { "qualifications": authorCredentials } : {}),
        ...(authorYoutube ? { "sameAs": authorYoutube } : {}),
    };

// Build reviewer schema
const reviewerSchema = d.medicalReviewer ? {
    "@type": d.medicalReviewer.includes('Kurul') ? "Organization" : "Person",
    "name": d.medicalReviewer,
    ...(d.reviewerTitle ? { "jobTitle": d.reviewerTitle } : {}),
} : undefined;

// Build citations from references
const citations = d.references?.map(ref => {
    const pubMedUrl = ref.pmid ? `https://pubmed.ncbi.nlm.nih.gov/${ref.pmid}/` : undefined;
    const citation: Record<string, unknown> = {
        "@type": "ScholarlyArticle",
        "name": ref.title,
        "url": pubMedUrl || ref.url || pubMedSearchUrl(ref.title),
    };
    if (ref.authors) citation["author"] = ref.authors;
    if (ref.journal) citation["isPartOf"] = { "@type": "Periodical", "name": ref.journal };
    if (ref.year) citation["datePublished"] = String(ref.year);
    if (ref.pmid) {
        citation["identifier"] = {
            "@type": "PropertyValue",
            "propertyID": "PMID",
            "value": ref.pmid,
        };
    }
    if (ref.doi || ref.pmid) {
        citation["sameAs"] = [
            ...(ref.doi ? [`https://doi.org/${ref.doi}`] : []),
            ...(pubMedUrl ? [pubMedUrl] : []),
        ];
    }
    if (!ref.doi && !ref.pmid) citation["sameAs"] = pubMedSearchUrl(ref.title);
    return citation;
}) || [{
    "@type": "ScholarlyArticle",
    "name": `PubMed literatür taraması: ${d.title}`,
    "url": pubMedSearchUrl(`${d.title} ${d.category}`),
    "sameAs": pubMedSearchUrl(`${d.title} ${d.category}`),
}];

// Build ImageObject for the article hero image
const absoluteImageUrl = d.image
    ? (d.image.startsWith('http') ? d.image : `https://tupbebek.com${d.image}`)
    : undefined;

const imageObject = absoluteImageUrl ? {
    "@type": "ImageObject",
    "url": absoluteImageUrl,
    "width": 1200,
    "height": 630,
    ...(d.imageAlt ? { "caption": d.imageAlt } : {}),
} : undefined;

// Main Article + MedicalWebPage schema. Publisher + WebSite reference Organization @graph in BaseLayout via @id.
const articleSchema = {
    "@context": "https://schema.org",
    "@type": ["MedicalWebPage", "Article"],
    "@id": `${canonicalUrl.toString()}#article`,
    "headline": d.title,
    "description": d.description,
    "url": canonicalUrl.toString(),
    "inLanguage": "tr-TR",
    ...(imageObject ? { "image": imageObject } : {}),
    ...(d.publishDate ? { "datePublished": d.publishDate.toISOString().split('T')[0] } : {}),
    ...(d.lastModified ? { "dateModified": d.lastModified.toISOString().split('T')[0] } : {}),
    "author": authorSchema,
    // Dr. Aksoy yazar ise reviewedBy de canonical @id'ye (hem yazar hem reviewer pattern)
    ...(reviewerSchema
        ? { "reviewedBy": reviewerSchema }
        : isSenaiAksoy
            ? { "reviewedBy": { "@id": SENAI_AKSOY_PERSON_ID } }
            : { "reviewedBy": { "@id": EDITORIAL_BOARD_ID } }),
    ...(d.reviewDate ? { "lastReviewed": d.reviewDate.toISOString().split('T')[0] } : {}),
    "publisher": { "@id": ORG_ID },
    "isPartOf": { "@id": WEBSITE_ID },
    "about": {
        "@type": "MedicalCondition",
        "name": d.category,
    },
    "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": "Patient",
    },
    "specialty": {
        "@type": "MedicalSpecialty",
        "name": "Reproductive Medicine",
    },
    ...(citations.length > 0 ? { "citation": citations } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
