const slug = entry.slug || '';
const sameAsUrls = WIKIDATA_MAP[slug];
const entity = ABOUT_ENTITY_MAP[slug];

const aboutSchema: Record<string, unknown> = {
    "@type": "Thing",
    "name": d.category,
};

if (entity) {
    aboutSchema["@type"] = entity.type;
    aboutSchema["name"] = entity.name;
    if (entity.alternateName) aboutSchema["alternateName"] = entity.alternateName;
}

if (sameAsUrls && sameAsUrls.length > 0) {
    aboutSchema["sameAs"] = sameAsUrls;
}

const videoWatchUrl = d.videoId ? `https://www.youtube.com/watch?v=${d.videoId}` : undefined;
const videoSchema = d.videoId && d.videoUploadDate && videoWatchUrl
    ? {
        "@type": "VideoObject",
        "@id": `${canonicalUrl.toString()}#video`,
        "name": d.videoTitle || d.title,
        "description": d.videoDescription || d.description,
        "thumbnailUrl": [
            d.videoThumbnailUrl || `https://img.youtube.com/vi/${d.videoId}/maxresdefault.jpg`,
            `https://img.youtube.com/vi/${d.videoId}/hqdefault.jpg`,
        ],
        "uploadDate": d.videoUploadDate.toISOString(),
        ...(d.videoDuration ? { "duration": d.videoDuration } : {}),
        "url": videoWatchUrl,
        "embedUrl": `https://www.youtube.com/embed/${d.videoId}`,
        "inLanguage": "tr-TR",
        "publisher": { "@id": SENAI_AKSOY_PERSON_ID },
        "isPartOf": { "@id": `${canonicalUrl.toString()}#article` },
        ...(d.videoChapters && d.videoChapters.length > 0 ? {
            "hasPart": d.videoChapters.map((chapter) => ({
                "@type": "Clip",
                "name": chapter.name,
                "startOffset": chapter.startOffset,
                "endOffset": chapter.endOffset,
                "url": chapter.url || `${videoWatchUrl}&t=${chapter.startOffset}s`,
            })),
        } : {}),
    }
    : undefined;

// Main Article schema. Publisher + WebSite + WebPage live in BaseLayout's graph.
const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonicalUrl.toString()}#article`,
    "mainEntityOfPage": { "@id": `${canonicalUrl.toString()}#webpage` },
    "headline": d.title,
    "description": d.description,
    ...(d.summary ? { "abstract": d.summary } : {}),
    "url": canonicalUrl.toString(),
    "inLanguage": "tr-TR",
    ...(schemaImages.length > 0 ? { "image": schemaImages } : {}),
    ...(imageObject ? { "primaryImageOfPage": { "@id": `${canonicalUrl.toString()}#primaryimage` } } : {}),
    ...(d.publishDate ? { "datePublished": d.publishDate.toISOString().split('T')[0] } : {}),
    ...(d.lastModified ? { "dateModified": d.lastModified.toISOString().split('T')[0] } : {}),
    "author": authorSchema,
    ...(reviewerSchema ? { "reviewedBy": reviewerSchema } : {}),
    ...(reviewerSchema && d.reviewDate ? { "lastReviewed": d.reviewDate.toISOString().split('T')[0] } : {}),
    "publisher": { "@id": ORG_ID },
    "isPartOf": { "@id": WEBSITE_ID },
    "about": aboutSchema,
    "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": "Patient",
    },
    "specialty": {
        "@type": "MedicalSpecialty",
        "name": "Reproductive Medicine",
    },
    ...(citations.length > 0 ? { "citation": citations } : {}),
    ...(videoSchema ? { "video": videoSchema } : {}),
};
