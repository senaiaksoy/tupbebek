---
/**
 * ArticleSchema — Makale bazli JSON-LD yapilandirilmis veri
 *
 * Her makale icin Article + gercek yazar/inceleyen + citation
 * schema.org markup'i uretir. BaseLayout'taki WebPage dugumune mainEntity
 * ile baglanir.
 *
 * Kullanim:
 *   <ArticleSchema entry={entry} url={articleUrl} />
 */

import { resolveImageDimensions } from '../utils/imageMetadata';
import { safeJsonLdStringify } from '../utils/seo';

interface Reference {
    title: string;
    type?: 'journalArticle' | 'systematicReview' | 'guideline' | 'regulation' | 'officialWebPage' | 'book' | 'report';
    authors?: string;
    journal?: string;
    year?: number;
    url?: string;
    doi?: string;
    pmid?: string;
}

interface Props {
    entry: {
        data: {
            title: string;
            description: string;
            summary?: string;
            author: string | { name: string; title?: string; credentials?: string; url?: string };
            authorTitle?: string;
            authorCredentials?: string;
            authorYoutube?: string;
            medicalReviewer?: string;
            reviewerTitle?: string;
            reviewType?: 'medical' | 'editorial';
            publishDate?: Date;
            lastModified?: Date;
            reviewDate?: Date;
            category: string;
            image?: string;
            imageSquare?: string;
            imageFourThree?: string;
            imageAlt?: string;
            imageCaption?: string;
            imageCredit?: string;
            imageCreator?: string;
            imageLicenseUrl?: string;
            imageAcquireLicensePage?: string;
            imageCopyrightNotice?: string;
            imageWidth?: number;
            imageHeight?: number;
            videoId?: string;
            videoTitle?: string;
            videoUploadDate?: Date;
            videoDescription?: string;
            videoDuration?: string;
            videoThumbnailUrl?: string;
            videoChapters?: Array<{
                name: string;
                startOffset: number;
                endOffset: number;
                url?: string;
            }>;
            references?: Reference[];
        };
        slug?: string;
    };
    url: string;
}

// Sitewide canonical @ids (mirror src/layouts/BaseLayout.astro — keep in sync)
const ORG_ID = 'https://tupbebek.com/#organization';
const WEBSITE_ID = 'https://tupbebek.com/#website';
const EDITORIAL_BOARD_ID = 'https://tupbebek.com/yayin-kurulu/#editorial-board';
// Canonical Person @id — portföy genelinde Dr. Aksoy tek entity'ye çözülür.
// senaiaksoy.net Block A'da deklare edilmiş tek kanonik kayıt; bu site
// yazar/senai-aksoy/ sayfasında tamamlayıcı attributes (alumniOf, memberOf
// vb.) ile aynı @id'yi extend eder.
const SENAI_AKSOY_PERSON_ID = 'https://senaiaksoy.net/#person';

const { entry, url } = Astro.props;
const canonicalUrl = new URL(url);
canonicalUrl.hash = '';
const d = entry.data;
const doiUrl = (doi: string) =>
    `https://doi.org/${doi.trim().replace(/[()]/g, (char) => (char === '(' ? '%28' : '%29'))}`;

// Resolve author without rewriting an editorial-board author as a physician.
const DEFAULT_AUTHOR_TITLE = 'Kadın Hastalıkları ve Doğum Uzmanı';
const DEFAULT_AUTHOR_CREDENTIALS = 'Üreme Tıbbı ve Yardımcı Üreme Teknikleri';
const DEFAULT_AUTHOR_YOUTUBE = 'https://www.youtube.com/@DocentDrSenaiAksoy';

const rawAuthorName = typeof d.author === 'string' ? d.author : d.author?.name;
const rawAuthorTitle = typeof d.author === 'string' ? d.authorTitle : d.author?.title;
const rawAuthorCredentials = typeof d.author === 'string' ? d.authorCredentials : d.author?.credentials;
const rawAuthorUrl = typeof d.author === 'string' ? undefined : d.author?.url;

const authorName = rawAuthorName;
const isSenaiAksoy = /senai\s+aksoy/i.test(authorName || '');
const isAuthorOrg = /kurul|ekip|tupbebek\.com/i.test(authorName || '');
const authorTitle = rawAuthorTitle || (isSenaiAksoy ? DEFAULT_AUTHOR_TITLE : undefined);
const authorCredentials = rawAuthorCredentials || (isSenaiAksoy ? DEFAULT_AUTHOR_CREDENTIALS : undefined);
const authorYoutube =
    d.authorYoutube
    || (rawAuthorUrl && /youtube\.com/i.test(rawAuthorUrl) ? rawAuthorUrl : undefined)
    || (isSenaiAksoy ? DEFAULT_AUTHOR_YOUTUBE : undefined);

// Build author schema. When Dr. Aksoy is the explicit author, reference the
// portfolio-wide canonical Person entity. Editorial teams remain Organizations.
const authorSchema: Record<string, unknown> = isSenaiAksoy
    ? { "@id": SENAI_AKSOY_PERSON_ID }
    : {
        "@type": isAuthorOrg ? "Organization" : "Person",
        "name": authorName,
        ...(!isAuthorOrg && authorTitle ? { "jobTitle": authorTitle } : {}),
        ...(!isAuthorOrg && authorCredentials ? { "qualifications": authorCredentials } : {}),
        ...(rawAuthorUrl && !/youtube\.com/i.test(rawAuthorUrl) ? { "url": rawAuthorUrl } : {}),
        ...(authorYoutube ? { "sameAs": authorYoutube } : {}),
    };

// Build reviewer schema — Dr. Aksoy reviewer olduğunda canonical @id'ye
// resolve et (senaiaksoy.net Block A'daki Person entity'ye). Inline Person
// üretmek yerine @id referansı, AI engine'lerin reviewer = author = Wikidata
// Q139893832 entity'sini tek node olarak çözmesini sağlar.
const isReviewerSenaiAksoy = d.medicalReviewer && /senai\s+aksoy/i.test(d.medicalReviewer);
const isReviewerOrg = d.medicalReviewer ? /Kurul|Ekip/i.test(d.medicalReviewer) : false;
const reviewerSchema = d.reviewType !== 'editorial' && d.medicalReviewer
    ? (isReviewerSenaiAksoy
        ? (isReviewerOrg
            ? [{ "@id": SENAI_AKSOY_PERSON_ID }, { "@id": EDITORIAL_BOARD_ID }]
            : { "@id": SENAI_AKSOY_PERSON_ID })
        : {
            "@type": isReviewerOrg ? "Organization" : "Person",
            "name": d.medicalReviewer,
            // jobTitle is a Person-only property in schema.org; Organization reviewers omit it.
            ...(!isReviewerOrg && d.reviewerTitle ? { "jobTitle": d.reviewerTitle } : {}),
        })
    : undefined;

const referenceSchemaTypes: Record<NonNullable<Reference['type']>, string> = {
    journalArticle: 'ScholarlyArticle',
    systematicReview: 'ScholarlyArticle',
    guideline: 'MedicalGuideline',
    regulation: 'Legislation',
    officialWebPage: 'WebPage',
    book: 'Book',
    report: 'Report',
};

// Build citations from explicit references. Search-result URLs and synthetic
// literature records are deliberately not generated.
const citations = d.references?.map(ref => {
    const pubMedUrl = ref.pmid ? `https://pubmed.ncbi.nlm.nih.gov/${ref.pmid}/` : undefined;
    const directUrls = [
        ...(ref.doi ? [doiUrl(ref.doi)] : []),
        ...(pubMedUrl ? [pubMedUrl] : []),
        ...(ref.url ? [ref.url] : []),
    ];
    const inferredType = ref.type
        ? referenceSchemaTypes[ref.type]
        : (ref.pmid || ref.doi || ref.journal ? 'ScholarlyArticle' : 'CreativeWork');
    const citation: Record<string, unknown> = {
        "@type": inferredType,
        "name": ref.title,
        ...(directUrls[0] ? { "url": directUrls[0] } : {}),
    };
    if (ref.authors) citation["author"] = ref.authors;
    if (ref.journal) citation["isPartOf"] = { "@type": "Periodical", "name": ref.journal };
    if (ref.year) citation["datePublished"] = String(ref.year);
    if (ref.pmid) {
        citation["identifier"] = {
            "@type": "PropertyValue",
            "propertyID": "PMID",
            "value": ref.pmid,
        };
    }
    if (directUrls.length > 0) citation["sameAs"] = [...new Set(directUrls)];
    return citation;
}) || [];

// Build ImageObject for the article hero image
const absoluteImageUrl = d.image
    ? (d.image.startsWith('http') ? d.image : `https://tupbebek.com${d.image}`)
    : undefined;

// Boyut çözümleme: frontmatter override > disk metadata > 1600x900 fallback.
// [...slug].astro hero <img> ile aynı utility çağrıldığı için cache hit olur,
// disk I/O tek seferdir.
const heroDims = absoluteImageUrl
    ? resolveImageDimensions({
        image: d.image,
        frontmatterWidth: d.imageWidth,
        frontmatterHeight: d.imageHeight,
    })
    : null;

const imageCreatorSchema = d.imageCreator
    ? { "@type": "Person", "name": d.imageCreator }
    : { "@type": "Organization", "name": "tupbebek.com Yayın Kurulu" };

const imageObject = absoluteImageUrl && heroDims ? {
    "@type": "ImageObject",
    "@id": `${canonicalUrl.toString()}#primaryimage`,
    "url": absoluteImageUrl,
    "contentUrl": absoluteImageUrl,
    "width": heroDims.width,
    "height": heroDims.height,
    ...(d.imageCaption ? { "caption": d.imageCaption } : {}),
    "creditText": d.imageCredit || "tupbebek.com Yayın Kurulu",
    "creator": imageCreatorSchema,
    "copyrightNotice": d.imageCopyrightNotice || "© tupbebek.com - Tüm hakları saklıdır.",
    "license": d.imageLicenseUrl || "https://tupbebek.com/editoryal-politika/",
    "acquireLicensePage": d.imageAcquireLicensePage || "https://tupbebek.com/iletisim/",
    "representativeOfPage": true,
} : undefined;

const toAbsoluteImageUrl = (imagePath?: string) => imagePath
    ? (imagePath.startsWith('http') ? imagePath : `https://tupbebek.com${imagePath}`)
    : undefined;
const alternateImageObjects = [d.imageFourThree, d.imageSquare]
    .map(toAbsoluteImageUrl)
    .filter((imageUrl): imageUrl is string => Boolean(imageUrl))
    .map((imageUrl) => ({
        "@type": "ImageObject",
        "url": imageUrl,
        "contentUrl": imageUrl,
        "license": d.imageLicenseUrl || "https://tupbebek.com/editoryal-politika/",
        "acquireLicensePage": d.imageAcquireLicensePage || "https://tupbebek.com/iletisim/",
        "creator": imageCreatorSchema,
        "creditText": d.imageCredit || "tupbebek.com Yayın Kurulu",
        "copyrightNotice": d.imageCopyrightNotice || "© tupbebek.com - Tüm hakları saklıdır.",
    }));
const schemaImages = imageObject ? [imageObject, ...alternateImageObjects] : alternateImageObjects;

