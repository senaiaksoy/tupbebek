---
/**
 * Makale başında yalnızca okurun güven kararına yarayan kimlik bilgilerini
 * gösterir. Ayrıntılı inceleme yöntemi sayfanın sonunda yer alır.
 */
interface Props {
    author: string;
    authorTitle?: string;
    authorCredentials?: string;
    authorUrl?: string;
    authorYoutube?: string;
    medicalReviewer?: string;
    reviewerTitle?: string;
    reviewType?: 'medical' | 'editorial';
    reviewDate?: string;
    lastModified?: string;
}

const {
    author,
    authorTitle,
    authorCredentials,
    authorUrl,
    authorYoutube,
    medicalReviewer,
    reviewerTitle,
    reviewType = 'medical',
    reviewDate,
    lastModified,
} = Astro.props;

const normalizePerson = (value?: string) =>
    (value || '')
        .normalize('NFKC')
        .replace(/\s+/g, ' ')
        .trim()
        .toLocaleLowerCase('tr-TR');

const isSameAuthorAndReviewer =
    reviewType === 'medical' &&
    Boolean(medicalReviewer) &&
    normalizePerson(author) === normalizePerson(medicalReviewer);
const reviewLabel = reviewType === 'editorial' ? 'Editoryal kontrol' : 'Tıbbi inceleme';
const identityLabel = reviewType === 'editorial'
    ? 'Yazar ve editoryal kontrol bilgileri'
    : 'Yazar ve tıbbi inceleme bilgileri';
---

<div class="border-y border-gray-200 py-3 text-sm text-gray-600" aria-label={identityLabel}>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 leading-relaxed">
        <span class="text-gray-500">{isSameAuthorAndReviewer ? 'Yazan ve tıbben inceleyen' : 'Yazan'}</span>
        {authorUrl ? (
            <a href={authorUrl} class="font-semibold text-gray-900 underline decoration-gray-300 underline-offset-2 hover:text-primary-700">
                {author}
            </a>
        ) : (
            <strong class="font-semibold text-gray-900">{author}</strong>
        )}
        {authorTitle && <span>· {authorTitle}</span>}
        {authorYoutube && (
            <a
                href={authorYoutube}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full text-red-600 hover:bg-red-50"
                aria-label={`${author} YouTube kanalı`}
                title="YouTube"
            >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
            </a>
        )}
    </div>

    {authorCredentials && <p class="mt-1 text-xs text-gray-500">{authorCredentials}</p>}

    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
        {medicalReviewer && !isSameAuthorAndReviewer && (
            <span>
                {reviewLabel}: <strong class="font-semibold text-gray-700">{medicalReviewer}</strong>
                {reviewerTitle && <> · {reviewerTitle}</>}
            </span>
        )}
        {reviewDate && <span>İnceleme: {reviewDate}</span>}
        {lastModified && <span>Son güncelleme: {lastModified}</span>}
    </div>
</div>
