---
const stages = [
  {
    step: 1,
    title: "Gebelik olmuyor, nereden başlamalıyım?",
    description: "İnfertilite nedenleri ve ilk değerlendirme başlıkları.",
    link: "/kadin-infertilitesi",
    icon: "psychiatry"
  },
  {
    step: 2,
    title: "Testlerim var, nasıl okumalıyım?",
    description: "Hormon paneli ve laboratuvar raporu yorumlama temelleri.",
    link: "/tani-sureci",
    icon: "lab_research"
  },
  {
    step: 3,
    title: "Sonuçlar ne anlama geliyor?",
    description: "Tahlil sonuçlarının klinik karşılıkları.",
    link: "/hormon-paneli",
    icon: "analytics"
  },
  {
    step: 4,
    title: "Tedavi yöntemleri nelerdir?",
    description: "IVF, IUI ve diğer seçeneklerin kısa karşılaştırması.",
    link: "/tedavi-yontemleri",
    icon: "biotech"
  },
  {
    step: 5,
    title: "IVF süreci nasıl ilerler?",
    description: "Hazırlık, ilaçlar ve laboratuvar sürecine toplu bakış.",
    link: "/rehberler",
    icon: "step_into"
  },
  {
    step: 6,
    title: "Duygusal yükle nasıl başa çıkılır?",
    description: "Psikolojik destek ve süreç yönetimi kaynakları.",
    link: "/psikolojik-destek",
    icon: "self_improvement"
  }
];
---

<section class="py-16 lg:py-24 paper-canvas border-t border-gray-200/60">
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 text-center pb-12 lg:pb-16">
    <span class="text-primary-700 uppercase tracking-[0.25em] text-xs font-bold mb-3 block">HASTA KARAR YOLCULUĞU</span>
    <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 mb-4">Adım Adım Bilgi Yol Haritası</h2>
    <p class="text-base text-gray-600 max-w-2xl mx-auto font-sans">Tedavi ve değerlendirme yolculuğunuzun her aşamasında öncelikli takip etmeniz gereken tıbbi rehberler.</p>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 relative">
    <div class="hidden lg:block absolute top-[120px] left-8 right-8 h-0.5 bg-gradient-to-r from-primary/5 via-primary/40 to-primary/5 z-0"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 relative z-10">
      {stages.map((stage) => (
        <div class="group">
          <a href={stage.link} class="flex flex-col items-center">
            <div class="w-20 h-20 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center mb-8 shadow-sm group-hover:border-primary group-hover:shadow-lg group-hover:scale-110 transition-all duration-500 bg-white">
              <span class="material-symbols-outlined text-primary-600 text-3xl">{stage.icon}</span>
            </div>

            <div class="text-center px-4">
              <h3 class="text-sm font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors h-10 flex items-center justify-center">{stage.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                {stage.description}
              </p>
            </div>

            <div class="mt-4 px-3 py-1 bg-gray-100 rounded-full text-[10px] font-bold text-gray-500 uppercase tracking-widest">
              AŞAMA {stage.step}
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
