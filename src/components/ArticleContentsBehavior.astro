<script>
  const desktop = window.matchMedia('(min-width: 1024px)');
  const setContentsState = () => {
    document.querySelectorAll<HTMLDetailsElement>('details.article-contents').forEach(contents => {
      contents.open = desktop.matches;
    });
  };
  setContentsState();
  desktop.addEventListener('change', setContentsState);
</script>

