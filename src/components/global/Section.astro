---
import classnames from "classnames";

const { class: className } = Astro.props;
const classNames = classnames("section", className);
---

<section class={classNames}>
  <slot />
</section>

<style lang="scss">
  .ivf-in-turkey {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xlarge);
    margin: auto;
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    /* Premium Glassmorphism */
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.6) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 
      0 12px 32px rgba(40, 64, 157, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    padding-block: calc(var(--spacing-large) * 1.5);

    &:hover {
      transform: translateY(-4px);
      box-shadow: 
        0 24px 48px rgba(40, 64, 157, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 1);
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.75) 100%);
    }

    @media screen and (min-width: 1024px) {
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 1rem;
      padding-inline: var(--spacing-large);
    }
  }

  .who-we-are {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--spacing-xlarge);
    margin: auto;
    max-width: min(calc(var(--container-width) - 12rem), calc(100vw - 2rem));
    padding-block: var(--spacing-medium);

    @media screen and (min-width: 1024px) {
      padding: calc(var(--spacing-large) * 1.5)
        calc(var(--spacing-xlarge) * 1.5);
    }

    @media screen and (min-width: 768px) {
      grid-template-columns: 1fr 380px;
    }
  }

  .success-rates {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-big);
    padding-block: var(--spacing-medium);
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    margin: auto;

    @media screen and (min-width: 1024px) {
      padding: calc(var(--spacing-large) * 1.5)
        calc(var(--spacing-xlarge) * 1.5);
    }
  }

  .ivf-explained {
    display: flex;
    flex-direction: column;
    margin: auto;
    gap: var(--spacing-xlarge);
    padding-block: var(--spacing-medium);
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    /* Premium Glassmorphism */
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.6) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 
      0 12px 32px rgba(40, 64, 157, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);

    &:hover {
      transform: translateY(-4px);
      box-shadow: 
        0 24px 48px rgba(40, 64, 157, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 1);
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.75) 100%);
    }

    @media screen and (min-width: 1024px) {
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 1rem;
      padding: calc(var(--spacing-large) * 1.5)
        calc(var(--spacing-xlarge) * 1.5);
    }
  }

  .articles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-large);
    padding-block: var(--spacing-large);
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    margin: auto;
  }
</style>
