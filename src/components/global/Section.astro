---
import classnames from "classnames";

const { class: className } = Astro.props;
const classNames = classnames("section", className);
---

<section class={classNames}>
  <slot />
</section>

<style lang="scss">
  .ivf-in-turkey {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xlarge);
    margin: auto;
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    background-color: white;
    padding-block: calc(var(--spacing-large) * 1.5);

    @media screen and (min-width: 1024px) {
      border: 1px solid var(--color-gray-10);
      border-radius: 1rem;
      padding-inline: var(--spacing-large);
    }
  }

  .who-we-are {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--spacing-xlarge);
    margin: auto;
    max-width: min(calc(var(--container-width) - 12rem), calc(100vw - 2rem));
    padding-block: var(--spacing-medium);

    @media screen and (min-width: 1024px) {
      padding: calc(var(--spacing-large) * 1.5)
        calc(var(--spacing-xlarge) * 1.5);
    }

    @media screen and (min-width: 768px) {
      grid-template-columns: 1fr 380px;
    }
  }

  .success-rates {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-big);
    padding-block: var(--spacing-medium);
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    margin: auto;

    @media screen and (min-width: 1024px) {
      padding: calc(var(--spacing-large) * 1.5)
        calc(var(--spacing-xlarge) * 1.5);
    }
  }

  .ivf-explained {
    display: flex;
    flex-direction: column;
    margin: auto;
    gap: var(--spacing-xlarge);
    padding-block: var(--spacing-medium);
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    background-color: white;

    @media screen and (min-width: 1024px) {
      border: 1px solid var(--color-gray-10);
      border-radius: 1rem;
      padding: calc(var(--spacing-large) * 1.5)
        calc(var(--spacing-xlarge) * 1.5);
    }
  }

  .articles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-large);
    padding-block: var(--spacing-large);
    max-width: min(calc(var(--container-width) - 2rem), calc(100vw - 2rem));
    margin: auto;
  }
</style>
