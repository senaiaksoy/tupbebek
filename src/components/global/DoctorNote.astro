---
/**
 * DoctorNote — konuya ozel, imzali uzman katkisi.
 *
 * Bilesen yalnizca frontmatter'da gercek bir uzman katkisi tanimlandiginda
 * render edilir. Genel klinik deneyim veya kurum baglantisi uretmez.
 */
interface Props {
  title?: string;
  question: string;
  note: string;
  topic?: string;
  author: string;
  authorTitle?: string;
  authorUrl?: string;
  answeredAt: Date;
}

const {
  title = 'Uzman katkısı',
  question,
  note,
  topic,
  author,
  authorTitle,
  authorUrl,
  answeredAt,
} = Astro.props;

const answeredAtLabel = answeredAt.toLocaleDateString('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<aside class="my-10 rounded-xl border border-amber-200/80 bg-[#fcfaf5] p-5 shadow-2xs md:p-6" aria-label={title}>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-amber-800">
      <span class="material-symbols-outlined text-base" aria-hidden="true">edit_note</span>
      {title}
    </span>
    {topic && (
      <span class="rounded border border-primary-100 bg-primary-50 px-2 py-0.5 text-xs font-semibold text-primary-700">
        {topic}
      </span>
    )}
  </div>

  <p class="mb-2 text-xs font-semibold text-gray-600">Dr. Aksoy'a sorulan soru</p>
  <p class="mb-4 text-sm font-semibold leading-relaxed text-gray-900 md:text-base">{question}</p>

  <blockquote class="m-0 border-l-2 border-amber-500/60 pl-4 text-sm leading-relaxed text-gray-700 md:text-base">
    <p class="m-0 whitespace-pre-line">{note}</p>
  </blockquote>

  <footer class="mt-4 border-t border-amber-200/60 pt-3 text-xs text-gray-600">
    <span>İmzalayan: </span>
    {authorUrl ? (
      <a href={authorUrl} class="font-semibold text-primary-700 underline underline-offset-2 hover:text-primary-800">
        {author}
      </a>
    ) : (
      <strong class="font-semibold text-gray-800">{author}</strong>
    )}
    {authorTitle && <span> · {authorTitle}</span>}
    <span> · Yanıt: {answeredAtLabel}</span>
    <span> · Yayın onayı kayıtlı</span>
  </footer>
</aside>
