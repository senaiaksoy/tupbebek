---
/**
 * Eski makalelerdeki vurgulu metinler için tarafsız klinik çerçeve.
 * Hekim imzalı gerçek görüşler yalnızca DoctorNote ile yayımlanır.
 */
interface Props {
  label?: string;
}

const { label = 'Klinik çerçeve' } = Astro.props;
---

<aside class="not-prose my-8 rounded-xl border-l-4 border-primary-500 bg-primary-50/60 px-5 py-4" aria-label={label}>
  <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-700">{label}</p>
  <div class="text-sm leading-relaxed text-gray-700 md:text-base">
    <slot />
  </div>
</aside>

<style is:global>
  .prose-medical aside[aria-label="Klinik çerçeve"] p:last-child {
    margin-bottom: 0;
  }
</style>
