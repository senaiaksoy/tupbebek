---
import { Image } from "astro:assets";

import Icon from "../../icons/index.astro";
import CTA from "./CTA.astro";
import Title from "./Title.astro";
import heroImage from "/public/home-hero.webp";
---

<div class="hero mesh-hero">
  <div class="container">
    <div class="text">
      <Title size="large">Tüp bebek yolculuğunuza hemen başlayın</Title>
      <p>
        Tedavi sürecinizi hemen başlatmak, bilgi veya randevu almak için bize
        ulaşın.
      </p>
      <p>
        <CTA
          href="/iletisim"
          size="large"
          title="Tüpbebek yolculuğunuza şimdi başlayın"
        >
          İletişim
          <Icon name="arrowRight" />
        </CTA>
      </p>
    </div>

    <div class="image">
      <Image
        src={heroImage}
        width={heroImage.width}
        height={heroImage.height}
        alt="Dr. Senai Aksoy Tüpbebek Merkezi"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</div>

<style lang="scss">
  .hero {
    grid-column: span 3;
    padding: var(--spacing-large);

    .container {
      max-width: calc(var(--container-width) - 12rem);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-large);
      place-items: center;
      margin: auto;

      :global(h1) {
        color: #5a6db4;
      }

      p {
        font-family: var(--font-secondary);
        font-size: 1.5rem;
      }
    }

    .image {
      max-width: 500px;
      height: auto;
      aspect-ratio: 1;

      img {
        display: block;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        -webkit-mask-image: url("data:image/svg+xml;base64,");
        mask-image: url("data:image/svg+xml;base64,");
        -webkit-mask-position: center;
        mask-position: center;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-size: 100% 100%;
      }
    }

    @media screen and (max-width: 1023px) {
      padding: var(--spacing-medium);

      .container {
        grid-template-columns: 1fr;
      }

      .image {
        order: -1;
      }
    }
  }
</style>
