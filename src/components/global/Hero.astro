---
import { Image } from "astro:assets";

import Icon from "../../icons/index.astro";
import CTA from "./CTA.astro";
const heroImage = "/home-hero.webp";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-content glass-card">
      <h1 id="hero-title" class="premium-title">
        Tüp Bebek Yolculuğunuza <br />
        <span class="accent-text">Güvenle Başlayın</span>
      </h1>
      <p class="hero-description">
        Doç. Dr. Senai Aksoy ve ekibi, 30 yılı aşkın tecrübe ve modern tıp teknikleriyle, ebeveynlik hayalinize giden yolda yanınızda.
      </p>
      <div class="hero-actions">
        <CTA href="/randevu" variant="primary" size="large" title="Randevu Alın">
          Süreci Başlatın
          <Icon name="arrowRight" />
        </CTA>
        <CTA href="/tup-bebek-basari-oranlari" variant="secondary" size="large" title="Başarı Oranlarımız">
          Başarı Oranları
        </CTA>
      </div>
    </div>
    <div class="hero-image-container">
      <div class="image-mask">
        <Image
          src={heroImage}
          alt="Ebeveynlik Yolculuğu - Dr. Senai Aksoy"
          width={1200}
          height={1200}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto !important;
    padding: 0 var(--spacing-large);
    box-sizing: border-box;
  }

  .hero {
    position: relative;
    padding: 160px 0 100px;
    overflow: hidden;
    min-height: 90vh;
    display: flex;
    align-items: center;
  }


  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--spacing-xlarge);
    align-items: center;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--spacing-large);
    }
  }

  .hero-content {
    background: rgba(255, 255, 255, 0.95); /* Increased opacity for better contrast */
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    padding: var(--spacing-xlarge);
    border-radius: var(--border-radius-premium);
    box-shadow: 0 12px 40px rgba(40, 64, 157, 0.15); /* Slightly more prominent shadow */
    z-index: 2;

    h1 {
      font-size: clamp(2.5rem, 5vw, 4rem);
      line-height: 1.1;
      margin-bottom: var(--spacing-big);
      color: var(--color-brand-secondary);

      .accent-text {
        color: var(--color-brand-primary);
        display: block;
      }
    }
  }

  .hero-image-container {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;

    .image-mask {
      border-radius: var(--border-radius-premium);
      overflow: hidden;
      box-shadow: var(--shadow-xl);
      transform: perspective(1000px) rotateY(-5deg);
      transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
      width: 100%;
      max-width: 600px; /* Constrain size */
      background: #f0f4f8; /* Placeholder color */

      &:hover {
        transform: perspective(1000px) rotateY(0deg);
      }
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xlarge);
    max-width: 600px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-medium);

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

</style>
