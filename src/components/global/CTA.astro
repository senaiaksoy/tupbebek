---
import classnames from "classnames";

const { variant = "primary", href, size = "medium", title } = Astro.props;
const classNames = classnames("cta", variant, size);
---

<a href={href} class={classNames} title={title}>
  <slot />
</a>

<style lang="scss">
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 2.25rem;
    border-radius: 100px;
    font-weight: 600;
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    text-decoration: none;
    letter-spacing: 0.5px;
    font-size: 1.05rem;
    position: relative;
    overflow: hidden;

    &.primary {
      /* Premium Pink-Tinted Frosted Glass Variant for Main CTA */
      background: linear-gradient(145deg, var(--color-brand-primary-light) 0%, rgba(255, 255, 255, 0.9) 100%);
      color: var(--color-brand-secondary); /* Navy text for very high readability */
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(216, 32, 151, 0.15); /* Slight pink border tint */
      box-shadow: 
        0 8px 24px rgba(40, 64, 157, 0.08),
        inset 0 1px 1px rgba(255, 255, 255, 0.8);

      &:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 
          0 16px 32px rgba(40, 64, 157, 0.15),
          inset 0 1px 1px rgba(255, 255, 255, 0.9);
        /* Deepen the pink tint slightly on hover */
        background: linear-gradient(145deg, var(--color-brand-primary-light) 0%, rgba(216, 32, 151, 0.08) 100%);
        color: var(--color-brand-secondary);
      }
    }

    &.secondary {
      background: linear-gradient(145deg, var(--color-brand-secondary-light) 0%, rgba(255, 255, 255, 0.8) 100%);
      color: var(--color-brand-secondary);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(40, 64, 157, 0.15); /* Slight navy border tint */
      box-shadow: 
        0 4px 15px rgba(0, 0, 0, 0.04),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);

      &:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 
          0 12px 25px rgba(40, 64, 157, 0.12),
          inset 0 1px 0 rgba(255, 255, 255, 0.9);
        background: linear-gradient(145deg, var(--color-brand-secondary-light) 0%, var(--color-brand-primary-light) 100%);
        color: var(--color-brand-secondary);
      }
    }
  }

  .small {
    padding: 0.6rem 1.5rem;
    font-size: 0.95rem;
  }
</style>
