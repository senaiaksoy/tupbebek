---
/**
 * PeerCommentary — Dr. Aksoy disindaki bir hekimin makaleye imzali kisa gorusu.
 *
 * Yalnizca yazarinin son metni onayladigi (approvalStatus: approved) kayitlar
 * render edilir. Klinik baglanti, iletisim veya randevu bilgisi gostermez.
 */
interface Commentary {
  author: string;
  authorTitle?: string;
  affiliation?: string;
  boardProfile?: string;
  text: string;
  receivedAt: Date | string;
  approvedAt?: Date | string;
  approvalStatus: 'pending' | 'approved';
}

interface Props {
  items?: Commentary[];
  title?: string;
}

const { items = [], title } = Astro.props;
const approved = items.filter((item) => item.approvalStatus === 'approved' && item.approvedAt);

const formatDate = (value: Date | string) =>
  new Date(value).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

{approved.map((item) => {
  const label = title ?? (item.boardProfile ? 'Yayın kurulu üyesi görüşü' : 'Meslektaş görüşü');
  return (
  <aside class="not-prose my-8 rounded-xl border border-mint-200 bg-mint-50/50 p-5 shadow-2xs md:p-6" aria-label={`${label}: ${item.author}`}>
    <p class="!mb-3 !mt-0 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-mint-800">
      <span class="material-symbols-outlined text-base" aria-hidden="true">rate_review</span>
      {label}
    </p>

    <!-- Makale gövdesindeki .prose-medical blockquote kutusunu bu çerçevede sıfırla. -->
    <blockquote class="!m-0 !rounded-none !border-0 !border-l-2 !border-solid !border-mint-500/60 !bg-transparent !py-0 !pl-4 !pr-0">
      <p class="!m-0 whitespace-pre-line !text-sm !leading-relaxed !text-gray-700 md:!text-base">{item.text}</p>
    </blockquote>

    <footer class="mt-4 border-t border-mint-200/70 pt-3 text-xs leading-relaxed text-gray-600">
      {item.boardProfile ? (
        <a href={item.boardProfile} class="font-semibold text-primary-700 underline underline-offset-2 hover:text-primary-800">{item.author}</a>
      ) : (
        <strong class="font-semibold text-gray-800">{item.author}</strong>
      )}
      {item.authorTitle && <span> · {item.authorTitle}</span>}
      {item.affiliation && <span> · {item.affiliation}</span>}
      {item.boardProfile && <span> · tupbebek.com Yayın Kurulu üyesi</span>}
      <span class="block mt-1">
        Makaleyi okuduktan sonra {formatDate(item.receivedAt)} tarihinde yazılı iletildi; metnin son halini yazarı {formatDate(item.approvedAt!)} tarihinde onayladı. Görüş yazarına aittir.
      </span>
    </footer>
  </aside>
  );
})}
