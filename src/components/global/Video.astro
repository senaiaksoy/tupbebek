---
const { id } = Astro.props;
---

<div class="video-container" data-video-id={id}>
  <div class="video-placeholder">
    <img 
      src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`} 
      alt="Video preview" 
      loading="lazy"
      width="1280"
      height="720"
    />
    <button class="play-button" aria-label="Play video">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  function initVideo() {
    const containers = document.querySelectorAll('.video-container');
    containers.forEach(container => {
      const button = container.querySelector('.play-button');
      if (!button) return;
      
      button.addEventListener('click', () => {
        const id = (container as HTMLElement).dataset.videoId;
        container.innerHTML = `
          <iframe
            width="100%"
            height="100%"
            src="https://www.youtube.com/embed/${id}?autoplay=1"
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            frameborder="0"
            allowfullscreen>
          </iframe>
        `;
      });
    });
  }

  // Handle both initial load and view transitions
  initVideo();
  document.addEventListener('astro:after-swap', initVideo);
</script>

<style lang="scss">
  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border-radius: var(--spacing-small);
    overflow: hidden;

    .video-placeholder {
      position: relative;
      width: 100%;
      height: 100%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;

      img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
        transition: opacity 0.3s ease;
      }

      &:hover img {
        opacity: 1;
      }

      .play-button {
        position: relative;
        z-index: 1;
        width: 68px;
        height: 48px;
        background: rgba(0, 0, 0, 0.8);
        border: none;
        border-radius: 12px;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.3s ease, transform 0.2s ease;

        svg {
          width: 32px;
          height: 32px;
        }

        &:hover {
          background: #ff0000;
          transform: scale(1.1);
        }
      }
    }

    iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
  }
</style>
