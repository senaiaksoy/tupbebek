---
import { EVIDENCE_GRADE_MAP, EVIDENCE_GRADE_ORDER, type RecommendationGrade } from '../data/evidenceGrades';

interface Props {
  grade: RecommendationGrade;
}

const { grade } = Astro.props;
const activeGrade = EVIDENCE_GRADE_MAP[grade];
---

<section class:list={['rounded-2xl border p-5 md:p-6 mt-6', activeGrade.panelClass]} aria-label="Kanıt düzeyi">
  <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Öneri Derecesi</p>
      <div class="mt-3 flex items-center gap-3">
        <span class:list={['inline-flex min-w-[3.5rem] items-center justify-center rounded-full px-3 py-1 text-sm font-bold shadow-sm', activeGrade.badgeClass]}>
          {activeGrade.grade}
        </span>
        <div>
          <p class:list={['text-lg font-bold', activeGrade.accentClass]}>{activeGrade.label}</p>
          <p class="text-sm text-gray-600">{activeGrade.strength}</p>
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-gray-700">
        Bu sınıflandırma, Oxford CEBM ve USPSTF benzeri bilimsel hiyerarşileri daha pratik bir editoryal dile çevirir.
        {activeGrade.description}
      </p>
    </div>

    <div class="grid gap-2 text-sm min-w-[18rem]">
      {EVIDENCE_GRADE_ORDER.map((gradeKey) => {
        const item = EVIDENCE_GRADE_MAP[gradeKey];
        const isActive = gradeKey === grade;

        return (
          <div class:list={[
            'rounded-xl border px-3 py-2 transition-colors',
            isActive ? `${item.panelClass} ${item.ringClass} ring-2 border-transparent` : 'border-gray-200 bg-white/70'
          ]}>
            <div class="flex items-center gap-2">
              <span class:list={['inline-flex min-w-[3.25rem] items-center justify-center rounded-full px-2.5 py-1 text-xs font-bold', item.badgeClass]}>
                {item.grade}
              </span>
              <span class="font-semibold text-gray-900">{item.label}</span>
            </div>
            <p class="mt-1 text-xs leading-relaxed text-gray-600">{item.strength}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
