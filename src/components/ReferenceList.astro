---
/**
 * ReferenceList — Bilimsel ve kurumsal kaynak listesi
 *
 * Makale iceriginin altinda bilimsel kaynaklari numarali
 * liste halinde gosterir. DOI ve URL linkleri iceriri.
 *
 * Kullanim:
 *   <ReferenceList references={entry.data.references} />
 */
interface Reference {
    title: string;
    type?: 'journalArticle' | 'systematicReview' | 'guideline' | 'regulation' | 'officialWebPage' | 'book' | 'report';
    authors?: string;
    journal?: string;
    year?: number;
    url?: string;
    doi?: string;
    pmid?: string;
}

interface Props {
    references: Reference[];
}

const { references } = Astro.props;
const doiUrl = (doi: string) =>
    `https://doi.org/${doi.trim().replace(/[()]/g, (char) => (char === '(' ? '%28' : '%29'))}`;
const pubMedUrl = (pmid: string) => `https://pubmed.ncbi.nlm.nih.gov/${pmid.trim()}/`;
const referenceTypeLabel = (ref: Reference) => {
    if (ref.type === 'officialWebPage') return 'Resmî web kaynağı';
    if (ref.type === 'guideline') return 'Klinik rehber';
    if (ref.type === 'regulation') return 'Mevzuat';
    if (ref.type === 'book') return 'Kitap';
    if (ref.type === 'report') return 'Rapor';
    if (ref.type === 'systematicReview') return 'Sistematik derleme';
    if (ref.type === 'journalArticle' || ref.pmid || ref.doi || ref.journal) return 'Bilimsel yayın';
    return 'Kaynak';
};
---

{references && references.length > 0 && (
    <section class="mt-12 pt-8 border-t border-gray-200" aria-label="Kaynaklar">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-primary-600 text-xl">science</span>
            </div>
            <div>
                <h2 class="font-headline text-lg font-bold text-gray-900">Kaynaklar</h2>
                <p class="text-xs text-gray-500">{references.length} referans</p>
            </div>
        </div>

        <ol class="space-y-3 list-none">
            {references.map((ref, i) => (
                <li class="flex gap-3 text-sm group">
                    <span class="w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center shrink-0 text-xs font-bold text-gray-500 mt-0.5 group-hover:bg-primary-50 group-hover:text-primary-600 transition-colors">
                        {i + 1}
                    </span>
                    <div class="min-w-0">
                        <p class="text-gray-800 leading-relaxed">
                            {ref.authors && <span class="text-gray-500">{ref.authors}. </span>}
                            <span class="font-semibold">{ref.title}</span>
                            {ref.journal && <span class="italic text-gray-500">. {ref.journal}</span>}
                            {ref.year && <span class="text-gray-500"> ({ref.year})</span>}
                        </p>
                        <p class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-gray-500">
                            {referenceTypeLabel(ref)}
                        </p>
                        <div class="flex items-center gap-3 mt-1">
                            {ref.pmid && (
                                <a
                                    href={pubMedUrl(ref.pmid)}
                                    class="inline-flex items-center gap-1 text-xs text-primary-600 hover:text-primary-700 font-semibold transition-colors"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="material-symbols-outlined text-[12px]">link</span>
                                    PubMed: {ref.pmid}
                                </a>
                            )}
                            {!ref.pmid && ref.doi && (
                                <a
                                    href={doiUrl(ref.doi)}
                                    class="inline-flex items-center gap-1 text-xs text-primary-600 hover:text-primary-700 font-semibold transition-colors"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="material-symbols-outlined text-[12px]">link</span>
                                    DOI: {ref.doi}
                                </a>
                            )}
                            {ref.url && !ref.pmid && !ref.doi && (
                                <a
                                    href={ref.url}
                                    class="inline-flex items-center gap-1 text-xs text-primary-600 hover:text-primary-700 font-semibold transition-colors"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="material-symbols-outlined text-[12px]">open_in_new</span>
                                    Kaynak
                                </a>
                            )}
                        </div>
                    </div>
                </li>
            ))}
        </ol>
    </section>
)}
