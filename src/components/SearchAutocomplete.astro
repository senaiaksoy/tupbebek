---
// SearchAutocomplete.astro
// Pagefind-powered search with modal overlay UI
// Usage: <SearchAutocomplete />

import { getSearchData } from '../utils/searchData';

export interface Props {
  placeholder?: string;
  maxResults?: number;
}

const {
  placeholder = 'Rehberlerde ara...',
  maxResults = 8
} = Astro.props;

const fallbackData = await getSearchData();
---

<!-- Search Modal/Overlay -->
<div id="search-modal"
     class="hidden fixed inset-0 z-[1000] bg-black/50 backdrop-blur-sm
            transition-all duration-300 opacity-0 invisible"
     role="dialog"
     aria-modal="true"
     aria-label="Arama"
     onclick="if(event.target === this) window.__closeSearchModal?.()">

  <div class="relative h-full flex items-start justify-center pt-20">
    <!-- Search Container -->
    <div class="w-full max-w-2xl mx-4 glass-card rounded-3xl shadow-2xl overflow-hidden
                transform transition-all duration-500 scale-95 opacity-0 active-modal:scale-100 active-modal:opacity-100">

      <!-- Search Input Wrapper -->
      <div class="relative p-6 border-b border-gray-100/50 bg-white/40">
        <div class="relative flex items-center gap-4">
          <span class="text-primary-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-[28px]">search</span>
          </span>
          <input
            id="search-input"
            type="search"
            placeholder={placeholder}
            class="w-full bg-transparent text-xl font-bold text-gray-800 placeholder-gray-400 focus:outline-none"
            autocomplete="off"
            aria-label="Makale ve rehberlerde ara"
            aria-describedby="search-results-label" />

          <!-- Clear button -->
          <button
            id="search-clear"
            class="text-gray-400 hover:text-primary-600 transition-colors hidden"
            aria-label="Temizle">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>

      <!-- Search Results Area -->
      <div id="search-results"
           class="max-h-[65vh] overflow-y-auto bg-white/30 backdrop-blur-md"
           role="region"
           aria-live="polite"
           aria-label="Arama sonuçları">

        <!-- Loading state -->
        <div id="search-loading"
             class="p-12 text-center text-gray-500 hidden">
          <div class="inline-block w-8 h-8 border-4 border-primary-200 border-t-primary-600 rounded-full animate-spin mb-4"></div>
          <p class="font-bold tracking-tight">Aranıyor...</p>
        </div>

        <!-- Initial state -->
        <div id="search-initial"
             class="p-12 text-center text-gray-400">
           <div class="w-20 h-20 bg-primary-50 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="material-symbols-outlined text-primary-300 text-5xl">search</span>
           </div>
          <p class="font-extrabold text-gray-900 mb-2">Nasıl yardımcı olabiliriz?</p>
          <p class="text-sm max-w-xs mx-auto">Tanı süreçleri, tedavi protokolleri veya makaleler arasında arama yapın.</p>
        </div>

        <!-- Results list -->
        <ul id="search-results-list" class="p-4 space-y-2"></ul>

        <!-- No results -->
        <div id="search-no-results"
             class="p-12 text-center text-gray-500 hidden">
          <span class="material-symbols-outlined text-6xl block mb-4 opacity-20">sentiment_neutral</span>
          <p class="font-extrabold text-gray-900">Aradığınızı bulamadık</p>
          <p class="text-sm mt-2">Daha genel terimler kullanmayı deneyin (örn: "tüp bebek", "rezerv").</p>
        </div>
      </div>

      <!-- Footer Help -->
      <div class="px-6 py-4 bg-gray-50/80 backdrop-blur-sm border-t border-gray-100 flex items-center justify-between">
        <span id="search-count" class="text-xs font-bold text-gray-400 uppercase tracking-widest hidden">
          Bulunan: <span class="text-primary-600">0</span> sonuç
        </span>
        <div class="ml-auto flex items-center gap-3">
          <div class="flex items-center gap-1.5 px-2.5 py-1 bg-white border border-gray-200 rounded shadow-sm text-[10px] font-bold text-gray-500">
             <span class="material-symbols-outlined text-[14px]">keyboard_return</span>
             Seç
          </div>
          <div class="flex items-center gap-1.5 px-2.5 py-1 bg-white border border-gray-200 rounded shadow-sm text-[10px] font-bold text-gray-500">
             <kbd class="tracking-tighter">ESC</kbd>
             Kapat
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #search-results {
    scroll-behavior: smooth;
  }

  .search-highlight {
    background-color: rgba(53, 97, 143, 0.15);
    color: #35618f;
    font-weight: 800;
    padding: 0 2px;
    border-radius: 2px;
  }

  .search-result-item {
    opacity: 0;
    transform: translateY(10px);
    animation: slideInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #search-modal.modal-active .glass-card {
    transform: scale(1);
    opacity: 1;
  }
</style>

<script define:vars={{ maxResults, fallbackData }}>
  let pagefind = null;
  let searchTimeout;
  const debounceDelay = 200;

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const clearBtn = document.getElementById('search-clear');
  const resultsList = document.getElementById('search-results-list');
  const initialState = document.getElementById('search-initial');
  const loadingState = document.getElementById('search-loading');
  const noResults = document.getElementById('search-no-results');
  const searchCount = document.getElementById('search-count');
  const resultsContainer = document.getElementById('search-results');

  // Load Pagefind on first use
  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      return pagefind;
    } catch (e) {
      console.warn('Pagefind not available:', e);
      return null;
    }
  }

  // Open modal
  function openSearchModal() {
    modal?.classList.remove('hidden');
    setTimeout(() => {
      modal?.classList.remove('opacity-0', 'invisible');
      modal?.classList.add('modal-active');
      input?.focus();
    }, 10);
    loadPagefind(); // Preload
  }

  // Close modal
  function closeSearchModal() {
    modal?.classList.add('opacity-0', 'invisible');
    modal?.classList.remove('modal-active');
    setTimeout(() => modal?.classList.add('hidden'), 300);
    if (input) input.value = '';
    clearBtn?.classList.add('hidden');
    if (resultsList) resultsList.innerHTML = '';
    initialState?.classList.remove('hidden');
    noResults?.classList.add('hidden');
    searchCount?.classList.add('hidden');
  }

  // Expose globally for header buttons and backdrop click
  window.__openSearchModal = openSearchModal;
  window.__closeSearchModal = closeSearchModal;

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeSearchModal();
    }
  });

  // Ctrl+K / Cmd+K shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) {
        openSearchModal();
      } else {
        closeSearchModal();
      }
    }
  });

  // Clear button
  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    input?.focus();
    search('');
  });

  // Search on input
  input?.addEventListener('input', (e) => {
    const query = e.target.value;
    if (query) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => search(query), debounceDelay);
  });

  // Perform search via Pagefind
  async function search(query) {
    const trimmed = query.trim();

    if (!trimmed) {
      initialState?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      searchCount?.classList.add('hidden');
      loadingState?.classList.add('hidden');
      if (resultsList) resultsList.innerHTML = '';
      return;
    }

    initialState?.classList.add('hidden');
    noResults?.classList.add('hidden');
    loadingState?.classList.remove('hidden');

    const pf = await loadPagefind();
    let results = [];
    let count = 0;
    let pagefindOk = false;

    if (pf) {
      // Guard the Pagefind path: if search() ever rejects or hangs on a broken
      // asset fetch, we must NOT leave the spinner stuck on "Aranıyor...".
      // On any failure we fall through to the embedded fallback data below.
      try {
        const searchResult = await pf.search(trimmed);
        results = await Promise.all(
          searchResult.results.slice(0, maxResults).map(r => r.data())
        );
        count = searchResult.results.length;
        pagefindOk = true;
      } catch (e) {
        console.warn('Pagefind search failed, using fallback:', e);
      }
    }

    if (!pagefindOk) {
      const normalized = trimmed.toLowerCase();
      const filtered = fallbackData.filter((item) => {
        return item.title.toLowerCase().includes(normalized) ||
               (item.description && item.description.toLowerCase().includes(normalized)) ||
               (item.category && item.category.toLowerCase().includes(normalized));
      });
      count = filtered.length;
      results = filtered.slice(0, maxResults).map(item => ({
        url: item.url,
        meta: { title: item.title, category: item.category, image: item.image },
        excerpt: item.description,
      }));
    }

    loadingState?.classList.add('hidden');

    if (results.length === 0) {
      noResults?.classList.remove('hidden');
      searchCount?.classList.add('hidden');
      if (resultsList) resultsList.innerHTML = '';
    } else {
      noResults?.classList.add('hidden');
      searchCount?.classList.remove('hidden');
      const countSpan = searchCount?.querySelector('span');
      if (countSpan) countSpan.textContent = String(count);

      if (resultsList) {
        resultsList.innerHTML = results
          .map((result, index) => {
            const title = result.meta?.title || 'Makale';
            const excerpt = result.excerpt || '';
            // Guard: skip items with missing URL to avoid crawler-visible placeholder links.
            if (!result.url || typeof result.url !== 'string') return '';
            const safeUrl = escapeAttr(result.url);
            const category = result.filters?.category?.[0] || result.meta?.category || '';
            
            // Critical fix: Sanitize image URL from Pagefind metadata (removes stray category tags)
            const rawImage = result.meta?.image || '';
            const image = escapeAttr(rawImage.split(',')[0].trim());
            const safeTitle = escapeHtml(title);
            const safeExcerpt = escapeHtml(excerpt);
            const safeCategory = escapeHtml(category);
            
            const style = getCategoryStyle(category);
            const hrefAttr = 'hr' + 'ef';
            const srcAttr = 'sr' + 'c';
            const media = image
              ? '<div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0 shadow-sm border border-gray-100">' +
                  '<img ' + srcAttr + '="' + image + '" alt="' + safeTitle + '" class="w-full h-full object-cover group-hover/item:scale-105 transition-transform duration-300" loading="lazy" />' +
                '</div>'
              : '<div class="w-12 h-12 ' + style.bg + ' rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm border border-white transition-all group-hover/item:bg-white/20">' +
                  '<span class="material-symbols-outlined ' + style.color + ' group-hover/item:text-white transition-colors">' + style.icon + '</span>' +
                '</div>';
            const excerptHtml = excerpt
              ? '<p class="text-xs text-gray-500 mt-0.5 line-clamp-2 group-hover/item:text-white/80 transition-colors">' + safeExcerpt + '</p>'
              : '';
            const categoryHtml = category
              ? '<span class="inline-block text-[10px] font-semibold text-primary-600 mt-1 group-hover/item:text-white/70">' + safeCategory + '</span>'
              : '';

            return '<li class="search-result-item" style="animation-delay: ' + (index * 0.05) + 's">' +
              '<a ' + hrefAttr + '="' + safeUrl + '" class="block p-4 bg-white/40 border border-gray-100/50 rounded-2xl hover:bg-primary-600 hover:border-primary-200 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary-200 group/item">' +
                '<div class="flex items-center gap-4">' +
                  media +
                  '<div class="flex-1 min-w-0">' +
                    '<h3 class="font-bold text-gray-900 text-sm line-clamp-1 group-hover/item:text-white transition-colors">' + safeTitle + '</h3>' +
                    excerptHtml +
                    categoryHtml +
                  '</div>' +
                  '<span class="material-symbols-outlined text-gray-300 group-hover/item:text-white group-hover/item:translate-x-1 transition-all flex-shrink-0">arrow_forward_ios</span>' +
                '</div>' +
              '</a>' +
            '</li>';
          })
          .join('');
      }

      resultsContainer?.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // Helper: Get icon based on category
  function getCategoryStyle(cat) {
    if (!cat) return { icon: 'auto_stories', bg: 'bg-primary-50', color: 'text-primary-500' };
    cat = cat.toLowerCase();
    
    if (cat.includes('kadın')) return { icon: 'female', bg: 'bg-pink-50', color: 'text-pink-600' };
    if (cat.includes('erkek')) return { icon: 'male', bg: 'bg-blue-50', color: 'text-blue-600' };
    if (cat.includes('tedavi')) return { icon: 'medical_services', bg: 'bg-teal-50', color: 'text-teal-600' };
    if (cat.includes('embriyo')) return { icon: 'biotech', bg: 'bg-indigo-50', color: 'text-indigo-600' };
    if (cat.includes('tüp bebek')) return { icon: 'science', bg: 'bg-cyan-50', color: 'text-cyan-600' };
    if (cat.includes('genetik')) return { icon: 'genetics', bg: 'bg-purple-50', color: 'text-purple-600' };
    if (cat.includes('rehber')) return { icon: 'book', bg: 'bg-primary-50', color: 'text-primary-600' };
    
    return { icon: 'description', bg: 'bg-gray-50', color: 'text-gray-500' };
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function escapeAttr(value) {
    return escapeHtml(value);
  }

  // Keyboard navigation in results
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const trimmed = input.value.trim();
      if (trimmed) {
        window.location.href = `/makaleler?q=${encodeURIComponent(trimmed)}`;
      }
      return;
    }

    const items = resultsList?.querySelectorAll('a') || [];
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      items[0]?.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      items[items.length - 1]?.focus();
    }
  });

  resultsList?.addEventListener('keydown', (e) => {
    const items = Array.from(resultsList.querySelectorAll('a'));
    const current = document.activeElement;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const idx = items.indexOf(current);
      items[idx + 1]?.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const idx = items.indexOf(current);
      if (idx === 0) {
        input?.focus();
      } else {
        items[idx - 1]?.focus();
      }
    }
  });
</script>
