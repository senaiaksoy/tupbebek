---
// SearchAutocomplete.astro
// Pagefind-powered search with modal overlay UI
// Usage: <SearchAutocomplete />

export interface Props {
  placeholder?: string;
  maxResults?: number;
}

const {
  placeholder = 'Rehberlerde ara...',
  maxResults = 8
} = Astro.props;
---

<!-- Search Modal/Overlay -->
<div id="search-modal"
     class="hidden fixed inset-0 z-[1000] bg-black/50 backdrop-blur-sm
            transition-all duration-300 opacity-0 invisible"
     role="dialog"
     aria-modal="true"
     aria-label="Arama"
     onclick="if(event.target === this) window.__closeSearchModal?.()">

  <div class="relative h-full flex items-start justify-center pt-20">
    <!-- Search Container -->
    <div class="w-full max-w-2xl mx-4 glass-card rounded-3xl shadow-2xl overflow-hidden
                transform transition-all duration-500 scale-95 opacity-0 active-modal:scale-100 active-modal:opacity-100">

      <!-- Search Input Wrapper -->
      <div class="relative p-6 border-b border-gray-100/50 bg-white/40">
        <div class="relative flex items-center gap-4">
          <span class="text-primary-600 animate-pulse-soft">
            <span class="material-symbols-outlined text-3xl">search_spark</span>
          </span>
          <input
            id="search-input"
            type="search"
            placeholder={placeholder}
            class="w-full bg-transparent text-xl font-bold text-gray-800 placeholder-gray-400 focus:outline-none"
            autocomplete="off"
            aria-label="Makale ve rehberlerde ara"
            aria-describedby="search-results-label" />

          <!-- Clear button -->
          <button
            id="search-clear"
            class="text-gray-400 hover:text-primary-600 transition-colors hidden"
            aria-label="Temizle">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>

      <!-- Search Results Area -->
      <div id="search-results"
           class="max-h-[65vh] overflow-y-auto bg-white/30 backdrop-blur-md"
           role="region"
           aria-live="polite"
           aria-label="Arama sonuçları">

        <!-- Loading state -->
        <div id="search-loading"
             class="p-12 text-center text-gray-500 hidden">
          <div class="inline-block w-8 h-8 border-4 border-primary-200 border-t-primary-600 rounded-full animate-spin mb-4"></div>
          <p class="font-bold tracking-tight">Aranıyor...</p>
        </div>

        <!-- Initial state -->
        <div id="search-initial"
             class="p-12 text-center text-gray-400">
           <div class="w-20 h-20 bg-primary-50 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="material-symbols-outlined text-primary-300 text-5xl">manage_search</span>
           </div>
          <p class="font-extrabold text-gray-900 mb-2">Nasıl yardımcı olabiliriz?</p>
          <p class="text-sm max-w-xs mx-auto">Tanı süreçleri, tedavi protokolleri veya makaleler arasında arama yapın.</p>
        </div>

        <!-- Results list -->
        <ul id="search-results-list" class="p-4 space-y-2"></ul>

        <!-- No results -->
        <div id="search-no-results"
             class="p-12 text-center text-gray-500 hidden">
          <span class="material-symbols-outlined text-6xl block mb-4 opacity-20">sentiment_neutral</span>
          <p class="font-extrabold text-gray-900">Aradığınızı bulamadık</p>
          <p class="text-sm mt-2">Daha genel terimler kullanmayı deneyin (örn: "tüp bebek", "rezerv").</p>
        </div>
      </div>

      <!-- Footer Help -->
      <div class="px-6 py-4 bg-gray-50/80 backdrop-blur-sm border-t border-gray-100 flex items-center justify-between">
        <span id="search-count" class="text-xs font-bold text-gray-400 uppercase tracking-widest hidden">
          Bulunan: <span class="text-primary-600">0</span> sonuç
        </span>
        <div class="ml-auto flex items-center gap-3">
          <div class="flex items-center gap-1.5 px-2.5 py-1 bg-white border border-gray-200 rounded shadow-sm text-[10px] font-bold text-gray-500">
             <span class="material-symbols-outlined text-[14px]">keyboard_return</span>
             Seç
          </div>
          <div class="flex items-center gap-1.5 px-2.5 py-1 bg-white border border-gray-200 rounded shadow-sm text-[10px] font-bold text-gray-500">
             <kbd class="tracking-tighter">ESC</kbd>
             Kapat
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #search-results {
    scroll-behavior: smooth;
  }

  .search-highlight {
    background-color: rgba(53, 97, 143, 0.15);
    color: #35618f;
    font-weight: 800;
    padding: 0 2px;
    border-radius: 2px;
  }

  .search-result-item {
    opacity: 0;
    transform: translateY(10px);
    animation: slideInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #search-modal.modal-active .glass-card {
    transform: scale(1);
    opacity: 1;
  }
</style>

<script define:vars={{ maxResults }}>
  let pagefind = null;
  let searchTimeout;
  const debounceDelay = 200;

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const clearBtn = document.getElementById('search-clear');
  const resultsList = document.getElementById('search-results-list');
  const initialState = document.getElementById('search-initial');
  const loadingState = document.getElementById('search-loading');
  const noResults = document.getElementById('search-no-results');
  const searchCount = document.getElementById('search-count');
  const resultsContainer = document.getElementById('search-results');

  // Load Pagefind on first use
  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      return pagefind;
    } catch (e) {
      console.warn('Pagefind not available:', e);
      return null;
    }
  }

  // Open modal
  function openSearchModal() {
    modal?.classList.remove('hidden');
    setTimeout(() => {
      modal?.classList.remove('opacity-0', 'invisible');
      modal?.classList.add('modal-active');
      input?.focus();
    }, 10);
    loadPagefind(); // Preload
  }

  // Close modal
  function closeSearchModal() {
    modal?.classList.add('opacity-0', 'invisible');
    modal?.classList.remove('modal-active');
    setTimeout(() => modal?.classList.add('hidden'), 300);
    if (input) input.value = '';
    clearBtn?.classList.add('hidden');
    if (resultsList) resultsList.innerHTML = '';
    initialState?.classList.remove('hidden');
    noResults?.classList.add('hidden');
    searchCount?.classList.add('hidden');
  }

  // Expose globally for header buttons and backdrop click
  window.__openSearchModal = openSearchModal;
  window.__closeSearchModal = closeSearchModal;

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeSearchModal();
    }
  });

  // Ctrl+K / Cmd+K shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) {
        openSearchModal();
      } else {
        closeSearchModal();
      }
    }
  });

  // Clear button
  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    input?.focus();
    search('');
  });

  // Search on input
  input?.addEventListener('input', (e) => {
    const query = e.target.value;
    if (query) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => search(query), debounceDelay);
  });

  // Perform search via Pagefind
  async function search(query) {
    const trimmed = query.trim();

    if (!trimmed) {
      initialState?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      searchCount?.classList.add('hidden');
      loadingState?.classList.add('hidden');
      if (resultsList) resultsList.innerHTML = '';
      return;
    }

    initialState?.classList.add('hidden');
    noResults?.classList.add('hidden');
    loadingState?.classList.remove('hidden');

    const pf = await loadPagefind();
    if (!pf) {
      loadingState?.classList.add('hidden');
      noResults?.classList.remove('hidden');
      return;
    }

    const searchResult = await pf.search(trimmed);
    const results = await Promise.all(
      searchResult.results.slice(0, maxResults).map(r => r.data())
    );

    loadingState?.classList.add('hidden');

    if (results.length === 0) {
      noResults?.classList.remove('hidden');
      searchCount?.classList.add('hidden');
      if (resultsList) resultsList.innerHTML = '';
    } else {
      noResults?.classList.add('hidden');
      searchCount?.classList.remove('hidden');
      const countSpan = searchCount?.querySelector('span');
      if (countSpan) countSpan.textContent = String(searchResult.results.length);

      if (resultsList) {
        resultsList.innerHTML = results
          .map((result, index) => {
            const title = result.meta?.title || 'Makale';
            const excerpt = result.excerpt || '';
            const url = result.url || '#';
            const category = result.filters?.category?.[0] || result.meta?.category || '';
            const image = result.meta?.image || '';

            return `
              <li class="search-result-item" style="animation-delay: ${index * 0.05}s">
                <a href="${url}"
                   class="block p-4 bg-white/40 border border-gray-100/50 rounded-2xl
                          hover:bg-primary-600 hover:border-primary-200 transition-all duration-300
                          focus:outline-none focus:ring-2 focus:ring-primary-200 group/item">
                  <div class="flex items-center gap-4">
                    ${image ? `
                      <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0 border border-gray-100">
                        <img src="${image}" alt="" class="w-full h-full object-cover" loading="lazy" />
                      </div>
                    ` : `
                      <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center
                                  group-hover/item:bg-white/20 transition-colors flex-shrink-0">
                        <span class="material-symbols-outlined text-gray-400 group-hover/item:text-white">
                          ${getCategoryIcon(category)}
                        </span>
                      </div>
                    `}
                    <div class="flex-1 min-w-0">
                      <h3 class="font-bold text-gray-900 text-sm line-clamp-1 group-hover/item:text-white transition-colors">
                        ${title}
                      </h3>
                      ${excerpt ? `
                        <p class="text-xs text-gray-500 mt-0.5 line-clamp-2 group-hover/item:text-white/80 transition-colors">
                          ${excerpt}
                        </p>
                      ` : ''}
                      ${category ? `
                        <span class="inline-block text-[10px] font-semibold text-primary-600 mt-1 group-hover/item:text-white/70">
                          ${category}
                        </span>
                      ` : ''}
                    </div>
                    <span class="material-symbols-outlined text-gray-300 group-hover/item:text-white group-hover/item:translate-x-1 transition-all flex-shrink-0">
                      arrow_forward_ios
                    </span>
                  </div>
                </a>
              </li>
            `;
          })
          .join('');
      }

      resultsContainer?.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // Helper: Get icon based on category
  function getCategoryIcon(cat) {
    if (!cat) return 'description';
    cat = cat.toLowerCase();
    if (cat.includes('kadın')) return 'female';
    if (cat.includes('erkek')) return 'male';
    if (cat.includes('tedavi')) return 'medical_services';
    if (cat.includes('tüp bebek')) return 'science';
    if (cat.includes('genetik')) return 'genetics';
    return 'description';
  }

  // Keyboard navigation in results
  input?.addEventListener('keydown', (e) => {
    const items = resultsList?.querySelectorAll('a') || [];
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      items[0]?.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      items[items.length - 1]?.focus();
    }
  });

  resultsList?.addEventListener('keydown', (e) => {
    const items = Array.from(resultsList.querySelectorAll('a'));
    const current = document.activeElement;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const idx = items.indexOf(current);
      items[idx + 1]?.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const idx = items.indexOf(current);
      if (idx === 0) {
        input?.focus();
      } else {
        items[idx - 1]?.focus();
      }
    }
  });
</script>
