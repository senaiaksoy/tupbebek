---
import { EVIDENCE_GRADE_MAP, type RecommendationGrade } from '../data/evidenceGrades';
interface Props { grade: RecommendationGrade | 'mixed'; }
const { grade } = Astro.props;
// 'mixed': tek derece verilmeyen karma kanıtlı genel rehberler.
const activeGrade = grade === 'mixed' ? null : EVIDENCE_GRADE_MAP[grade];
const badgeColors = {
  A: 'bg-emerald-100 text-emerald-900',
  B: 'bg-sky-100 text-sky-900',
  C: 'bg-amber-100 text-amber-900',
  'D/E': 'bg-rose-100 text-rose-900',
  mixed: 'bg-gray-100 text-gray-800',
};
const label = activeGrade ? `${activeGrade.grade} · ${activeGrade.label}` : 'Karma kanıt';
const ariaLabel = activeGrade
  ? `Kanıt durumu: ${activeGrade.grade} · ${activeGrade.label}. ${activeGrade.strength}`
  : 'Kanıt durumu: Karma kanıt. Birden fazla kanıt düzeyi içeren genel rehber; kaynaklar ilgili iddianın yanında verilir';
---

<span class:list={['inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold', badgeColors[grade]]} aria-label={ariaLabel}>
  {label}
</span>
