---
const faqs = [
  {
    question: "Tüp bebek başarısını belirleyen en önemli etken nedir?",
    answer: "Kadın yaşı en belirleyici etkendir. Kişiselleştirilmiş protokol ve laboratuvar kalitesi de sonucu etkileyen başlıklardır."
  },
  {
    question: "Tedavi süreci ne kadar sürer?",
    answer: "Genellikle yumurta uyarımı ve toplama süreci 15-20 gün sürer. Embriyo transfer planına göre toplam süre değişebilir."
  },
  {
    question: "Hamilelik şansı yüzde kaç olur?",
    answer: "Oran; yaşa, infertilite nedenine ve klinik verilere göre değişir. Ayrıntılar için başarı oranları içeriğini inceleyebilirsiniz."
  }
];
---

<section id="home-faq" class="py-6 lg:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-8">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      <div class="lg:col-span-4">
        <span class="text-primary-600 font-label uppercase tracking-widest text-xs font-bold mb-4 block">SIKÇA SORULANLAR</span>
        <h2 class="text-4xl font-headline text-gray-900 mb-5 lg:mb-8">Öne Çıkan <br />Sorular</h2>
        <p class="text-gray-600 leading-relaxed mb-6 lg:mb-10">Sık sorulan konuları özet yanıtlarla bir araya getirdik.</p>
        <a href="/sss" class="inline-flex min-h-11 items-center gap-1.5 text-primary-600 text-sm font-semibold hover:gap-2.5 transition-all">
          SSS sayfasını inceleyin
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>

      <div class="lg:col-span-8 space-y-6">
        {faqs.map((faq) => (
          <details class="home-faq-item bg-gray-100 p-4 lg:p-8 rounded-3xl border border-gray-200 hover:border-primary-200 transition-all group">
            <summary class="flex min-h-11 cursor-pointer items-center gap-3 list-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <h3 class="text-base lg:text-lg font-bold text-gray-900 group-hover:text-primary-600 transition-colors flex items-center gap-3 flex-1">
              <span class="material-symbols-outlined text-primary-600 scale-75">help</span> {faq.question}
            </h3>
            <span class="text-xl text-primary-700 group-open:rotate-45 transition-transform lg:hidden" aria-hidden="true">+</span>
            </summary>
            <p class="text-gray-600 leading-relaxed mt-4">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const desktop = window.matchMedia('(min-width: 1024px)');
  const setFaqState = () => document.querySelectorAll<HTMLDetailsElement>('.home-faq-item').forEach(item => { item.open = desktop.matches; });
  setFaqState();
  desktop.addEventListener('change', setFaqState);
</script>
