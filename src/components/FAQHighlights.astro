---
const faqs = [
  {
    question: "Tup bebek basarisini belirleyen en onemli etken nedir?",
    answer: "Kadin yasi en belirleyici etkendir. Kisisellestirilmis protokol ve laboratuvar kalitesi de sonucu etkileyen basliklardir."
  },
  {
    question: "Tedavi sureci ne kadar surer?",
    answer: "Genellikle yumurta uyarimi ve toplama sureci 15-20 gun surer. Embriyo transfer planina gore toplam sure degisebilir."
  },
  {
    question: "Hamilelik sansi yuzde kac olur?",
    answer: "Oran; yasa, infertilite nedenine ve klinik verilere gore degisir. Ayrintilar icin basari oranlari icerigini inceleyebilirsiniz."
  }
];
---

<section class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-8">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-4">
        <span class="text-primary-600 font-label uppercase tracking-widest text-xs font-bold mb-4 block">SIKCA SORULANLAR</span>
        <h2 class="text-4xl font-headline text-gray-900 mb-8">One Cikan <br />Sorular</h2>
        <p class="text-gray-600 leading-relaxed mb-10">Sik sorulan konulari ozet yanitlarla bir araya getirdik.</p>
        <a href="/sss" class="inline-flex items-center gap-1.5 text-primary-600 text-sm font-semibold hover:gap-2.5 transition-all">
          SSS sayfasini inceleyin
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>

      <div class="lg:col-span-8 space-y-6">
        {faqs.map((faq) => (
          <div class="bg-gray-100 p-8 rounded-3xl border border-gray-200 hover:border-primary-200 transition-all group">
            <h3 class="text-lg font-bold text-gray-900 mb-4 group-hover:text-primary-600 transition-colors flex items-center gap-3">
              <span class="material-symbols-outlined text-primary-600 scale-75">help</span> {faq.question}
            </h3>
            <p class="text-gray-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
