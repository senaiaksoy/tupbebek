---
/**
 * TableOfContents — build sirasinda makale H2 basliklarindan uretilen TOC.
 *
 * Linkler istemci JavaScript'i beklemeden HTML'de bulunur. Govdesinde kendi
 * "Icındekiler" bolumu olan legacy makalelerde ikinci bir TOC uretilmez.
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  variant?: 'desktop' | 'mobile';
}

const { headings = [], variant = 'desktop' } = Astro.props;
const normalizeHeading = (value: string) =>
  value.normalize('NFKC').trim().toLocaleLowerCase('tr-TR');
const hasManualToc = headings.some(
  (heading) => heading.depth === 2 && normalizeHeading(heading.text) === 'içindekiler'
);
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 && normalizeHeading(heading.text) !== 'içindekiler'
);
const shouldRender = !hasManualToc && tocHeadings.length >= 4;
---

{shouldRender && variant === 'desktop' && (
  <nav class="hidden lg:block" aria-label="İçindekiler">
    <div class="border-l-2 border-gray-200 pl-4">
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-gray-400">İçindekiler</p>
      <ol class="space-y-2">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class="block text-xs font-semibold leading-relaxed text-gray-600 transition-colors hover:text-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

{shouldRender && variant === 'mobile' && (
  <details class="mb-8 rounded-xl border border-gray-200 bg-white p-4 lg:hidden">
    <summary class="min-h-[44px] cursor-pointer py-2 text-sm font-bold text-gray-800 marker:text-primary-600">
      İçindekiler
    </summary>
    <ol class="mt-2 space-y-2 border-t border-gray-100 pt-3">
      {tocHeadings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="block min-h-[44px] py-2 text-sm font-semibold leading-relaxed text-gray-600 hover:text-primary-700"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </details>
)}
