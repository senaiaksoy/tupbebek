        type: "PostalAddress",
        streetAddress: "Lotus Nişantaşı, Halaskargazi Cd. No: 38-66, Kat 5, Office 92",
        addressLocality: "Şişli",
        addressRegion: "İstanbul",
        postalCode: "34371",
        addressCountry: "TR"
      },
      contactPoint: {
