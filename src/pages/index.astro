---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import TransitionStages from '../components/home/TransitionStages.astro';
import ArticleGrid from '../components/home/ArticleGrid.astro';
import SymptomGuide from '../components/home/SymptomGuide.astro';
import ExpertBoard from '../components/home/ExpertBoard.astro';
import Methodology from '../components/home/Methodology.astro';
import Footer from '../components/home/Footer.astro';
---

<BaseLayout
  title="tupbebek.com | Üreme Sağlığı Bilgi Portalı"
  description="Tüp bebek (IVF), infertilite nedenleri, tanı süreci ve tedavi yöntemleri hakkında bilimsel ve güncel bilgiler."
>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <TransitionStages />
    <ArticleGrid />
    <SymptomGuide />
    <ExpertBoard />
    <Methodology />
  </main>

  <Footer />
</BaseLayout>
