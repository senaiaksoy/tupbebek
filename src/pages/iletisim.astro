---
import Map from "@components/Map.astro";
import Title from "@components/Title.astro";
import Icon from "@icons/index.astro";
import Layout from "@layouts/Layout.astro";
import { contact } from "../data/index.json";

import styles from "@styles/article.module.scss";

const phoneNumber = contact.phone;
const whatsAppNumber = phoneNumber.replace(/\s/g, "");
const whatsappMessage = contact.whatsappMessage;
const email = contact.email;
---

<Layout
  title="Bize Ulaşın"
  description="Tedavinize hemen başlamak, randevu veya fiyat bilgisi almak için bize ulaşın."
>
  <article class={styles.article}>
    <header class={styles.header}>
      <Title size="large">İletişim</Title>
    </header>

    <div class="contact-online">
      <div>
        <div class="icon whatsapp">
          <Icon name="whatsapp" size="big" />
        </div>

        <Title size="small">
          Direkt arayın veya WhatsApp'dan mesaj yazın:
        </Title>

        <a
          href={`https://api.whatsapp.com/send?phone=${whatsAppNumber}&text=${whatsappMessage}`}
        >
          {phoneNumber}
        </a>
      </div>

      <div>
        <div class="icon">
          <Icon name="envelope" size="big" />
        </div>
        <Title size="small"
          >Düşüncelerinizi paylaşmak veya diğer talepleriniz için:</Title
        >

        <a href={`mailto: ${email}`}>{email}</a>
      </div>
    </div>

    <p>
      Sorularınızı yanıtlamak, ve her konuda sizlere yardımcı olmak için
      sabırsızlanıyoruz.
    </p>
    <p></p>
    <Title size="small"> Tüp bebek merkezimizi ziyaret edin: </Title>
    <p>
      Abdi İpekçi Caddesi Reassürans Han 2 No: 61 / Kat: 5 Nişantaşı / İstanbul
      / Türkiye
    </p>
    <p></p>
    <Map />
  </article>
</Layout>

<style lang="scss">
  .contact-online {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-medium);
    grid-template-rows: 48px 1fr max-content;
    border: 1px solid var(--color-gray-10);
    border-radius: 4px;
    padding: var(--spacing-medium);

    & > div {
      grid-row: span 3;
      display: grid;
      gap: var(--spacing-medium);
      grid-template-rows: subgrid;
    }

    .icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background-color: #222;
      color: #fff;

      &.whatsapp {
        background-color: #4dc247;
      }
    }
  }
</style>
