---
import { safeJsonLdStringify } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="30 Günlük Tüp Bebek Beslenme Planı | Bilgilendirici E-Kitap" description="Doç. Dr. Senai Aksoy'un hazırladığı tüp bebek beslenme e-kitabı: Akdeniz tipi beslenmeye dayalı 30 günlük örnek menü, folik asit ve vitamin rehberi, bilimsel kaynaklar." image="/e-kitap/images/cover-1200.webp" imageSrcSet="/e-kitap/images/cover-480.webp 480w, /e-kitap/images/cover-768.webp 768w, /e-kitap/images/cover-1200.webp 1200w, /e-kitap/images/cover-1600.webp 1600w" imageSizes="(min-width: 1024px) 560px, (min-width: 768px) 700px, 100vw">
    <Header />
    <main id="main-content" tabindex="-1">

        <!-- Hero Section -->
        <section class="bg-gradient-to-br from-primary-50 via-mint-50 to-white py-10 md:py-14">
            <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 lg:gap-10 items-start">

                    <!-- Header: H1 + intro. Mobile order 1, desktop spans both columns above the fold. -->
                    <div class="order-1 lg:col-span-2 lg:row-start-1">
                        <span class="text-mint-600 font-label uppercase tracking-ultra text-xs font-bold mb-3 block">
                            📚 BİLGİLENDİRİCİ E-KİTAP
                        </span>
                        <h1 class="text-3xl lg:text-4xl font-headline text-gray-900 leading-tight mb-4">
                            30 Günlük Tüp Bebek Beslenme Planı
                        </h1>
                        <p class="text-base text-gray-700 leading-relaxed lg:max-w-3xl">
                            Doç. Dr. Senai Aksoy tarafından hazırlanan, Akdeniz tipi beslenmeye dayalı ve tedavi dönemlerine göre düzenlenmiş örnek beslenme rehberi. Tüp bebek sürecinin her döneminde dengeli beslenmeyi günlük menülere nasıl çevirebileceğinizi ve bilimsel çalışmaların neyi gösterip neyi göstermediğini okuyun.
                        </p>
                    </div>

                    <!-- Body (cover + benefits + author). Mobile order 3 (below the form), desktop col-1 row-2. -->
                    <div class="order-3 lg:order-2 lg:col-start-1 lg:row-start-2">

                        <!-- Book Cover Image -->
                        <div class="mb-6 rounded-2xl overflow-hidden shadow-lg border border-gray-200">
                            <picture>
                                <source
                                    type="image/webp"
                                    srcset="/e-kitap/images/cover-480.webp 480w, /e-kitap/images/cover-768.webp 768w, /e-kitap/images/cover-1200.webp 1200w, /e-kitap/images/cover-1600.webp 1600w"
                                    sizes="(min-width: 1024px) 560px, (min-width: 768px) 700px, 100vw"
                                />
                                <img
                                    src="/e-kitap/images/cover-1200.jpg"
                                    alt="30 Günlük Tüp Bebek Beslenme Planı - E-Kitap Kapağı"
                                    class="w-full h-auto"
                                    width="1200"
                                    height="655"
                                    loading="eager"
                                    fetchpriority="high"
                                    decoding="async"
                                />
                            </picture>
                        </div>

                        <!-- Benefits List -->
                        <div class="space-y-3 mb-6">
                            <div class="flex gap-3 items-start">
                                <span class="text-mint-600 text-lg mt-0.5">✓</span>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Tedavi Dönemlerine Göre 4 Bölüm</h4>
                                    <p class="text-xs text-gray-600">Hazırlık, yumurtalıkların uyarılması, transfer öncesi ve transfer sonrası dönem</p>
                                </div>
                            </div>
                            <div class="flex gap-3 items-start">
                                <span class="text-mint-600 text-lg mt-0.5">✓</span>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">30 Günlük Örnek Menü</h4>
                                    <p class="text-xs text-gray-600">Her gün için kahvaltıdan akşam yemeğine beş öğünlük örnek; kendi tedavi takviminize göre kaydırılabilir</p>
                                </div>
                            </div>
                            <div class="flex gap-3 items-start">
                                <span class="text-mint-600 text-lg mt-0.5">✓</span>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Besin ve Vitamin Rehberi</h4>
                                    <p class="text-xs text-gray-600">Folik asit takviyesi, D vitamini ve besin kaynakları</p>
                                </div>
                            </div>
                            <div class="flex gap-3 items-start">
                                <span class="text-mint-600 text-lg mt-0.5">✓</span>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Akdeniz Tipi Beslenme Temelli</h4>
                                    <p class="text-xs text-gray-600">Tüp bebek sonuçlarıyla ilişkisi en çok çalışılmış beslenme düzeni ve çalışmaların gerçekte ne bulduğu</p>
                                </div>
                            </div>
                            <div class="flex gap-3 items-start">
                                <span class="text-mint-600 text-lg mt-0.5">✓</span>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Pratik Tarifler ve Kaynaklar</h4>
                                    <p class="text-xs text-gray-600">Kolay hazırlanan tarifler ve metin içinde atıf yapılan 16 bilimsel kaynak</p>
                                </div>
                            </div>
                        </div>

                        <!-- Author Credit -->
                        <div class="bg-white rounded-2xl p-4 border border-gray-200">
                            <div class="flex gap-3">
                                <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center flex-shrink-0">
                                    <span class="text-xl">👨‍⚕️</span>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-gray-900 text-sm">Doç. Dr. Senai Aksoy</h4>
                                    <p class="text-xs text-gray-600">Kadın Hastalıkları ve Doğum Uzmanı</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Üreme Tıbbı ve Yardımcı Üreme Teknikleri</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Form. Mobile order 2 (right under the header — above the fold), desktop col-2 row-2 sticky. -->
                    <div class="order-2 lg:order-3 lg:col-start-2 lg:row-start-2 lg:sticky lg:top-24">
                        <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 border border-gray-200">
                            <h2 class="text-xl font-headline text-gray-900 mb-1">E-Kitabı İndir</h2>
                            <p class="text-gray-600 mb-5 text-sm">Bilgi formunu doldurarak PDF'i hemen indirebilirsiniz</p>

                            <form id="ebook-form" class="space-y-4">
                                <!-- Ad Soyad -->
                                <div>
                                    <label for="fullname" class="block text-sm font-semibold text-gray-900 mb-2">
                                        Ad Soyadı <span class="text-red-500">*</span>
                                    </label>
                                    <input
                                        type="text"
                                        id="fullname"
                                        name="fullname"
                                        required
                                        placeholder="Adınız soyadınız"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-mint-600 focus:border-transparent outline-none text-gray-900 placeholder-gray-500"
                                    />
                                </div>

                                <!-- Email -->
                                <div>
                                    <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
                                        E-posta Adresiniz <span class="text-red-500">*</span>
                                    </label>
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        required
                                        placeholder="ornek@email.com"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-mint-600 focus:border-transparent outline-none text-gray-900 placeholder-gray-500"
                                    />
                                </div>

                                <!-- Harita Durumu -->
                                <div>
                                    <label for="status" class="block text-sm font-semibold text-gray-900 mb-2">
                                        Tedavi Durumunuz
                                    </label>
                                    <select
                                        id="status"
                                        name="status"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-mint-600 focus:border-transparent outline-none text-gray-900"
                                    >
                                        <option value="">Seçiniz</option>
                                        <option value="planning">Tedavi planlaması yapıyorum</option>
                                        <option value="preparation">Tedaviye hazırlanıyorum</option>
                                        <option value="ongoing">Tedavi devam ediyor</option>
                                        <option value="support">Destek arıyorum</option>
                                    </select>
                                </div>

                                <!-- KVKK Checkbox -->
                                <div class="pt-2">
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input
                                            type="checkbox"
                                            id="kvkk"
                                            name="kvkk"
                                            required
                                            class="w-5 h-5 rounded border-gray-300 text-mint-600 mt-0.5"
                                        />
                                        <span class="text-xs text-gray-600 leading-relaxed">
                                            <a href="/gizlilik-politikasi" class="text-mint-600 hover:underline font-semibold">Gizlilik Politikası ve KVKK Aydınlatma Metni</a>'ni okudum. Formdaki bilgilerim yalnızca e-kitabın gönderilmesi için işlenecektir. <span class="text-red-500">*</span>
                                        </span>
                                    </label>
                                </div>

                                <!-- İsteğe bağlı bilgilendirme izni -->
                                <div>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input
                                            type="checkbox"
                                            id="bilgilendirme"
                                            name="bilgilendirme"
                                            class="w-5 h-5 rounded border-gray-300 text-mint-600 mt-0.5"
                                        />
                                        <span class="text-xs text-gray-600 leading-relaxed">
                                            tupbebek.com'dan e-posta ile bilgilendirme mesajları almak istiyorum. (İsteğe bağlı; bilgi@tupbebek.com adresine yazarak istediğiniz zaman vazgeçebilirsiniz.)
                                        </span>
                                    </label>
                                </div>

                                <!-- Submit Button -->
                                <button
                                    type="submit"
                                    id="download-btn"
                                    class="w-full bg-mint-600 hover:bg-mint-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300 flex items-center justify-center gap-2 text-base mt-4"
                                >
                                    <span>📥 E-Kitabı İndir (PDF)</span>
                                </button>

                                <!-- Loading State -->
                                <div id="loading-message" style="display:none;" class="text-center text-mint-600 text-sm font-semibold">
                                    E-kitap hazırlanıyor...
                                </div>

                                <!-- Success Message -->
                                <div id="success-message" style="display:none;" class="bg-mint-50 border border-mint-300 rounded-lg p-4 text-mint-900 text-sm">
                                    ✓ Teşekkürler! E-kitap indiriliyor. Ayrıca e-postanıza indir bağlantısı gönderildi.
                                </div>
                            </form>

                            <!-- Trust Badge -->
                            <div class="mt-5 pt-5 border-t border-gray-200">
                                <p class="text-xs text-gray-500 text-center">
                                    🔒 Verileriniz güvenli, hiçbir ücret talep edilmez
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Content Section -->
        <section class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <!-- Content Preview 1 -->
                <div class="bg-gradient-to-br from-mint-50 to-mint-100 rounded-2xl p-6">
                    <div class="text-3xl mb-3">📋</div>
                    <h3 class="text-xl font-headline text-gray-900 mb-3">Faz 1: Hazırlık Dönemi</h3>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        İşlenmiş gıdayı azaltıp sebze, tam tahıl, baklagil ve balığa ağırlık veren düzene geçiş. Folik asit, alkol ve kafein için kaynaklı öneriler.
                    </p>
                </div>

                <!-- Content Preview 2 -->
                <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl p-6">
                    <div class="text-3xl mb-3">🔄</div>
                    <h3 class="text-xl font-headline text-gray-900 mb-3">Faz 2 ve 3: Uyarım ve Transfer Öncesi</h3>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Düzenli öğünler, her öğünde bir protein kaynağı ve demirle C vitamininin birlikte tüketilmesi. Sıvı tüketiminde tedavi ekibinizin önerisi önceliklidir.
                    </p>
                </div>

                <!-- Content Preview 3 -->
                <div class="bg-gradient-to-br from-apricot-50 to-apricot-100 rounded-2xl p-6">
                    <div class="text-3xl mb-3">🌱</div>
                    <h3 class="text-xl font-headline text-gray-900 mb-3">Faz 4: Transfer Sonrası Bekleyiş</h3>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Özel bir tutunma diyeti olmadığını, gebelikte kaçınılması gereken gıdaları ve ananas gibi sık duyulan inanışların kanıtla ne kadar örtüştüğünü anlatır.
                    </p>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="bg-gray-50 py-12">
            <div class="max-w-4xl mx-auto px-4 md:px-6 lg:px-8">
                <h2 class="text-2xl font-headline text-center text-gray-900 mb-8">Sık Sorulan Sorular</h2>

                <div class="space-y-4">
                    <details class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow group">
                        <summary class="flex min-h-11 cursor-pointer items-center justify-between rounded-xl p-6 group-open:pb-4 font-semibold text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                            <span>E-kitaba erişim koşulu nedir?</span>
                            <span class="group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-gray-700 px-6 pb-6 text-sm leading-relaxed">
                            E-kitap bilgilendirme amacıyla paylaşılır. Herhangi bir ücret talep edilmez. E-postanız e-kitabın gönderilmesi için, ayrıca yalnızca izin verirseniz bilgilendirme mesajları için kullanılır.
                        </p>
                    </details>

                    <details class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow group">
                        <summary class="flex min-h-11 cursor-pointer items-center justify-between rounded-xl p-6 group-open:pb-4 font-semibold text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                            <span>Verilerim nasıl kullanılacak?</span>
                            <span class="group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-gray-700 px-6 pb-6 text-sm leading-relaxed">
                            E-postanız, e-kitabın indirme bağlantısını göndermek için kullanılır. Formda ayrıca izin verdiyseniz ileride bilgilendirme mesajları da gönderilebilir. Adresiniz satılmaz ve reklam amacıyla başkalarıyla paylaşılmaz; yalnızca e-posta gönderimi gibi teknik hizmetler için hizmet sağlayıcılarımızca işlenir. Ayrıntılar için <a href="/gizlilik-politikasi" class="text-mint-600 hover:underline font-semibold">Gizlilik Politikası</a>'nı okuyabilirsiniz.
                        </p>
                    </details>

                    <details class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow group">
                        <summary class="flex min-h-11 cursor-pointer items-center justify-between rounded-xl p-6 group-open:pb-4 font-semibold text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                            <span>PDF'i her zaman indirebilir miyim?</span>
                            <span class="group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-gray-700 px-6 pb-6 text-sm leading-relaxed">
                            Evet. İndirme linki e-postanıza gönderilecek ve bu sayfadan istediğiniz zaman yeniden indirebilirsiniz.
                        </p>
                    </details>

                    <details class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow group">
                        <summary class="flex min-h-11 cursor-pointer items-center justify-between rounded-xl p-6 group-open:pb-4 font-semibold text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                            <span>Tüp bebek haricinde de uygulanabilir mi?</span>
                            <span class="group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <p class="text-gray-700 px-6 pb-6 text-sm leading-relaxed">
                            E-kitap tüp bebek (IVF) tedavisinin dönemlerine göre düzenlenmiştir. İçindeki Akdeniz tipi dengeli beslenme ilkeleri doğal yoldan gebelik planlayanlar için de kullanılabilir; özel bir sağlık durumunuz varsa önce hekiminize danışın.
                        </p>
                    </details>
                </div>
            </div>
        </section>

    </main>
    <Footer />
</BaseLayout>

<script>
    // Form submission
    const getElement = <T extends HTMLElement>(id: string): T => {
        const element = document.getElementById(id);
        if (!element) throw new Error(`Eksik form elementi: ${id}`);
        return element as T;
    };

    const form = getElement<HTMLFormElement>('ebook-form');
    const loadingMessage = getElement<HTMLElement>('loading-message');
    const successMessage = getElement<HTMLElement>('success-message');
    const downloadButton = getElement<HTMLButtonElement>('download-btn');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const fullname = getElement<HTMLInputElement>('fullname').value;
        const email = getElement<HTMLInputElement>('email').value;
        const status = getElement<HTMLSelectElement>('status').value || '';
        const kvkk = getElement<HTMLInputElement>('kvkk').checked;
        const bilgilendirmeIzni = getElement<HTMLInputElement>('bilgilendirme').checked;

        if (!kvkk) {
            alert('Lütfen Aydınlatma Metni onay kutusunu işaretleyiniz');
            return;
        }

        // Loading göster
        loadingMessage.style.display = 'block';
        downloadButton.disabled = true;

        try {
            // İndirme işlemini kaydet ve e-posta gönder (arka planda)
            try {
                await fetch('/api/ebook-subscribe/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fullname, email, status, bilgilendirmeIzni })
                });
            } catch (err) {
                console.log('Sunucuya kaydedilemedi, ancak indirme devam ediyor.');
            }

            // Statik PDF i doğrudan indir (cache-bust ile)
            const pdfUrl = '/e-kitap/tup-bebek-beslenme-plani.pdf?v=20261004';
            window.location.href = pdfUrl;

            // Success mesajı göster
            loadingMessage.style.display = 'none';
            successMessage.style.display = 'block';

            // Form temizle
            form.reset();

            // 5 saniye sonra success mesajını gizle
            setTimeout(() => {
                successMessage.style.display = 'none';
                downloadButton.disabled = false;
            }, 5000);

        } catch (error) {
            console.error('Hata:', error);
            alert('İndirme işlemi sırasında hata oluştu. Lütfen tekrar deneyiniz.');
            loadingMessage.style.display = 'none';
            downloadButton.disabled = false;
        }
    });
</script>
