---
import Head from "@components/Head.astro";
import Map from "@components/Map.astro";
import Title from "@components/Title.astro";
import Icon from "@icons/index.astro";
import Layout from "@layouts/Layout.astro";
import { contact } from "../data/index.json";

import styles from "@styles/article.module.scss";

const phoneNumber = contact.phone;
const whatsAppNumber = phoneNumber.replace(/\s/g, "");
const whatsappMessage = contact.whatsappMessage;
---

<Layout
  title="Contact Us"
  description="We're excited to assist and address all your needs!"
>
  <Head slot="head" slug="contact-us" />

  <article class={styles.article}>
    <header class={styles.header}>
      <Title size="large">Contact Us</Title>
    </header>

    <div class="contact-online">
      <div>
        <div class="icon whatsapp">
          <Icon name="whatsapp" size="big" />
        </div>

        <Title size="small">
          Reach out directly, give us a ring or leave a message:
        </Title>

        <a
          href={`https://api.whatsapp.com/send?phone=${whatsAppNumber}&text=${whatsappMessage}`}
        >
          {phoneNumber}
        </a>
      </div>

      <div>
        <div class="icon">
          <Icon name="envelope" size="big" />
        </div>
        <Title size="small">Share your thoughts and queries, write us:</Title>

        <a href="mailto: contact@artivfcenter.com">contact@artivfcenter.com</a>
      </div>
    </div>

    <p>We’re excited to assist and address all your needs!</p>
    <p></p>
    <Title size="small">
      Experience our clinic firsthand, drop by and visit us at:
    </Title>
    <p>
      Abdi Ipekci Caddesi Reassurans Han 2 No: 61 / Kat: 5 Nisantasi / Istanbul
      / Turkey
    </p>
    <p></p>
    <Map />
  </article>
</Layout>

<style lang="scss">
  .contact-online {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-medium);
    grid-template-rows: 48px 1fr max-content;
    border: 1px solid var(--color-gray-10);
    border-radius: 4px;
    padding: var(--spacing-medium);

    & > div {
      grid-row: span 3;
      display: grid;
      gap: var(--spacing-medium);
      grid-template-rows: subgrid;
    }

    .icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background-color: #222;
      color: #fff;

      &.whatsapp {
        background-color: #4dc247;
      }
    }
  }
</style>
