---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReferenceList from '../components/ReferenceList.astro';

// Her kaynak PubMed üzerinden doğrulandı (Eylül 2026).
const references = [
    {
        title: "ESHRE guideline: ovarian stimulation for IVF/ICSI: an update in 2025",
        type: "guideline" as const,
        authors: "Ata B, Bosch E, Broer S et al. (ESHRE Guideline Group)",
        journal: "Human Reproduction",
        year: 2026,
        doi: "10.1093/humrep/deag018",
        pmid: "41732035"
    },
    {
        title: "ESHRE guideline: ovarian stimulation for IVF/ICSI",
        type: "guideline" as const,
        authors: "The ESHRE Guideline Group on Ovarian Stimulation, Bosch E, Broer S et al.",
        journal: "Human Reproduction Open",
        year: 2020,
        doi: "10.1093/hropen/hoaa009",
        pmid: "32395637"
    },
    {
        title: "Gonadotrophin-releasing hormone antagonists for assisted reproductive technology",
        type: "systematicReview" as const,
        authors: "Al-Inany HG, Youssef MA, Ayeleke RO et al.",
        journal: "Cochrane Database of Systematic Reviews",
        year: 2016,
        doi: "10.1002/14651858.CD001750.pub4",
        pmid: "27126581"
    },
    {
        title: "Gonadotropin-releasing hormone agonist versus HCG for oocyte triggering in antagonist-assisted reproductive technology",
        type: "systematicReview" as const,
        authors: "Youssef MA, Van der Veen F, Al-Inany HG et al.",
        journal: "Cochrane Database of Systematic Reviews",
        year: 2014,
        doi: "10.1002/14651858.CD008046.pub4",
        pmid: "25358904"
    },
    {
        title: "Recombinant versus urinary human chorionic gonadotrophin for final oocyte maturation triggering in IVF and ICSI cycles",
        type: "systematicReview" as const,
        authors: "Youssef MA, Abou-Setta AM, Lam WS",
        journal: "Cochrane Database of Systematic Reviews",
        year: 2016,
        doi: "10.1002/14651858.CD003719.pub4",
        pmid: "27106604"
    },
    {
        title: "Luteal phase support for assisted reproduction cycles",
        type: "systematicReview" as const,
        authors: "van der Linden M, Buckingham K, Farquhar C et al.",
        journal: "Cochrane Database of Systematic Reviews",
        year: 2015,
        doi: "10.1002/14651858.CD009154.pub3",
        pmid: "26148507"
    },
    {
        title: "Prevention and treatment of moderate and severe ovarian hyperstimulation syndrome: a guideline",
        type: "guideline" as const,
        authors: "Practice Committee of the American Society for Reproductive Medicine",
        journal: "Fertility and Sterility",
        year: 2016,
        doi: "10.1016/j.fertnstert.2016.08.048",
        pmid: "27678032"
    }
];
---

<BaseLayout title="İlaç Rehberi: IVF İlaçları, Dozajlar ve Yan Etkiler | tupbebek.com" description="IVF sürecinde kullanılan gonadotropinler, GnRH analogları, progesteron, hCG ve diğer ilaçların detaylı açıklamaları, yan etkileri ve kullanım talimatları.">
    <Header />

    <main id="main-content" tabindex="-1" class="pb-24">
        <!-- Hero Section -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-20">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        Tedavi Rehberi
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        IVF İlaç Rehberi: <span class="text-primary-600 italic">Kullanım, Dozaj</span> ve Yan Etkiler
                    </h1>
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border-l-4 border-primary">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                        </div>
                        <div>
                            <p class="font-headline italic text-gray-900 text-sm">İnceleme:</p>
                            <p class="font-bold text-primary-600">tupbebek.com Editöryal Ekip</p>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl">
                    <img class="w-full h-full object-cover" src="/images/library/tedavi/ilac-rehberi-hero.webp" alt="Hastane eczanesinde ilaç soğutma dolabını açıp raftaki kalemleri kontrol eden eczacı" width="1600" height="900" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <!-- Scientific Introduction -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-body italic mb-6">
                <strong class="not-italic text-gray-900">Kısa cevap:</strong> IVF'te ilaçlar dört iş görür: yumurtalıkları uyarmak, erken yumurtlamayı önlemek, yumurtaları son olgunluğa getirmek (tetik iğnesi) ve embriyo transferinden sonra rahim iç zarını desteklemek. Hangi ilacın hangi dozda kullanılacağına yaşınız, yumurtalık rezerviniz ve önceki yanıtınıza göre hekiminiz karar verir.
            </p>
            <p class="text-base text-gray-600 leading-relaxed mb-12">
                Bu rehber, ilaçlarınızı tanımanız, doğru uygulamanız ve hangi yan etkinin olağan, hangisinin acil olduğunu ayırt etmeniz için hazırlandı. Buradaki dozlar genel aralıklardır; kendi reçetenizin yerine geçmez.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">medication</span>
                    <h3 class="font-bold text-sm mb-2">4 ilaç grubu</h3>
                    <p class="text-xs text-gray-600 mb-0">Uyarım, baskılama, tetik, lüteal destek</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">science</span>
                    <h3 class="font-bold text-sm mb-2">Yaklaşık 9-12 gün</h3>
                    <p class="text-xs text-gray-600 mb-0">Tipik uyarım süresi (kişiye göre değişir)</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">biotech</span>
                    <h3 class="font-bold text-sm mb-2">Deri altı</h3>
                    <p class="text-xs text-gray-600 mb-0">İğnelerin çoğunun uygulama yolu</p>
                </div>
            </div>
        </section>

        <!-- Quick-Nav Bar -->
        <nav id="quick-nav" aria-label="Sayfa içi bölümler" class="sticky top-20 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm mb-16">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 overflow-x-auto whitespace-nowrap">
                <div class="flex items-center gap-1 py-3">
                    <a href="#gonadotropin" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Gonadotropinler</a>
                    <a href="#gnrh" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">GnRH Analogları</a>
                    <a href="#tetikleme" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Tetikleme</a>
                    <a href="#luteal" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Lüteal Desteği</a>
                    <a href="#enjeksiyon" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Enjeksiyon</a>
                </div>
            </div>
        </nav>

        <!-- Section 1: Gonadotropinler -->
        <section id="gonadotropin" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">1. Gonadotropinler (FSH, FSH+LH)</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                Gonadotropinler, yumurtalıkta birden fazla folikülün (yumurta kesesi) aynı anda büyümesini sağlayan uyarım ilaçlarıdır. İçlerinde FSH (folikül uyarıcı hormon) ve bazılarında LH (luteinize edici hormon) etkisi bulunur. Laboratuvarda üretilen (rekombinant) ve idrardan saflaştırılan (üriner) türleri vardır.
                            </p>
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                                <h3 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary-600">medication</span>
                                    Sık Kullanılan Gonadotropinler
                                </h3>
                                <div class="space-y-4 text-sm">
                                    <div class="border-b border-gray-200 pb-3">
                                        <p class="font-semibold text-gray-900 mb-1">Gonal-f, Puregon, Rekovelle (rekombinant FSH)</p>
                                        <p class="text-xs">Kalem şeklinde, deri altına uygulanır. Folikül büyümesi ultrason ve gerektiğinde kan hormonlarıyla izlenir.</p>
                                    </div>
                                    <div class="border-b border-gray-200 pb-3">
                                        <p class="font-semibold text-gray-900 mb-1">Menopur, Merional (hMG)</p>
                                        <p class="text-xs">İdrardan elde edilen, hem FSH hem LH etkisi taşıyan ilaç. Genel IVF grubunda rekombinant FSH ile benzer sonuç verir.<sup>[2]</sup></p>
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-900 mb-1">Fostimon (üriner FSH)</p>
                                        <p class="text-xs">İdrardan saflaştırılmış FSH. Seçim; ilacın bulunabilirliği ve hekimin protokolüne göre yapılır.</p>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-500 mt-4">Ticari adlar örnek amaçlıdır; Türkiye'de bulunabilirlik zamanla değişebilir.</p>
                            </div>
                            <p class="text-sm text-gray-600">
                                Başlangıç dozu yaş, vücut ağırlığı, AMH ve antral folikül sayısına göre belirlenir. Beklenen yanıtı normal olanlarda günlük 150-225 IU yeterlidir; düşük yanıt beklenenlerde bile 300 IU'nun üzerine çıkmanın ek yarar sağladığı gösterilmemiştir.<sup>[2]</sup> Yüksek yanıt beklenenlerde (örneğin polikistik over sendromu) daha düşük doz, aşırı uyarım riskini (OHSS) azaltmaya yardım eder.<sup>[2]</sup>
                            </p>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <div class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/tedavi/duo-stim.webp" alt="DuoStim şeması: aynı adet döngüsünde foliküler ve luteal fazda iki ayrı yumurtalık uyarımı ve yumurta toplama" width="512" height="512" loading="lazy"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 2: GnRH Analogları -->
        <section id="gnrh" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">2. GnRH Analogları</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            Bu ilaçlar, uyarım sırasında beynin erken bir LH dalgası göndermesini ve yumurtaların toplama gününden önce kendiliğinden çatlamasını önler. İki grubu vardır: agonistler önce kısa süreli bir hormon artışı (flare) yapar, sonra hipofizi baskılar; antagonistler ise saatler içinde doğrudan baskılar.<sup>[3]</sup>
                        </p>
                        <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h3 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">biotech</span>
                                Agonist ve Antagonist Karşılaştırması
                            </h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="border-b border-gray-200/20">
                                            <th scope="col" class="text-left py-2 pr-4 font-semibold text-gray-600">Özellik</th>
                                            <th scope="col" class="text-left py-2 pr-4 font-semibold text-gray-600">Agonist (uzun protokol)</th>
                                            <th scope="col" class="text-left py-2 pr-4 font-semibold text-gray-600">Antagonist</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="border-b border-gray-200">
                                            <td class="py-2 pr-4 font-semibold text-gray-900">Baskılama</td>
                                            <td class="py-2 pr-4 text-gray-600">Yavaş, yaklaşık 2 hafta</td>
                                            <td class="py-2 pr-4 text-gray-600">Hızlı, saatler içinde</td>
                                        </tr>
                                        <tr class="border-b border-gray-200">
                                            <td class="py-2 pr-4 font-semibold text-gray-900">Canlı doğum</td>
                                            <td class="py-2 pr-4 text-gray-600" colspan="2">Belirgin fark gösterilmemiş<sup>[3]</sup></td>
                                        </tr>
                                        <tr>
                                            <td class="py-2 pr-4 font-semibold text-gray-900">OHSS riski</td>
                                            <td class="py-2 pr-4 text-gray-600">Daha yüksek</td>
                                            <td class="py-2 pr-4 text-gray-600">Daha düşük<sup>[3]</sup></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="space-y-4 text-sm">
                            <p><strong>Agonistler:</strong> Lucrin, Decapeptyl, Suprefact. Günlük deri altı iğne ya da uzun etkili (depo) iğne olarak kullanılır. Uzun protokolde genellikle önceki adet döngüsünün ikinci yarısında başlanır.</p>
                            <p><strong>Antagonistler:</strong> Cetrotide, Orgalutran. Uyarımın ortasında, genellikle 5-6. günden itibaren eklenir ve tetik gününe kadar sürer. ESHRE, genel IVF grubunda benzer etkinlik ve daha yüksek güvenlik nedeniyle antagonist protokolünü önerir.<sup>[2]</sup></p>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <div class="relative group">
                        <img class="rounded-2xl shadow-xl w-full" src="/images/library/tedavi/prp.webp" alt="Danışma masasında boş haftalık çizelge üzerinden ilaç takvimini anlatan sakallı erkek hemşire; karşısında not alan hastanın elleri" width="1200" height="675" loading="lazy"/>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 3: Tetikleme -->
        <section id="tetikleme" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">3. Tetik İğnesi</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                Öncü foliküller yeterli büyüklüğe ulaştığında (çoğu merkezde birkaç folikülün 17-18 mm'yi geçmesi), yumurtaların son olgunlaşması için tetik iğnesi yapılır. Yumurta toplama genellikle bu iğneden 34-36 saat sonra planlanır. Bu yüzden tetik iğnesinin saati, tedavinin en önemli saatidir.
                            </p>
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                                <h3 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary-600">biotech</span>
                                    Tetik Seçenekleri
                                </h3>
                                <div class="space-y-4 text-sm">
                                    <div class="border-b border-gray-200 pb-3">
                                        <p class="font-semibold text-gray-900 mb-1">Ovitrelle (rekombinant hCG)</p>
                                        <p class="text-xs">Hazır kalem, standart doz 250 mikrogram, deri altına uygulanır.</p>
                                    </div>
                                    <div class="border-b border-gray-200 pb-3">
                                        <p class="font-semibold text-gray-900 mb-1">Pregnyl (üriner hCG)</p>
                                        <p class="text-xs">İdrardan elde edilen hCG. Rekombinant hCG ile gebelik ve OHSS oranları açısından fark gösterilmemiştir.<sup>[5]</sup></p>
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-900 mb-1">GnRH agonist tetik (ör. Decapeptyl, Lucrin)</p>
                                        <p class="text-xs">Yalnızca antagonist protokolünde kullanılabilir. OHSS riskini belirgin biçimde azaltır.<sup>[4]</sup></p>
                                    </div>
                                </div>
                            </div>
                            <p class="text-sm text-gray-600">
                                GnRH agonist tetik, taze transfer yapılacaksa ve lüteal destek güçlendirilmezse canlı doğum olasılığını düşürür.<sup>[4]</sup> Bu nedenle en çok OHSS riski yüksek olanlarda, tüm embriyoların dondurulacağı döngülerde, yumurta dondurma ve yumurta bağışında tercih edilir.
                            </p>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <figure>
                            <div class="relative group">
                                <img class="rounded-2xl shadow-xl w-full" src="/images/library/tedavi/tetikleme-zamanlamasi.webp" alt="Gece lambası ışığında komodinde küçük çalar saati ayarlayan el; yanında kapaklı enjeksiyon kalemi" width="1200" height="675" loading="lazy"/>
                                <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                    <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Zamanlama</p>
                                    <p class="text-2xl font-headline">34-36 saat</p>
                                    <p class="text-[11px] text-gray-600">Tetikten yumurta toplamaya</p>
                                </div>
                            </div>
                        </figure>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 4: Lüteal Faz Desteği -->
        <section id="luteal" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">4. Lüteal Faz Desteği (Progesteron)</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            IVF döngüsünde vücudun kendi progesteron üretimi çoğu zaman yetersiz kalır. Bu yüzden rahim iç zarını embriyoya hazırlamak için progesteron desteği verilir. Progesteronun, desteksiz döngüye göre gebelik sonuçlarını iyileştirdiği gösterilmiştir.<sup>[6]</sup>
                        </p>
                        <p>
                            Destek genellikle yumurta toplama gününün akşamı ile sonraki 3 gün arasında başlar ve en az gebelik testi gününe kadar sürer.<sup>[2]</sup> Test olumluysa birçok merkez desteği ilk 8-10 haftaya kadar sürdürür; ne kadar süre devam etmenin daha iyi olduğu konusunda kanıt sınırlıdır.
                        </p>
                        <div class="bg-gray-50 border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h3 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">biotech</span>
                                Progesteron Uygulama Yolları
                            </h3>
                            <div class="space-y-4 text-sm">
                                <div class="flex items-start gap-4">
                                    <span class="font-mono font-bold text-primary-600 shrink-0 w-20">Vajinal</span>
                                    <span class="text-gray-600">Jel (ör. Crinone) veya kapsül/fitil. En yaygın kullanılan yoldur.</span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-primary-600 shrink-0 w-20">Kas içi</span>
                                    <span class="text-gray-600">Yağlı progesteron iğnesi. Enjeksiyon yerinde ağrı ve sertlik yapabilir. Cochrane derlemesi, uygulama yolunun sonucu belirgin biçimde değiştirmediği sonucuna varmıştır.<sup>[6]</sup></span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-primary-600 shrink-0 w-20">Deri altı</span>
                                    <span class="text-gray-600">Suda çözünen progesteron iğnesi (ör. Prolutex). Vajinal jelle benzer sonuç bildirilmiştir.<sup>[6]</sup></span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-primary-600 shrink-0 w-20">Ağızdan</span>
                                    <span class="text-gray-600">Didrogesteron (ör. Duphaston). Bazı protokollerde tek başına ya da vajinal progesteronla birlikte kullanılır.</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-sm text-gray-600">
                            Östrojen (ör. Estrofem) progesteron değildir; daha çok dondurulmuş embriyo transferinde rahim iç zarını hazırlamak için kullanılır. Taze döngüde progesterona östrojen eklemenin ek yararı gösterilmemiştir.<sup>[6]</sup>
                        </p>
                        <p class="text-sm text-gray-600">
