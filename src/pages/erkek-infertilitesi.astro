---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatsStrip from '../components/StatsStrip.astro';
import RelatedContent from '../components/RelatedContent.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { buildHubItemListSchema } from '../utils/hubStructuredData';

const pageTitle = 'Erkek İnfertilitesi Rehberi | tupbebek.com';
const pageDescription = 'Erkek infertilitesi nedenleri, semen analizi, varikosel, azospermi, mikro-TESE, ICSI ve yaşam tarzı etkileri hakkında bilimsel rehber.';

const clusterLinks = [
  {
    href: '/makaleler/varikosel-nedir-ne-zaman-ameliyat-gerekir',
    icon: 'health_and_safety',
    title: 'Varikosel ne zaman önemlidir?',
    description: 'Palpabl varikosel, bozuk semen analizi ve çocuk isteği birlikte nasıl değerlendirilir?'
  },
  {
    href: '/makaleler/azospermi-mikro-tese',
    icon: 'biotech',
    title: 'Azospermi ve mikro-TESE',
    description: 'Sperm sayısı sıfır olduğunda OA/NOA ayrımı, genetik testler ve ICSI yolu.'
  },
  {
    href: '/makaleler/cerrahi-sperm-arama-tese',
    icon: 'science',
    title: 'Cerrahi sperm arama',
    description: 'TESA, TESE ve mikro-TESE seçeneklerinin hangi durumda gündeme geldiği.'
  },
  {
    href: '/makaleler/mikroenjeksiyon-icsi-nedir',
    icon: 'precision_manufacturing',
    title: 'Mikroenjeksiyon (ICSI)',
    description: 'Ciddi erkek faktöründe spermin yumurtaya tek tek enjekte edildiği laboratuvar tekniği.'
  },
  {
    href: '/makaleler/erkek-dogurganlik-besin-takviyeleri',
    icon: 'nutrition',
    title: 'Takviyeler ve yaşam tarzı',
    description: 'Antioksidanlar, beslenme, egzersiz ve üç aylık sperm üretim döngüsü.'
  },
  {
    href: '/makaleler/cep-telefonu-sperm-kalitesi',
    icon: 'phone_iphone',
    title: 'Telefon, ısı ve çevresel etkenler',
    description: 'Günlük alışkanlıkların sperm parametreleriyle olası ilişkileri.'
  },
  {
    href: '/makaleler/alkol-ve-fertilite',
    icon: 'local_bar',
    title: 'Alkol ve sperm kalitesi',
    description: 'Alkol tüketimi, hormonlar, sperm parametreleri ve IVF planı.'
  },
  {
    href: '/makaleler/izotretinoin-sperm',
    icon: 'medication',
    title: 'İzotretinoin ve sperm',
    description: 'Akne tedavisi, sperm parametreleri ve gebelik planı açısından dikkat noktaları.'
  }
];

const faqItems = [
  {
    q: 'Erkek infertilitesi değerlendirmesi hangi testle başlar?',
    a: 'İlk basamak genellikle semen analizidir. Sonuç tek başına kesin tanı koydurmaz; en az bir doğru alınmış örnek, tıbbi öykü, fizik muayene ve gerektiğinde hormon ya da genetik testlerle birlikte yorumlanır.'
  },
  {
    q: 'Varikosel her zaman ameliyat gerektirir mi?',
    a: 'Hayır. Kılavuzlar, özellikle ele gelen klinik varikosel, anormal semen parametreleri ve çocuk isteği birlikte olduğunda varikosel onarımının değerlendirilebileceğini belirtir. Sadece ultrasonla saptanan subklinik varikosel için rutin onarım önerilmez.'
  },
  {
    q: 'Azospermide sperm bulunamazsa tüp bebek imkansız mıdır?',
    a: 'Azospermi obstrüktif veya nonobstrüktif olabilir. Bazı olgularda cerrahi sperm arama yöntemleriyle sperm elde edilip ICSI sürecinde kullanılabilir; ancak olasılık kişisel tanıya, testis bulgularına ve genetik sonuçlara göre değişir.'
  },
  {
    q: 'Sperm kalitesi yaşam tarzıyla ne kadar sürede değişebilir?',
    a: 'Sperm üretim döngüsü yaklaşık 74 gün sürdüğü için sigara, alkol, kilo, ısı maruziyeti, uyku ve beslenme gibi düzenlemelerin etkisi genellikle birkaç ay içinde değerlendirilir.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://tupbebek.com/erkek-infertilitesi/#faqpage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};

const itemListSchema = buildHubItemListSchema({
  site: Astro.site,
  pagePath: '/erkek-infertilitesi/',
  name: 'Erkek infertilitesi konu haritası',
  description: 'Semen analizi, varikosel, azospermi, mikro-TESE, ICSI, yaşam tarzı, alkol, ilaç ve takviye başlıklarını bağlayan erkek infertilitesi okuma yolu.',
  items: clusterLinks
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <Header />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />

    <main id="main-content" tabindex="-1" class="pb-24">
        <!-- Hero Section -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-20">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">badge</span>
                        Klinik Rehber
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        Erkek İnfertilitesi: <span class="text-primary-600 italic">Nedenler</span> ve Tedavi Seçenekleri
                    </h1>
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border-l-4 border-primary">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200">
                            <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                        </div>
                        <div>
                            <p class="font-headline italic text-gray-900 text-sm">İnceleme:</p>
                            <p class="font-bold text-primary-600">Yayın Kurulu</p>
                            <p class="text-xs text-gray-500 mt-1">Son güncelleme: 11 Temmuz 2026</p>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl">
                    <img class="w-full h-full object-cover grayscale opacity-80" src="/images/library/hastalik/erkekinfertilite.webp" alt="Erkek infertilitesi" width="512" height="512" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <!-- Scientific Introduction -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-body italic mb-12">
                Erkek infertilitesi, infertilite yaşayan çiftlerin önemli bir bölümünde tek başına veya kadın faktörüyle birlikte rol oynayabilir. Doğru semen analizi, üroloji/androloji değerlendirmesi ve nedene yönelik planlama ile varikosel, hormonal sorunlar, azospermi ve ciddi sperm parametre bozuklukları daha net yönetilebilir.
            </p>
            <StatsStrip items={[
              { icon: 'man', heading: '~%50', text: 'Çift infertilitesinde erkek faktörü tek başına veya birlikte rol oynayabilir' },
              { icon: 'analytics', heading: 'WHO', text: 'Semen analizi standart yöntem ve referans aralıklarla yorumlanır' },
              { icon: 'science', heading: 'ICSI', text: 'Ciddi erkek faktöründe laboratuvar ve cerrahi seçenekler birlikte planlanır' }
            ]} />
        </section>

        <!-- Topic Cluster -->
        <section id="konu-haritasi" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <div class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-sm">
                <div class="max-w-3xl mb-8">
                    <span class="text-xs font-semibold uppercase tracking-wider text-primary-600">Konu Haritası</span>
                    <h2 class="font-headline text-3xl text-gray-900 mt-2 mb-4">Erkek infertilitesi için okuma yolu</h2>
                    <p class="text-gray-600 leading-relaxed">
                        Bu sayfa ana rehberdir. Tanı, varikosel, azospermi, cerrahi sperm arama, ICSI ve yaşam tarzı başlıklarını derinleştirmek için aşağıdaki alt rehberlere geçebilirsiniz.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {clusterLinks.map((item) => (
                        <a href={item.href} class="group rounded-2xl border border-gray-100 bg-gray-50 p-5 hover:border-primary-200 hover:bg-primary-50/40 transition-colors">
                            <span class="material-symbols-outlined text-primary-600 mb-3">{item.icon}</span>
                            <h3 class="font-bold text-gray-900 text-sm mb-2 group-hover:text-primary-700">{item.title}</h3>
                            <p class="text-xs text-gray-600 leading-relaxed">{item.description}</p>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <section class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <div class="bg-primary-50/50 border border-primary-100 rounded-3xl p-6 md:p-8">
                <div class="max-w-3xl mb-8">
                    <span class="text-xs font-semibold uppercase tracking-wider text-primary-700">Tanıdan Tedaviye Akış</span>
                    <h2 class="font-headline text-3xl text-gray-900 mt-2 mb-4">Semen analizinden ICSI kararına giden yol</h2>
                    <p class="text-gray-700 leading-relaxed">
                        Erkek infertilitesi değerlendirmesinde tek bir semen analizi çoğu zaman başlangıç bilgisidir; sonuç, öykü, muayene, hormonlar, genetik risk ve kadın partnerin yaşı/rezerviyle birlikte yorumlanır.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <a href="/tani-sureci" class="rounded-2xl border border-primary-100 bg-white p-5 hover:border-primary-200 hover:bg-primary-50 transition-colors">
                        <span class="material-symbols-outlined text-primary-600 mb-3">fact_check</span>
                        <h3 class="font-bold text-gray-900 mb-2">1. Semen analizi ve tekrar test</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">Sayı, hareket ve morfoloji birlikte değerlendirilir; belirgin anormallikte çoğu zaman tekrar analiz ve öykü ayrıntısı gerekir.</p>
                    </a>
                    <a href="/hormon-paneli" class="rounded-2xl border border-primary-100 bg-white p-5 hover:border-primary-200 hover:bg-primary-50 transition-colors">
                        <span class="material-symbols-outlined text-primary-600 mb-3">science</span>
                        <h3 class="font-bold text-gray-900 mb-2">2. Hormon, genetik ve üroloji değerlendirmesi</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">FSH, LH, testosteron, prolaktin, testis hacmi ve gerekirse <span class="text-primary-600">genetik testler</span> azospermi/çok ağır olgularda önem kazanır.</p>
                    </a>
                    <a href="/makaleler/varikosel-nedir-ne-zaman-ameliyat-gerekir" class="rounded-2xl border border-primary-100 bg-white p-5 hover:border-primary-200 hover:bg-primary-50 transition-colors">
                        <span class="material-symbols-outlined text-primary-600 mb-3">healing</span>
                        <h3 class="font-bold text-gray-900 mb-2">3. Düzeltilebilir nedenler</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">Klinik varikosel, ilaç/ısı/alkol maruziyeti, uyku, kilo ve beslenme gibi alanlar kişisel plana göre düzenlenebilir.</p>
                    </a>
                    <a href="/makaleler/mikroenjeksiyon-icsi-nedir" class="rounded-2xl border border-primary-100 bg-white p-5 hover:border-primary-200 hover:bg-primary-50 transition-colors">
                        <span class="material-symbols-outlined text-primary-600 mb-3">biotech</span>
                        <h3 class="font-bold text-gray-900 mb-2">4. IVF, ICSI ve cerrahi sperm arama</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">Ağır sperm faktörü, azospermi veya önceki döllenme sorunlarında ICSI, TESA/TESE veya mikro-TESE seçenekleri gündeme gelebilir.</p>
                    </a>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mt-5">
                    Ağır olgularda <a href="/makaleler/azospermi-mikro-tese" class="text-primary-600 hover:underline">azospermi ve mikro-TESE</a>, yaşam tarzı başlıklarında ise <a href="/makaleler/erkek-dogurganlik-besin-takviyeleri" class="text-primary-600 hover:underline">erkek doğurganlığı ve takviyeler</a> rehberleri bu sayfanın tamamlayıcı okumalarıdır.
                </p>
            </div>
        </section>

        <!-- Quick-Nav -->
        <nav id="quick-nav" class="sticky top-20 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm mb-16">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 overflow-x-auto whitespace-nowrap">
                <div class="flex items-center gap-1 py-3">
                    <a href="#konu-haritasi" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Konu Haritası</a>
                    <a href="#nedenler" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Nedenler</a>
                    <a href="#tani" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Tanı</a>
                    <a href="#tedaviler" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Tedaviler</a>
                    <a href="#yasam" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Yaşam Tarzı</a>
                    <a href="#duygusal" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Duygusal Boyut</a>
                    <a href="#sss" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">SSS</a>
                </div>
            </div>
        </nav>

        <!-- Section 1: Nedenler -->
        <section id="nedenler" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">Erkek infertilitesinin nedenleri nelerdir?</h2>
                        <div class="space-y-4 text-gray-600">
                            <p>
                                Erkek infertilitesi, sperm üretimi, fonksiyon veya transportundaki sorunlardan kaynaklanabilir. Bir çift bir yıl (kadın 35 yaş üstü ise 6 ay) korunmasız ilişkiye rağmen gebelik elde edemiyorsa erkek değerlendirilmesi de yapılmalıdır.
                            </p>
                            <div class="space-y-4 text-sm">
                                <div class="flex items-start gap-4 bg-white rounded-xl p-4 shadow-sm">
                                    <span class="font-mono font-bold text-red-600 shrink-0">V</span>
                                    <span class="text-gray-600"><strong>Varikosel:</strong> Klinik olarak saptandığında sperm parametrelerini etkileyebilen, seçilmiş hastalarda tedavi edilebilir bir nedendir. <a href="/makaleler/varikosel-nedir-ne-zaman-ameliyat-gerekir" class="text-primary-600 hover:underline">Varikosel rehberi</a></span>
                                </div>
                                <div class="flex items-start gap-4 bg-white rounded-xl p-4 shadow-sm">
                                    <span class="font-mono font-bold text-amber-600 shrink-0">%</span>
                                    <span class="text-gray-600"><strong>Enfeksiyon:</strong> Epididimit, orşit, prostatit. Belirti vermeyen enfeksiyonlar bile sperm parametrelerini etkileyebilir.</span>
                                </div>
                                <div class="flex items-start gap-4 bg-white rounded-xl p-4 shadow-sm">
                                    <span class="font-mono font-bold text-primary-600 shrink-0">→</span>
                                    <span class="text-gray-600"><strong>Hormonal bozukluklar:</strong> Düşük FSH/LH, hipogonadizm veya hipotalamik disfonksiyon.</span>
                                </div>
                                <div class="flex items-start gap-4 bg-white rounded-xl p-4 shadow-sm">
                                    <span class="font-mono font-bold text-primary-600 shrink-0">→</span>
                                    <span class="text-gray-600"><strong>Genetik etkenler:</strong> Klinefelter, Y-kromozom mikrodelesyonları. <a href="/genetik-testler/" class="text-primary-600 hover:underline">Genetik testler hakkında bilgi</a></span>
                                </div>
                                <div class="flex items-start gap-4 bg-white rounded-xl p-4 shadow-sm">
                                    <span class="font-mono font-bold text-primary-600 shrink-0">→</span>
                                    <span class="text-gray-600"><strong>Tıkanıklık:</strong> Vaz deferens yokluğu (CFTR mutasyonu), enfeksiyon sonrası obstrüksiyon.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <div class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/laboratuvar/icsicizim.webp" alt="Erkek üreme anatomisi" width="512" height="512" loading="lazy"/>
                            <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                                <p class="text-2xl font-headline">~1/6</p>
                                <p class="text-[10px] text-gray-600">Çift infertilite ile karşı karşıya</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 2: Tanı -->
        <section id="tani" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">Erkek infertilitesi nasıl değerlendirilir ve teşhis edilir?</h2>
                    <div class="space-y-4 text-gray-600">
                        <p>
                            Erkek infertilitesi değerlendirmesi, doğru koşullarda verilen semen analizi ile başlar. Sonuçlar tek başına "fertil/infertil" etiketi değildir; öykü, fizik muayene ve gerekirse hormon/genetik testlerle birlikte yorumlanır. WHO 2021 kılavuzundaki alt referans aralıkları:
                        </p>
                        <div class="bg-white border-l-4 border-primary rounded-xl p-6">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-gray-200/20">
                                        <th class="text-left py-2 pr-4 font-semibold text-gray-600">Parametre</th>
                                        <th class="text-left py-2 pr-4 font-semibold text-gray-600">Alt Sınır</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4 text-gray-600">Sperm konsantrasyonu</td>
                                        <td class="py-2 pr-4 font-bold text-primary-600">≥16 milyon/mL</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4 text-gray-600">Toplam sperm sayısı</td>
                                        <td class="py-2 pr-4 font-bold text-primary-600">≥39 milyon/ejakülat</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4 text-gray-600">Hareketlilik (total motilite)</td>
                                        <td class="py-2 pr-4 font-bold text-primary-600">≥42%</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4 text-gray-600">İleri hareketlilik (progressif)</td>
                                        <td class="py-2 pr-4 font-bold text-primary-600">≥30%</td>
                                    </tr>
                                    <tr>
                                        <td class="py-2 pr-4 text-gray-600">Normal morfoloji</td>
                                        <td class="py-2 pr-4 font-bold text-primary-600">≥4%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p>
                            Semen analizi anormal çıktığında <a href="/hormon-paneli" class="text-primary-600 hover:underline">hormon paneli</a> (FSH, LH, testosteron, prolaktin) ve gerekirse <a href="/genetik-testler/" class="text-primary-600 hover:underline">genetik testler</a> istenir. Azospermi veya çok ağır oligozoospermi gibi durumlarda <a href="/makaleler/azospermi-mikro-tese" class="text-primary-600 hover:underline">azospermi ve mikro-TESE yol haritası</a> ayrıca değerlendirilmelidir.
                        </p>
                        <div class="bg-primary-50 border border-primary-100 rounded-xl p-5 text-sm">
                            <h3 class="font-bold text-gray-900 mb-2">Ne zaman üroloji/androloji değerlendirmesi gerekir?</h3>
                            <ul class="space-y-1 text-gray-600">
                                <li>• Semen analizinde belirgin sayı, hareket veya morfoloji bozukluğu varsa</li>
                                <li>• Sperm hiç görülmüyorsa (azospermi) veya testis hacmi/hormonlar anormalse</li>
                                <li>• Ele gelen varikosel, geçirilmiş testis cerrahisi, inmemiş testis veya kemoterapi öyküsü varsa</li>
                                <li>• Tekrarlayan gebelik kaybı ya da tekrarlayan tüp bebek başarısızlığı erkek faktörüyle birlikte düşünülüyorsa</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <div class="relative group">
                        <img class="rounded-2xl shadow-xl w-full" src="/images/library/hastalik/varikosel.webp" alt="Varikosel tanı ve tedavi" width="512" height="512" loading="lazy"/>
                        <div class="absolute -bottom-6 -left-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                            <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                            <p class="text-2xl font-headline">WHO</p>
