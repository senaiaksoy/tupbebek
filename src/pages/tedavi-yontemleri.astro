---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildHubItemListSchema } from '../utils/hubStructuredData';

const treatmentDecisionLinks = [
    {
        href: '/makaleler/iui-nedir',
        icon: 'medication',
        title: 'IUI / aşılama',
        description: 'Tüpler açıksa, yumurtlama düzenlenebiliyorsa ve sperm faktörü ağır değilse seçilmiş olgularda konuşulur.'
    },
    {
        href: '/makaleler/tup-bebek-nedir',
        icon: 'science',
        title: 'IVF',
        description: 'Tüp faktörü, belirli kadın/erkek faktörleri, açıklanamayan infertilite veya başarısız önceki tedavilerde gündeme gelebilir.'
    },
    {
        href: '/makaleler/mikroenjeksiyon-icsi-nedir',
        icon: 'biotech',
        title: 'ICSI / mikroenjeksiyon',
        description: 'Ağır sperm faktörü, azospermi sonrası sperm bulunması veya döllenme sorunu öyküsünde laboratuvar kararı olarak öne çıkar.'
    },
    {
        href: '/genetik-testler/',
        icon: 'genetics',
        title: 'PGT',
        description: 'Tek gen hastalığı, yapısal kromozom riski veya seçilmiş embriyo değerlendirme durumlarında ayrıca ele alınır.'
    },
    {
        href: '/fertilite-koruma',
        icon: 'shield_with_heart',
        title: 'Fertilite koruma',
        description: 'Kanser tedavisi, düşük rezerv riski, endometriozis veya kişisel zamanlama planı varsa yumurta/sperm dondurma konuşulabilir.'
    },
    {
        href: '/makaleler/bagisiklik-tedavileri',
        icon: 'rule',
        title: 'Add-on uygulamalar',
        description: 'ERA, EmbryoGlue, scratching, time-lapse veya immün yaklaşımlar standart tedavinin yerine geçmez; kanıt düzeyi ayrı okunmalıdır.'
    }
];

const faqs = [
    {
        q: 'IUI ile IVF arasındaki temel fark nedir?',
        a: 'IUI, hazırlanmış spermin rahim içine verilmesidir; döllenme vücut içinde olur. IVF’te yumurta ve sperm laboratuvarda bir araya getirilir, oluşan embriyo rahme transfer edilir. Hangi yöntemin uygun olduğu yaş, tüpler, semen analizi, infertilite süresi ve önceki tedavi öyküsüne göre değişir.'
    },
    {
        q: 'ICSI herkese gerekli midir?',
        a: 'Hayır. ICSI özellikle ağır erkek faktörü, azospermi sonrası sperm bulunması veya önceki döllenme sorunu gibi durumlarda gündeme gelir. Rutin olarak herkese uygulanması kişisel tanı ve laboratuvar kararıyla değerlendirilmelidir.'
    },
    {
        q: 'PGT gebeliği garanti eder mi?',
        a: 'Hayır. PGT seçilmiş genetik risklerde veya belirli embriyo değerlendirme durumlarında bilgi sağlayabilir; ancak rahim faktörü, embriyo gelişimi, yaş ve biyolojik değişkenler nedeniyle gebeliği garanti etmez.'
    },
    {
        q: 'ERA, EmbryoGlue veya scratching gibi add-on uygulamalar gerekli mi?',
        a: 'Bu uygulamalar standart tedavinin yerine geçmez. Bazıları seçilmiş hasta gruplarında tartışılabilir; ancak kanıt düzeyi, önceki deneme öyküsü ve olası yük/yarar dengesi hekimle birlikte değerlendirilmelidir.'
    }
];

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: {
            '@type': 'Answer',
            text: a
        }
    }))
};

const itemListSchema = buildHubItemListSchema({
    site: Astro.site,
    pagePath: '/tedavi-yontemleri/',
    name: 'Tedavi yöntemleri konu haritası',
    description: 'IUI, IVF, ICSI, PGT, fertilite koruma ve add-on uygulamaları kanıt düzeyi ve kullanım bağlamına göre ayıran tedavi yöntemleri okuma yolu.',
    items: treatmentDecisionLinks
});
---

<BaseLayout title="Yardımcı Üreme Teknikleri ve Tedavi Yöntemleri | tupbebek.com" description="IVF, ICSI, IUI, aşılama, yumurta dondurma, PGT ve diğer yardımcı üreme tekniklerinin karşılaştırmalı rehberi.">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />
    <Header />
    
    <main id="main-content" tabindex="-1" class="pt-20">
        <!-- Hero Section -->
        <header class="relative overflow-hidden bg-gray-50 pt-24 pb-32 px-8">
            <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7">
                    <nav class="flex items-center gap-2 mb-6 text-sm text-gray-600 font-label">
                        <a href="/">Anasayfa</a>
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                        <span>Tedavi Yöntemleri</span>
                    </nav>
                    <h1 class="text-5xl lg:text-7xl font-headline text-primary-600 mb-8 tracking-tight leading-tight">Yardımcı Üreme Teknikleri</h1>
                    <p class="text-xl text-gray-600 leading-relaxed max-w-2xl mb-10">
                        Yardımcı üreme teknikleri; tanı, yaş, yumurtalık rezervi, semen analizi, genetik risk ve önceki tedavi öyküsüne göre seçilir. Bu rehber, IVF, ICSI, IUI, PGT, yumurta dondurma ve add-on uygulamaları kanıt düzeyiyle birlikte karşılaştırır.
                    </p>
                    <div class="flex items-center gap-4 py-4 border-l-4 border-tertiary pl-6 bg-gray-50/50 rounded-r-xl inline-flex">
                        <div class="flex flex-col">
                            <span class="text-xs uppercase tracking-widest text-gray-600 font-bold">İnceleme</span>
                            <span class="text-lg font-headline text-gray-900">Yayın Kurulu</span>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-5 relative">
                    <div class="aspect-square rounded-[2rem] overflow-hidden shadow-2xl rotate-3 bg-primary-50">
                        <img class="w-full h-full object-cover mix-blend-multiply opacity-80" src="/images/tedavi-yontemleri/lab-microscope.webp" alt="Laboratuvar mikroskobu" width="512" height="512" loading="eager" fetchpriority="high"/>
                    </div>
                    <div class="absolute -bottom-6 -left-6 bg-gray-50 p-6 rounded-xl shadow-lg max-w-[240px]">
                        <span class="material-symbols-outlined text-mint-600 mb-2 block">verified</span>
                        <p class="text-xs font-label text-gray-600 italic leading-snug">"Bu sayfa klinik araştırmalar ve kılavuzlar ışığında genel bilgilendirme için hazırlanmıştır."</p>
                    </div>
                </div>
            </div>
        </header>

        <!-- Treatment Decision Hub -->
        <section id="konu-haritasi" class="py-20 px-8 max-w-7xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
                <div>
                    <span class="text-primary-600 font-bold tracking-[0.18em] uppercase text-xs mb-4 block">Tedavi Haritası</span>
                    <h2 class="text-4xl font-headline text-gray-900 mb-6">Hangi tedavi ne zaman gündeme gelir?</h2>
                    <p class="text-gray-600 leading-relaxed mb-6">
                        Tedavi seçimi tek başına yöntem adına göre yapılmaz. Hafif erkek faktörü, yumurtlama düzensizliği, tüp tıkanıklığı, düşük rezerv, ileri yaş veya genetik hastalık riski farklı yollar açabilir.
                    </p>
                    <p class="text-sm text-gray-600 leading-relaxed">
                        Ana süreç için <a href="/ivf-rehberi" class="text-primary-600 hover:underline">IVF rehberi</a>, tanı basamağı için <a href="/tani-sureci" class="text-primary-600 hover:underline">tanı süreci</a>, transfer kararları için <a href="/transfer-sureci" class="text-primary-600 hover:underline">transfer süreci</a> sayfalarıyla birlikte okunmalıdır.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {treatmentDecisionLinks.map((item) => (
                        <a href={item.href} class="rounded-2xl border border-gray-100 bg-gray-50 p-5 hover:border-primary-200 hover:bg-primary-50/40 transition-colors">
                            <span class="material-symbols-outlined text-primary-600 mb-3">{item.icon}</span>
                            <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
                            <p class="text-sm text-gray-600 leading-relaxed">{item.description}</p>
                        </a>
                    ))}
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mt-5">
                    Genetik test kararlarında <a href="/makaleler/pgt-m" class="text-primary-600 hover:underline">PGT-M</a>, <a href="/makaleler/pgt-cinsiyet-secimi" class="text-primary-600 hover:underline">PGT ile cinsiyet seçiminin yasal ve etik sınırları</a> ve <a href="/makaleler/akraba-evliligi" class="text-primary-600 hover:underline">akraba evliliğinde genetik danışmanlık</a> rehberleri birlikte okunmalıdır.
                </p>
            </div>
        </section>

        <!-- Treatments Grid -->
        <section class="py-24 px-8 max-w-7xl mx-auto">
            <div class="mb-16">
                <h2 class="text-3xl font-headline text-gray-900 mb-4">Temel Tedavi Protokolleri</h2>
                <div class="h-1 w-24 bg-primary-600 rounded-full"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Card 1: IVF & ICSI -->
                <div class="bg-gray-50 p-8 rounded-xl flex flex-col group hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-200">
                    <span class="material-symbols-outlined text-primary-600 mb-6 text-4xl">science</span>
                    <h3 class="text-2xl font-headline mb-4 group-hover:text-primary-600 transition-colors">IVF &amp; ICSI</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-grow">In-vitro fertilizasyon ve intrasitoplazmik sperm enjeksiyonu tekniklerinin klinik entegrasyonu.</p>
                    <a href="/makaleler/tup-bebek-nedir" class="w-full py-3 bg-gray-100 text-primary-600 font-bold rounded-xl flex items-center justify-center gap-2 hover:bg-primary-600 hover:text-white transition-all">
                        Bilimsel İnceleme
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
                <!-- Card 2: Aşılama (IUI) -->
                <div class="bg-gray-50 p-8 rounded-xl flex flex-col group hover:shadow-xl transition-all duration-300">
                    <span class="material-symbols-outlined text-primary-600 mb-6 text-4xl">medication</span>
                    <h3 class="text-2xl font-headline mb-4 group-hover:text-primary-600 transition-colors">Aşılama (IUI)</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-grow">İntrauterin inseminasyon ile kontrollü ovaryan stimülasyon sonrası uygun olgularda gebelik şansının desteklenmesi.</p>
                    <a href="/makaleler/iui-nedir" class="w-full py-3 bg-gray-100 text-primary-600 font-bold rounded-xl flex items-center justify-center gap-2 hover:bg-primary-600 hover:text-white transition-all">
                        Bilimsel İnceleme
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
                <!-- Card 3: Yumurtlama Takibi -->
                <div class="bg-gray-50 p-8 rounded-xl flex flex-col group hover:shadow-xl transition-all duration-300">
                    <span class="material-symbols-outlined text-primary-600 mb-6 text-4xl">monitor_heart</span>
                    <h3 class="text-2xl font-headline mb-4 group-hover:text-primary-600 transition-colors">Yumurtlama Takibi</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-grow">Ultrasonografik ve hormonal parametreler eşliğinde ovülasyon döneminin hassas tespiti.</p>
                    <a href="/makaleler/yumurtlama-takibi/" class="w-full py-3 bg-gray-100 text-primary-600 font-bold rounded-xl flex items-center justify-center gap-2 hover:bg-primary-600 hover:text-white transition-all">
                        Bilimsel İnceleme
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
                <!-- Card 4: PGT -->
                <div class="bg-gray-50 p-8 rounded-xl flex flex-col group hover:shadow-xl transition-all duration-300">
                    <span class="material-symbols-outlined text-primary-600 mb-6 text-4xl">genetics</span>
                    <h3 class="text-2xl font-headline mb-4 group-hover:text-primary-600 transition-colors">PGT</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-grow">Preimplantasyon genetik tanı ile kromozomal anomali taraması ve embriyo seleksiyonu.</p>
                    <a href="/genetik-testler/" class="w-full py-3 bg-gray-100 text-primary-600 font-bold rounded-xl flex items-center justify-center gap-2 hover:bg-primary-600 hover:text-white transition-all">
                        Bilimsel İnceleme
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
                <!-- Card 5: Embriyo Dondurma -->
                <div class="bg-gray-50 p-8 rounded-xl flex flex-col group hover:shadow-xl transition-all duration-300">
                    <span class="material-symbols-outlined text-primary-600 mb-6 text-4xl">ac_unit</span>
                    <h3 class="text-2xl font-headline mb-4 group-hover:text-primary-600 transition-colors">Embriyo Dondurma</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-grow">Vitrifikasyon tekniği ile embriyo kriyoprezervasyonu ve dondurulmuş transfer siklusları.</p>
                    <a href="/makaleler/taze-dondurulmus-transfer" class="w-full py-3 bg-gray-100 text-primary-600 font-bold rounded-xl flex items-center justify-center gap-2 hover:bg-primary-600 hover:text-white transition-all">
                        Bilimsel İnceleme
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
                <!-- Card 6: Fertilite Koruma -->
                <div class="bg-gray-50 p-8 rounded-xl flex flex-col group hover:shadow-xl transition-all duration-300">
                    <span class="material-symbols-outlined text-primary-600 mb-6 text-4xl">shield_with_heart</span>
                    <h3 class="text-2xl font-headline mb-4 group-hover:text-primary-600 transition-colors">Fertilite Koruma</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-8 flex-grow">Onkolojik veya sosyal endikasyonlar ile yumurta ve sperm hücrelerinin dondurulması.</p>
                    <a href="/makaleler/yumurta-dondurma-rehberi" class="w-full py-3 bg-gray-100 text-primary-600 font-bold rounded-xl flex items-center justify-center gap-2 hover:bg-primary-600 hover:text-white transition-all">
                        Bilimsel İnceleme
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="py-20 px-8 max-w-7xl mx-auto">
            <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
                <div class="max-w-3xl mb-8">
                    <span class="text-primary-600 font-bold tracking-[0.18em] uppercase text-xs mb-3 block">Kanıt Düzeyi</span>
                    <h2 class="text-3xl font-headline text-gray-900 mb-4">Standart tedavi ile add-on uygulamaları ayırmak</h2>
                    <p class="text-gray-600 leading-relaxed">
                        Hastalar için en karıştırıcı alan, yerleşik tedavi basamaklarıyla ek uygulamaların aynı cümlede sunulmasıdır. Aşağıdaki ayrım, beklentiyi daha gerçekçi kurmak için hazırlanmıştır.
                    </p>
                </div>
                <div class="divide-y divide-gray-100 overflow-hidden rounded-xl border border-gray-100">
                    <div class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-4 p-5">
                        <h3 class="font-bold text-gray-900">Yerleşik ana yöntemler</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">IVF, ICSI, IUI, embriyo dondurma ve fertilite koruma; uygun endikasyonda klinik pratiğin ana basamaklarıdır.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-4 p-5">
                        <h3 class="font-bold text-gray-900">Seçilmiş durumda düşünülenler</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">PGT-M, cerrahi sperm arama, histeroskopi veya taze/dondurulmuş transfer seçimi kişisel tanıya göre anlam kazanır.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-4 p-5">
                        <h3 class="font-bold text-gray-900">Kanıtı sınırlı add-onlar</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">ERA, EmbryoGlue, endometrial scratching, bazı bağışıklık tedavileri ve over PRP rutin çözüm gibi sunulmamalı; hasta öyküsü ve kanıt gücüyle tartışılmalıdır.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-20 px-8 max-w-5xl mx-auto">
            <div class="mb-10">
                <span class="text-primary-600 font-bold tracking-[0.18em] uppercase text-xs mb-3 block">Kısa Yanıtlar</span>
                <h2 class="text-3xl font-headline text-gray-900 mb-4">Tedavi yöntemleri hakkında sık sorulanlar</h2>
                <p class="text-gray-600 leading-relaxed">Bu yanıtlar genel bilgilendirme amaçlıdır; kişisel tedavi kararı tanı ve klinik değerlendirmeyle verilir.</p>
            </div>
            <div class="space-y-4">
                {faqs.map(({ q, a }) => (
                    <article class="rounded-2xl border border-gray-100 bg-gray-50 p-5">
                        <h3 class="font-bold text-gray-900 mb-2">{q}</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">{a}</p>
                    </article>
                ))}
            </div>
        </section>

        <!-- Special Procedures Section -->
        <section class="py-24 bg-gray-50 px-8">
            <div class="max-w-7xl mx-auto">
                <div class="mb-16 text-center">
                    <span class="text-mint-600 font-bold tracking-[0.2em] uppercase text-xs mb-4 block">Advanced Methodologies</span>
                    <h2 class="text-4xl font-headline text-gray-900">Özel Prosedürler</h2>
                    <p class="text-sm text-gray-600 leading-relaxed max-w-3xl mx-auto mt-4">
                        Bu başlıkların bir bölümü standart uygulama, bir bölümü ise kanıt düzeyi zayıf add-on girişimlerdir. İmmün serumları ve benzeri eklentiler için ayrı bir <a href="/makaleler/bagisiklik-tedavileri" class="text-primary-600 hover:underline">bağışıklık tedavileri incelemesi</a> okumak, beklentiyi daha gerçekçi kurmaya yardım eder.
                    </p>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                    <!-- Procedure 1 -->
                    <div class="flex flex-col md:flex-row bg-gray-50 rounded-2xl overflow-hidden shadow-sm">
                        <div class="md:w-1/3 bg-primary-50 relative">
                            <img class="w-full h-full object-cover" src="/images/tedavi-yontemleri/petri-dish.webp" alt="EmbryoGlue" width="512" height="512" loading="lazy"/>
                        </div>
                        <div class="p-8 md:w-2/3">
                            <h3 class="text-xl font-headline text-primary-600 mb-4">EmbryoGlue</h3>
                            <p class="text-sm text-gray-600 leading-relaxed mb-6">
                                Hyaluronan zenginleştirilmiş transfer medyası kullanımı ile embriyo-endometrium etkileşiminin biyo-kimyasal olarak desteklenmesi prosedürüdür.
                            </p>
                            <a href="/makaleler/embryoglue-faydalari" class="text-primary-600 font-bold text-sm flex items-center gap-2 hover:underline">
                                <span class="material-symbols-outlined">description</span>
                                Bilimsel İnceleme
                            </a>
                        </div>
                    </div>
                    <!-- Procedure 2 -->
                    <div class="flex flex-col md:flex-row bg-gray-50 rounded-2xl overflow-hidden shadow-sm">
                        <div class="md:w-1/3 bg-mint-100 relative">
                            <img class="w-full h-full object-cover" src="/images/tedavi-yontemleri/clinical-lab.webp" alt="Endometrial Scratching" width="512" height="512" loading="lazy"/>
                        </div>
                        <div class="p-8 md:w-2/3">
                            <h3 class="text-xl font-headline text-primary-600 mb-4">Endometrial Scratching</h3>
                            <p class="text-sm text-gray-600 leading-relaxed mb-6">
                                İmplantasyon penceresi öncesi endometrium dokusuna uygulanan mikro-uyarıların başarı oranları üzerindeki sitokin etkisi incelemesi.
                            </p>
                             <a href="/makaleler/endometriyal-scratching" class="text-primary-600 font-bold text-sm flex items-center gap-2 hover:underline">
                                <span class="material-symbols-outlined">description</span>
                                Bilimsel İnceleme
                            </a>
                        </div>
                    </div>
                    <!-- Procedure 3 -->
                    <div class="flex flex-col md:flex-row bg-gray-50 rounded-2xl overflow-hidden shadow-sm">
                        <div class="md:w-1/3 bg-primary-50 relative">
                            <img class="w-full h-full object-cover" src="/images/tedavi-yontemleri/clinical-lab.webp" alt="EmbryoScope ve time-lapse embriyo izleme" width="512" height="512" loading="lazy"/>
                        </div>
                        <div class="p-8 md:w-2/3">
                            <h3 class="text-xl font-headline text-primary-600 mb-4">EmbryoScope ve Yapay Zeka</h3>
                            <p class="text-sm text-gray-600 leading-relaxed mb-6">
                                Time-lapse embriyo izleme ve algoritmik skorlamanın karar destek rolü, kanıt düzeyi ve sınırlamaları.
                            </p>
                            <a href="/makaleler/embryoscope-yapay-zeka" class="text-primary-600 font-bold text-sm flex items-center gap-2 hover:underline">
                                <span class="material-symbols-outlined">description</span>
                                Bilimsel İnceleme
                            </a>
                        </div>
                    </div>
                    <!-- Procedure 4 -->
                    <div class="flex flex-col md:flex-row bg-gray-50 rounded-2xl overflow-hidden shadow-sm">
                        <div class="md:w-1/3 bg-mint-100 relative">
                            <img class="w-full h-full object-cover" src="/images/tedavi-yontemleri/petri-dish.webp" alt="ERA testi ve endometriyal reseptivite" width="512" height="512" loading="lazy"/>
                        </div>
                        <div class="p-8 md:w-2/3">
                            <h3 class="text-xl font-headline text-primary-600 mb-4">ERA Testi</h3>
                            <p class="text-sm text-gray-600 leading-relaxed mb-6">
