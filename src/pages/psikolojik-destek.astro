---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Psikolojik Destek ve Duygusal Rehber: İnfertilite Yolculuğu | tupbebek.com" description="İnfertilite sürecinin duygusal etkileri, çift ilişkileri, başarısız denemeler ve profesyonel destek alma zamanı. Duygusal rehber ve destek kaynakları.">
    <Header />

    <main id="main-content" tabindex="-1" class="pb-24">
        <!-- Hero Section - warmer tone -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-20">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">favorite</span>
                        Duygusal Rehber
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        Psikolojik Destek: <span class="text-primary-600 italic">Bu Yolculukta</span> Yalnız Değilsiniz
                    </h1>
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border-l-4 border-primary">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200">
                            <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                        </div>
                        <div>
                            <p class="font-headline italic text-gray-900 text-sm">Psikolojik Danışmanlık:</p>
                            <p class="font-bold text-primary-600">Yayın Kurulu</p>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-xl overflow-hidden shadow-md">
                    <img class="w-full h-full object-cover" src="/images/library/psikoloji/danismanlik-gorusmesi.webp" alt="Hasta-danışman görüşmesi, empatik destek ortamı" width="512" height="512" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <!-- Introduction - empathetic -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-body italic mb-12">
                İnfertilite sadece tıbbi bir durum değil; derin duygusal, psikolojik ve ilişkisel bir yolculuktur. Kaygı, üzüntü, öfke, yalnızlık hissi ve güç kaybı deneyimleri yaygındır. Bu rehber, bu zorlu süreçte kendinizi anlamanız ve sağlıklı baş etme stratejileri geliştirmeniz için hazırlanmıştır.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">favorite_border</span>
                    <h3 class="font-bold text-sm mb-2">%70</h3>
                    <p class="text-xs text-gray-600 mb-0">İnfertilite kaygısı yaşayan çiftler</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">group</span>
                    <h3 class="font-bold text-sm mb-2">2-3x</h3>
                    <p class="text-xs text-gray-600 mb-0">Depresyon riski genel nüfus oranına göre</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">psychology</span>
                    <h3 class="font-bold text-sm mb-2">CBT</h3>
                    <p class="text-xs text-gray-600 mb-0">Bilişsel Davranışçı Terapi etkili</p>
                </div>
            </div>
        </section>

        <!-- Quick-Nav Bar -->
        <nav id="quick-nav" class="sticky top-20 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm mb-16">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 overflow-x-auto whitespace-nowrap">
                <div class="flex items-center gap-1 py-3">
                    <a href="#duygusal" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Duygusal Etki</a>
                    <a href="#cift" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Çift İlişkisi</a>
                    <a href="#basetme" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Baş Etme</a>
                    <a href="#yas" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Yas Süreci</a>
                    <a href="#destek" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Profesyonel Destek</a>
                </div>
            </div>
        </nav>

        <!-- Section 1: Duygusal Etkiler -->
        <section id="duygusal" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">1. İnfertilite ve Duygusal Etkiler</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                İnfertilite deneyimi, birçok kişi için güçlü duygusal tepkiler tetikler. Kaygı, umutsuzluk, öfke, suçlama hissi ve özgüven kaybı sık görülür. Bu duygular, süreç ilerledikçe ve tedavi sonuçları belirginleştikçe artabilir.
                            </p>
                            <p>
                                Araştırmalar, infertilite hastalarının %40-50'sinde orta seviyeli depresif belirtiler, %60-70'inde ise kaygı bozukluğu saptadı. Bu oranlar, kronik hastalıklarla eşdeğer seviyededir.
                            </p>
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                                <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary-600">psychology</span>
                                    Yaygın Duygusal Belirtiler
                                </h4>
                                <div class="grid grid-cols-2 gap-4 text-sm">
                                    <div><strong>Kaygı:</strong> Gelecek korkusu, kontrol kaybı</div>
                                    <div><strong>Üzüntü:</strong> Gönül darlığı, hüzün, ağlama</div>
                                    <div><strong>Öfke:</strong> Adalet sorgulaması, huzursuzluk</div>
                                    <div><strong>Suçlama:</strong> Kendini veya eşini suçlama</div>
                                    <div><strong>Yalnızlık:</strong> Sosyal çekilme, anlaşılmama</div>
                                    <div><strong>Çaresizlik:</strong> İrade kaybı, güçsüz hissetme</div>
                                </div>
                            </div>
                            <p class="text-sm text-gray-600">
                                Bu duyguların hepsi <strong>normal</strong> bir sürecin parçasıdır. Tarafsız, kabul eden ve şefkatli bir tutumla bu duyguları ifade etmek iyileşme için ilk adımdır.
                            </p>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <div class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/psikoloji/duygusal-etki.webp" alt="Duygusal destek, duygu işleme süreci" width="512" height="512" loading="lazy"/>
                            <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                                <p class="text-2xl font-headline">%60</p>
                                <p class="text-[10px] text-gray-600">Anksiyete oranı (infertil çiftler)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 2: Çift İlişkilerine Etkisi -->
        <section id="cift" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">2. Çift İlişkilerine Etkisi ve Baş Etme</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            İnfertilite genellikle bir çiftin ortak sorunu olmasına rağmen, her iki partnerin de farklı şekillerde etkilendiğini görürüz. Kadınlar genellikle duygusal yükü daha yoğun hissederken, erkekler daha çok "yeterlilik" duygusuyla ilgili zorluklar yaşayabilir.
                        </p>
                        <p>
                            Cinsellik, sosyal ilişkiler ve iletişim kalitesi etkilenebilir. Sadece bebek "amaçlı" cinsellik, kaygı ve performans baskısı yaratır. Bazen çiftler birbirinden uzaklaşabilir; bu da gerginliğin artmasına neden olabilir.
                        </p>
                        <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">psychology</span>
                                İletişim Stratejileri
                            </h4>
                            <div class="space-y-4 text-sm">
                                <p><strong>Açık İletişim:</strong> Duyguları önyargısız paylaşın. "Ben dili" ifadelerini kullanın. ("Kendimi çaresiz hissediyorum", "Yalnız kalmaktan korkuyorum" gibi).</p>
                                <p><strong>Empati:</strong> Partnerinizin duygularına alan açın. Onun deneyimini kabul edin, hemen "çözüm bulma" moduna geçmek yerine sadece orada olun.</p>
                                <p><strong>Sınırlar:</strong> Çevrenizle neyi, ne kadar konuşacağınızın sınırlarını birlikte belirleyin.</p>
                                <p><strong>Birlikte Vakit:</strong> Tedavi dışı aktiviteler planlayın. İlişkinizin sadece bu süreçten ibaret olmadığını kendinize hatırlatın.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <div class="relative group">
                        <img class="rounded-2xl shadow-xl w-full" src="/images/library/psikoloji/cift-danismanlik.webp" alt="Çift danışmanlığı, birlikte baş etme" width="512" height="512" loading="lazy"/>
                        <div class="absolute -bottom-6 -left-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                            <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                            <p class="text-2xl font-headline">%50</p>
                            <p class="text-[10px] text-gray-600">Çiftlerde iletişim sorunları</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 3: Baş Etme Stratejileri -->
        <section id="basetme" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">3. Baş Etme Stratejileri</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                Bilinçlı baş etme stratejileri, duygusal dayanıklılığınızı artırabilir. Tedavi sürecinde sizin kontrolünüzde olan şeyler (yaşam tarzı, stres yönetimi, sosyal medya kullanımı) odaklanabileceğiniz alanlardır.
                            </p>
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                                <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary-600">clinical_notes</span>
                                    Etkili Stratejiler
                                </h4>
                                <ul class="space-y-4 text-sm">
                                    <li class="flex gap-2">
                                        <span class="material-symbols-outlined text-primary-600 shrink-0">check_circle</span>
                                        <span><strong>Bilinçli Farkındalık (Mindfulness):</strong> Günlük 10-15 dakika meditasyon, nefes egzersizleri.</span>
                                    </li>
                                    <li class="flex gap-2">
                                        <span class="material-symbols-outlined text-primary-600 shrink-0">check_circle</span>
                                        <span><strong>Fiziksel Aktivite:</strong> Düzenli hafif egzersiz (yürüyüş, yoga, yüzme). Üreme sağlığını olumsuz etkileyebilecek aşırı yoğun antrenmanlardan kaçının.</span>
                                    </li>
                                    <li class="flex gap-2">
                                        <span class="material-symbols-outlined text-primary-600 shrink-0">check_circle</span>
                                        <span><strong>Günlük:</strong> Duyguları yazmak, şükran günlüğü, bullet journal.</span>
                                    </li>
                                    <li class="flex gap-2">
                                        <span class="material-symbols-outlined text-primary-600 shrink-0">check_circle</span>
                                        <span><strong>Sosyal Medya Sınırı:</strong> Başarı hikayeleri tetikleyen içeriklerden uzaklaşın. "Digital detox" dönemleri yapın.</span>
                                    </li>
                                    <li class="flex gap-2">
                                        <span class="material-symbols-outlined text-primary-600 shrink-0">check_circle</span>
                                        <span><strong>Sınır Belirleme:</strong> "İyiki" diye söylenen sorulara kısa cevaplar verin. "O adam sadece kendi yolunda" diyerek çevrenizi yönetin.</span>
                                    </li>
                                </ul>
                            </div>
                            <p class="text-sm text-gray-600">
                                Hatırlayın: Kendinize karşı şefkatli olmak bir çaresizlik değil, güçlü bir psikolojik stratejidir.
                            </p>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <div class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/psikoloji/mindfulness-meditasyon.webp" alt="Mindfulness ve meditasyon, baş etme stratejileri" width="512" height="512" loading="lazy"/>
                            <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Etkili</p>
                                <p class="text-2xl font-headline">%40</p>
                                <p class="text-[10px] text-gray-600">Mindfulness'in anksiyete azaltma oranı</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 4: Başarısız Denemeler ve Yas -->
        <section id="yas" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">4. Başarısız Denemeler ve Yas Süreci</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            Bir IVF döngüsünün sonuçlanması, bir "kayıp" deneyimidir. Gebelik testinin negatif çıkması veya düşük yaşamı deneyimlemek, beklentili bir bekleme süresinden sonra gelen bir yası andırır.
                        </p>
                        <p>
                            Yas süreci doğal ve gerekli bir süreçtir. Şok, inkara, öfke, pazarlık, depresyon ve kabul evrelerinden geçersiniz. Bu evreler düzensizdir; bazen aynı gün içinde birden çok evre yaşayabilirsiniz.
                        </p>
                        <div class="bg-gray-50 border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">history_edu</span>
                                Ne Zaman Tekrar Denemeliyim?
                            </h4>
                            <div class="space-y-4 text-sm">
                                <div class="flex items-start gap-4">
                                    <span class="font-mono font-bold text-primary-600 shrink-0">Kişisel karar</span>
                                    <span class="text-gray-600">Hiçbir zaman "zorlamayın". Kendiniz hazır olduğunuzda devam edin.</span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-primary-600 shrink-0">Klinik değerlendirme</span>
                                    <span class="text-gray-600">Bir sonraki döngü için laboratuvar temelli güncellemeler (embriyo tarama, transfer teknikleri) planlanabilir.</span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-primary-600 shrink-0">Zamanlama</span>
                                    <span class="text-gray-600">Çoğu merkez minimum 2-3 ay bekleme önerir; ancak duygusal olarak hazır hissettiğinizde doktorunuzla görüşerek ilerleyebilirsiniz.</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-sm text-gray-600">
                            <strong>Unutmayın:</strong> Her döngü için sizin kararınız geçerlidir. Doktorunuz size yönerge verebilir, ancak siz kontroldesiniz.
                        </p>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <div class="relative group">
                        <img class="rounded-2xl shadow-xl w-full" src="/images/library/psikoloji/yas-iyilesmeler.webp" alt="Yas ve iyileşme süreci" width="512" height="512" loading="lazy"/>
                        <div class="absolute -bottom-6 -left-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                            <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                            <p class="text-2xl font-headline">6-8</p>
                            <p class="text-[10px] text-gray-600">Haftalık ortalama yas süresi</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 5: Profesyonel Destek -->
        <section id="destek" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">5. Ne Zaman Profesyonel Destek Aramalısınız?</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                Bazen kendi kaynaklarınız yeterli olmayabilir. Profesyonel psikolojik destek, izolasyonu kırmak ve sağlıklı bir süreç yönetimi için kritik adımdır.
                            </p>
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                        <div class="bg-gray-50 border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">psychology</span>
                                Kırmızı Bayraklar (Yardım Zamanı)
                            </h4>
                                <ul class="space-y-2 text-sm">
                                    <li>• Sürekli uykusuzluk, iştahsızlık veya belirgin kilo kaybı</li>
                                    <li>• Kendine zarar verme düşünceleri</li>
                                    <li>• Aşırı sosyal çekilme, iş/sosyal performansın düşmesi</li>
                                    <li>• Alkol veya madde kullanımı üzerinden teselli arama</li>
                                    <li>• Çift arasındaki çatışmaların şiddetlenmesi</li>
                                    <li>• Tedavi kararlarında tam bir "çaresizlik" ve tıkanıklık hissi</li>
                                </ul>
                            </div>
                            <div class="bg-gray-50 border-l-4 border-primary rounded-xl p-6">
                                <h4 class="font-bold text-gray-900 text-sm mb-3">Yardımcı Olabilecek Terapiler</h4>
                                <div class="space-y-4 text-sm">
                                    <div>
                                        <strong>CBT (Bilişsel Davranışçı Terapi):</strong> Olumsuz düşünceleri fark etme ve zihinsel yapılandırma.
                                    </div>
                                    <div>
                                        <strong>EMDR:</strong> Travmatik anıların işlenmesi (özellikle gebelik kayıplarından sonra).
                                    </div>
                                    <div>
                                        <strong>Çift Terapisi:</strong> İletişim becerileri, müzakere, birlikte baş etme.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <div class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/psikoloji/profesyonel-destek.webp" alt="Profesyonel psikoloji desteği, güvenli danışmanlık ortamı" width="512" height="512" loading="lazy"/>
                            <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                                <p class="text-2xl font-headline">%30</p>
                                <p class="text-[10px] text-gray-600">Terapi alan infertilite hastaları</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 6: Destek Grupları ve Kaynaklar -->
        <section id="kaynaklar" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">6. Destek Grupları ve Kaynaklar</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            Benzer deneyimleri yaşayan insanlarla bağlantı kurmak, yalnızlık hissini azaltabilir ve pratik bilgiler edinmenizi sağlayabilir.
                        </p>
                        <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">group</span>
                                Türkçe Destek Grupları & Kaynaklar
                            </h4>
                            <ul class="space-y-4 text-sm">
                                <li class="flex gap-2">
