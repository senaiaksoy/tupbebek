---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HizliCevap from '../components/HizliCevap.astro';
import QuoteBlock from '../components/global/QuoteBlock.astro';
import { buildHubItemListSchema } from '../utils/hubStructuredData';
import { safeJsonLdStringify } from '../utils/seo';


const faqItems = [
    {
        q: 'Tüp bebek başarı oranları nasıl yorumlanmalı?',
        a: 'Başarı oranı tek bir yüzdeyle yorumlanmamalıdır. Önce payda sorulmalıdır: transfer işlemi başına mı, transfer edilen embriyo başına mı, yoksa kümülatif canlı doğum mu? Kadın yaşı, rezerv, sperm, embriyo gelişimi, rahim durumu, transfer tipi ve merkezin hasta profili birlikte okunur.',
    },
    {
        q: '40 yaş üstü tüp bebek başarı oranı neden daha düşüktür?',
        a: '40 yaş üstünde yumurta sayısı ve özellikle embriyoların kromozomal uygunluk olasılığı azalabilir. HFEA 2022 ön verisinde 40–42 yaş grubunda, kendi yumurtasıyla taze IVF’te transfer edilen embriyo başına canlı doğum oranı yaklaşık %10’dur; bu kişisel garanti değildir. Tek yüzde yerine kümülatif plan ve kişisel dosya daha anlamlıdır.',
    },
    {
        q: 'Tüp bebek merkezleri başarı oranları karşılaştırılabilir mi?',
        a: 'Karşılaştırma yapılırken yalnızca açıklanan yüzdeye değil; hasta yaşı, düşük rezervli hasta oranı, kaçıncı deneme olduğu, payda tanımı (embriyo başına / transfer başına / kümülatif) ve çoklu gebelik politikası gibi faktörlere bakılmalıdır. Farklı paydalar yan yana konmamalıdır.',
    },
];

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://tupbebek.com/basari-oranlari/#faq',
    mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
        },
    })),
};

const successHubLinks = [
    {
        href: '/makaleler/yasa-gore-tup-bebek-basari-oranlari/',
        title: 'Yaşa göre tüp bebek başarı oranları',
        description: 'HFEA 2022: transfer edilen embriyo başına canlı doğum; 30, 35, 40 yaş ve üzeri.'
    },
    {
        href: '/makaleler/dusuk-amh-hamilelik/',
        title: 'Düşük AMH ve başarı beklentisi',
        description: 'AMH, yaş, antral folikül sayısı ve IVF yanıtının birlikte yorumlanması.'
    },
    {
        href: '/makaleler/kac-yumurta-gerekir/',
        title: 'Kaç yumurta gerekir?',
        description: 'Toplanan yumurta sayısı, embriyo havuzu ve kümülatif başarı ilişkisi.'
    },
    {
        href: '/makaleler/embriyo-transferi-sonrasi-bakim/',
        title: 'Transfer sonrası dönem',
        description: 'Transfer sonrası aktivite, ilaç takibi ve beta-hCG bekleme sürecinin kanıta dayalı yorumu.'
    },
    {
        href: '/pgt-merkezi/',
        title: 'PGT Merkezi',
        description: 'PGT-A, PGT-M ve embriyo genetik testlerinin başarı oranlarıyla ilişkisi.'
    }
];

const itemListSchema = buildHubItemListSchema({
    site: Astro.site,
    pagePath: '/basari-oranlari/',
    name: 'Tüp bebek başarı oranları konu haritası',
    description: 'Yaş, AMH, yumurta sayısı, transfer sonrası takip ve PGT kararlarını başarı oranı okuması içinde bağlayan rehber.',
    items: successHubLinks
});
---

<BaseLayout title="Tüp Bebek Başarı Oranı: Kümülatif Veriler ve Gerçekçi Okuma | tupbebek.com" description="Tüp bebek başarı oranı nasıl okunur? HFEA 2022 payda çerçevesi, kümülatif sonuç, tedavi yöntemi ve uluslararası karşılaştırma; garanti yüzde yoktur.">
    <script type="application/ld+json" is:inline set:html={safeJsonLdStringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLdStringify(itemListSchema)} />
    <Header />


    <main id="main-content" tabindex="-1" class="pb-24">
        <!-- Hero Section -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-20">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        Klinik İstatistik
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        Tüp Bebek Başarı Oranı: <span class="text-primary-600 italic">Verilerle</span> Gerçekçi Okuma
                    </h1>
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border-l-4 border-primary">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200">
                            <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                        </div>
                        <div>
                            <p class="font-headline italic text-gray-900 text-sm">İnceleme:</p>
                            <p class="font-bold text-primary-600">Yayın Kurulu</p>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl">
                    <img class="w-full h-full object-cover grayscale opacity-80" src="/images/library/istatistik/basari_oranlari_hero.webp" alt="Başarı oranları" width="512" height="512" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <div class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <HizliCevap question="Tüp bebek başarı oranı nasıl yorumlanmalı?">
                Tüp bebek başarı oranı tek bir yüzde değildir. Önce payda netleşmelidir: transfer işlemi başına mı, transfer edilen embriyo başına mı, yoksa kümülatif canlı doğum mu? Bu sayfadaki yaş özeti <a href="https://www.hfea.gov.uk/about-us/publications/research-and-data/fertility-treatment-2022-preliminary-trends-and-figures/" rel="noopener noreferrer">HFEA 2022</a> ön verisine dayanır: hastanın kendi yumurtasıyla taze IVF’te, transfer edilen embriyo başına canlı doğum (18–34 ≈ %35; 35–37 ≈ %26; 38–39 ≈ %18; 40–42 ≈ %10; 43–44 ≈ %5). <a href="https://www.cdc.gov/art/success-rates/index.html" rel="noopener noreferrer">CDC ART</a> çoğu zaman kümülatif bakış kullanır; paydalar farklı olduğu için HFEA ile yan yana konmamalıdır. Ayrıntılı okuma için <a href="/makaleler/yasa-gore-tup-bebek-basari-oranlari/">yaşa göre başarı oranları</a> yazısına bakın.
            </HizliCevap>
        </div>

        <!-- Scientific Introduction -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-body italic mb-12">
                Başarı oranları çoğu zaman hastanın en hızlı cevap aradığı yerdir; ama aynı zamanda en kolay yanlış anlaşılan başlıktır. Bir oran, kime ait olduğunu bilmeden fazla şey söylemez. 32 yaşında ilk denemesini yapan biriyle, 41 yaşında düşük rezerv ve önceki deneme öyküsü olan biri aynı tabloda yan yana duramaz. Yaş gruplarına ve Türkiye'deki yasal çerçeveye göre ayrıntılı değerlendirme için <a href="/makaleler/yasa-gore-tup-bebek-basari-oranlari/" class="text-primary-700 underline hover:no-underline">yaşa göre tüp bebek başarı oranları</a> yazımıza bakabilirsiniz.
            </p>
            <QuoteBlock author="Doç. Dr. Senai Aksoy">
                Tüp bebekte oranlar pusula gibi kullanılmalıdır; haritanın tamamı sanıldığında hastayı ya gereksiz umutlandırır ya da gereksiz korkutur.
            </QuoteBlock>
            <div class="bg-primary-50/80 border border-primary-100 rounded-2xl p-6 mb-10">
                <h2 class="font-headline text-xl text-gray-900 mb-4">Kısa Cevap: Başarı Oranı Tek Bir Yüzde Değildir</h2>
                    <p class="text-sm md:text-base text-gray-700 leading-relaxed mb-4">
                    Tüp bebek başarı oranı; yaş, yumurtalık rezervi, sperm, embriyo gelişimi, rahim/tüp durumu, transfer tipi ve merkezin hangi hasta grubunu raporladığına göre değişir. Bu nedenle önce şu soru sorulmalıdır: bu yüzde transfer işlemi başına mı, transfer edilen embriyo başına mı, canlı doğumu mu yoksa aynı yumurta toplamadan gelen kümülatif sonucu mu anlatıyor? Bu sayfadaki yaş özeti HFEA 2022 çerçevesine bağlıdır.
                </p>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-primary-100">
                                <th class="text-left py-2 pr-4 font-semibold text-gray-700">Sık Aranan Soru</th>
                                <th class="text-left py-2 pr-4 font-semibold text-gray-700">Güvenli Yorum</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-primary-100">
                                <td class="py-2 pr-4 font-semibold text-gray-900">40 yaş üstü başarı</td>
                                <td class="py-2 pr-4 text-gray-600">Embriyo kromozom uygunluğu ve yumurta sayısı nedeniyle kişisel dosya üzerinden yorumlanır.</td>
                            </tr>
                            <tr class="border-b border-primary-100">
                                <td class="py-2 pr-4 font-semibold text-gray-900">Merkez başarı oranı</td>
                                <td class="py-2 pr-4 text-gray-600">Hasta seçimi, yaş dağılımı ve raporlama yöntemi bilinmeden karşılaştırma yanıltıcı olabilir.</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4 font-semibold text-gray-900">Kümülatif başarı</td>
                                <td class="py-2 pr-4 text-gray-600">Aynı yumurta toplama siklusundan elde edilen taze ve dondurulmuş transferlerin toplam etkisini anlatır.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">trending_up</span>
                    <h3 class="font-bold text-sm mb-2">≈ %35</h3>
                    <p class="text-xs text-gray-600 mb-0">18–34 yaş · transfer edilen embriyo başına canlı doğum (HFEA 2022)</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">monitoring</span>
                    <h3 class="font-bold text-sm mb-2">≈ %26</h3>
                    <p class="text-xs text-gray-600 mb-0">35–37 yaş · aynı payda (HFEA 2022)</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">science</span>
                    <h3 class="font-bold text-sm mb-2">≈ %10</h3>
                    <p class="text-xs text-gray-600 mb-0">40–42 yaş · aynı payda (HFEA 2022)</p>
                </div>
            </div>
            <p class="text-xs text-gray-500 -mt-8 mb-0">
                Kaynak: HFEA Fertility treatment 2022 preliminary trends — kendi yumurtası, taze IVF, transfer edilen embriyo başına. Kişisel prognoz değildir.
                38–39 ≈ %18; 43–44 ≈ %5. Ayrıntı: <a href="/makaleler/yasa-gore-tup-bebek-basari-oranlari/" class="text-primary-700 underline hover:no-underline">yaşa göre başarı oranları</a>.
            </p>
        </section>

        <!-- Quick-Nav Bar -->
        <nav id="quick-nav" class="sticky top-20 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm mb-16">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 overflow-x-auto whitespace-nowrap">
                <div class="flex items-center gap-1 py-3">
                    <a href="#yas" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Yaşa Göre</a>
                    <a href="#cumulative" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Kümülatif Başarı</a>
                    <a href="#comparison" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Karşılaştırma</a>
                    <a href="#international" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Uluslararası</a>
                    <a href="#factors" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Etkenler</a>
                </div>
            </div>
        </nav>

        <!-- Section 1: Yaşa Göre Başarı Oranları -->
        <section id="yas" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">Yaş, tüp bebek başarı oranını nasıl etkiler?</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                Kadın yaşı, tüp bebek sonucunu en güçlü etkileyen değişkenlerden biridir. Bunun nedeni yalnızca yumurta sayısının azalması değildir; yaş ilerledikçe embriyoların kromozomal olarak uygun olma olasılığı da düşer. Aşağıdaki tablo genel bir özet sunar; yaş gruplarına göre ayrıntılı okuma için <a href="/makaleler/yasa-gore-tup-bebek-basari-oranlari/" class="text-primary-700 underline hover:no-underline">yaşa göre tüp bebek başarı oranları</a> yazımıza bakabilirsiniz.
                            </p>
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                                <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary-600">biotech</span>
                                    HFEA 2022 — Canlı doğum / transfer edilen embriyo
                                </h4>
                                <p class="text-xs text-gray-600 mb-4">
                                    Kendi yumurtası · taze IVF · Birleşik Krallık ulusal ön veri. Kişisel şans tahmini değildir.
                                </p>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-sm">
                                        <thead>
                                            <tr class="border-b border-gray-200/20">
                                                <th class="text-left py-2 pr-4 font-semibold text-gray-600">Kadın yaşı</th>
                                                <th class="text-left py-2 pr-4 font-semibold text-gray-600">Canlı doğum oranı</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="border-b border-gray-200">
                                                <td class="py-2 pr-4 font-semibold text-gray-900">18–34</td>
                                                <td class="py-2 pr-4 text-gray-600">yaklaşık %35</td>
                                            </tr>
                                            <tr class="border-b border-gray-200">
                                                <td class="py-2 pr-4 font-semibold text-gray-900">35–37</td>
                                                <td class="py-2 pr-4 text-gray-600">yaklaşık %26</td>
                                            </tr>
                                            <tr class="border-b border-gray-200">
                                                <td class="py-2 pr-4 font-semibold text-gray-900">38–39</td>
                                                <td class="py-2 pr-4 text-gray-600">yaklaşık %18</td>
                                            </tr>
                                            <tr class="border-b border-gray-200">
                                                <td class="py-2 pr-4 font-semibold text-gray-900">40–42</td>
                                                <td class="py-2 pr-4 text-gray-600">yaklaşık %10</td>
                                            </tr>
                                            <tr>
                                                <td class="py-2 pr-4 font-semibold text-gray-900">43–44</td>
                                                <td class="py-2 pr-4 text-gray-600">yaklaşık %5</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="text-xs text-gray-500 mt-3 mb-0">
                                    Kaynak: <a href="https://www.hfea.gov.uk/about-us/publications/research-and-data/fertility-treatment-2022-preliminary-trends-and-figures/" class="text-primary-700 underline hover:no-underline" rel="noopener noreferrer">HFEA 2022 preliminary trends</a>.
                                    Donör yumurta ve PGT tedavileri bu özetten dışarıdadır.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <figure class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/istatistik/yas_gebelikorani_ivf.webp" alt="Yaşa göre tüp bebek canlı doğum oranları grafiği" width="512" height="512" loading="lazy"/>
                            <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Kritik soru</p>
                                <p class="text-2xl font-headline">Yaş + rezerv</p>
                                <p class="text-[10px] text-gray-600">Oran ancak dosyayla anlam kazanır</p>
                            </div>
                            <figcaption class="mt-4 text-xs text-gray-600 leading-relaxed">
                                HFEA 2022 ön verisi: kendi yumurtası, taze IVF, transfer edilen embriyo başına canlı doğum — 18–34 ≈ %35; 35–37 ≈ %26; 38–39 ≈ %18; 40–42 ≈ %10; 43–44 ≈ %5. Kişisel sonuç rezerv, sperm, rahim ve laboratuvara göre değişir.
                            </figcaption>
                        </figure>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 2: Kümülatif Başarı -->
        <section id="cumulative" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">Birden fazla denemede tüp bebek başarı oranı nasıl artar?</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            Tek transfer oranı ile kümülatif oran aynı şey değildir. Kümülatif bakış, aynı yumurta toplama döngüsünden elde edilen taze ve dondurulmuş embriyoların toplam katkısını anlatır. Uygun hastalarda ikinci ve üçüncü yumurta toplama ile de kümülatif canlı doğum şansı artabilir.
                        </p>
                        <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <h4 class="font-bold text-gray-900 text-sm mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary-600">monitoring</span>
                                Olasılıklar toplanmaz
                            </h4>
                            <p class="text-sm text-gray-600 mb-3">
                                Basit örnek: Her denemede teorik başarı ihtimali %30 olsun. İki denemenin toplamı %60 olmaz. Denemelerin birbirinden bağımsız olduğu basitleştirilmiş modelde en az bir başarı olasılığı yaklaşık %51’dir.
                            </p>
                            <ul class="text-sm text-gray-600 space-y-2 list-disc pl-5 mb-0">
                                <li>Gerçek hayatta IVF denemeleri tamamen bağımsız değildir; yaş, embriyo sayısı ve önceki yanıt sonraki şansı değiştirir.</li>
                                <li>Yeni yumurta toplama ile dondurulmuş embriyo transferi aynı “deneme” değildir.</li>
                                <li>CDC ART çoğu zaman bir yumurta toplama sonrası belirli süre içindeki tüm transferleri birlikte raporlar; bu yüzden HFEA embriyo başına oranlarıyla yan yana konmamalıdır.</li>
                            </ul>
                            <p class="text-xs text-gray-500 mt-3 mb-0">
                                Ayrıntılı çerçeve: <a href="/makaleler/yasa-gore-tup-bebek-basari-oranlari/#kumulatif" class="text-primary-700 underline hover:no-underline">yaşa göre makaledeki kümülatif bölüm</a>.
                            </p>
                        </div>
                        <p class="text-sm text-gray-600">
                            Bu nedenle “kaç döngüye denemeliyim” sorusu tek transfer yüzdesinden değil; eldeki embriyo havuzu, yaş ve her tedaviden sonra yeniden hesaplanan prognoz üzerinden okunmalıdır.
                        </p>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <figure class="relative group">
                        <img class="rounded-2xl shadow-xl w-full" src="/images/library/istatistik/dogurganlik.webp" alt="Birden fazla denemede kümülatif tüp bebek başarı oranları" width="512" height="512" loading="lazy"/>
                        <div class="absolute -bottom-6 -left-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                            <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Kritik ayrım</p>
                            <p class="text-2xl font-headline">Payda</p>
                            <p class="text-[10px] text-gray-600">Tek transfer ≠ kümülatif</p>
                        </div>
                        <figcaption class="mt-4 text-xs text-gray-600 leading-relaxed">
                            Kümülatif canlı doğum, taze ve dondurulmuş transferlerin toplam etkisini anlatır; deneme yüzdeleri aritmetik toplanmaz. CDC kümülatif raporlama ile HFEA embriyo başına oranlar farklı paydalardır.
                        </figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <!-- Section 3: Tedavi Yöntemine Göre Karşılaştırma -->
