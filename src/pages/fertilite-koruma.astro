---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import ReferenceList from '../components/ReferenceList.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import EEATBadge from '../components/EEATBadge.astro';

const references = [
    {
        title: "Clinical outcomes of vitrified-warmed autologous oocyte cycles with 15-year follow-up at a single UK centre",
        authors: "Garratt J, Shah T, Mclaughlin A et al.",
        journal: "RBMO",
        year: 2025,
        doi: "10.1016/j.rbmo.2024.104376"
    },
    {
        title: "Fertility Preservation in People With Cancer: ASCO Guideline Update",
        authors: "Su HI, Lacchetti C, Letourneau J et al.",
        journal: "J Clin Oncol",
        year: 2025,
        doi: "10.1200/JCO-24-02782"
    },
    {
        title: "Live birth rate after female fertility preservation for cancer: a systematic review and meta-analysis",
        authors: "Fraison E, Huberlant S, Labrune E et al.",
        journal: "Human Reproduction",
        year: 2023,
        doi: "10.1093/humrep/deac249"
    },
    {
        title: "Evidence-based outcomes after oocyte cryopreservation for donor oocyte IVF and planned oocyte cryopreservation",
        authors: "ASRM Practice Committee",
        journal: "Fertil Steril",
        year: 2021,
        doi: "10.1016/j.fertnstert.2021.02.024"
    },
    {
        title: "Effect of below-benchmark vitrified/warmed donor-oocyte survival rates",
        authors: "Gallardo M, Goncalves I, Redondo J et al.",
        journal: "Fertil Steril",
        year: 2025,
        doi: "10.1016/j.fertnstert.2024.09.041"
    },
    {
        title: "Prospective solutions to ovarian reserve damage during ovarian tissue cryopreservation and transplantation",
        authors: "Mercier A, Johnson J, Kallen AN",
        journal: "Fertil Steril",
        year: 2024,
        doi: "10.1016/j.fertnstert.2024.08.330"
    },
    {
        title: "Best practices of rapid-cooling vitrification for oocytes and embryos: a committee opinion",
        authors: "ASRM Practice Committee",
        journal: "Fertil Steril",
        year: 2021,
        doi: "10.1016/j.fertnstert.2020.11.017"
    },
    {
        title: "Oocyte vitrification for fertility preservation for both medical and nonmedical reasons",
        authors: "Cobo A, Garcia-Velasco JA, Remohi J, Pellicer A",
        journal: "Fertil Steril",
        year: 2021,
        doi: "10.1016/j.fertnstert.2021.02.006"
    }
];

const faqItems = [
    {
        question: "Yumurta dondurma kaç yaşına kadar yapılabilir?",
        answer: "Teknik bir üst sınır yoktur, ancak başarı oranları 35 yaşından sonra belirgin biçimde düşer. 40 yaş üstünde transfer başına canlı doğum oranı %5–10'a iner. En iyi sonuçlar 35 yaşından önce elde edilir."
    },
    {
        question: "Dondurulmuş yumurtalar ne kadar süre saklanabilir?",
        answer: "Sıvı nitrojende -196°C'de saklanan yumurtalar için 20 yılı aşan güvenli saklama verisi mevcuttur. Düzgün saklama koşullarında biyolojik yaşlanma durmaktadır."
    },
    {
        question: "Yumurta dondurma bebek sağlığını etkiler mi?",
        answer: "Mevcut veriler, dondurulmuş yumurtadan doğan bebeklerde doğumsal anomali riskinin taze yumurtadan farklı olmadığını göstermektedir. Bu konu araştırılmaya devam ediyor."
    },
    {
        question: "Kanser tedavisi acil ise yumurta dondurma için zaman var mı?",
        answer: "Evet. Adet döngüsünün herhangi bir gününde tedaviye başlanabilir. Ortalama 10–14 gün içinde tamamlanır. Hematologunuz veya onkologunuzla koordinasyon şarttır."
    },
    {
        question: "Yumurtalık doku dondurma SGK kapsamında mı?",
        answer: "Tıbbi gerekçe (kanser, üreme hücrelerine zarar veren tedavi) varsa bazı durumlarda kısmi SGK desteği olabilir. Kliniğinizle görüşmenizi öneririz."
    },
    {
        question: "Embriyo dondurma için partner olmak zorunda mıyım?",
        answer: "Türkiye'de evet — embriyo dondurma yasal olarak yalnızca evli çiftlere tanınmıştır. Bekar kadınlar yumurta dondurabilir."
    },
    {
        question: "Sosyal (seçimlik) doğurganlık koruma nedir?",
        answer: "Tıbbi bir neden olmaksızın, ileriki yaşta anne olmak amacıyla yumurta dondurulmasıdır. Türkiye'de yasal olup bireysel karar ve masraftır; SGK kapsamına girmez."
    },
    {
        question: "Kaç yumurta dondurmalıyım?",
        answer: "Yaşa ve rezerve göre değişir. 35 yaş altında 10–15 olgun yumurta iyi bir başarı şansı için genellikle yeterlidir. 35–37 yaşta 15–20, 38–40 yaşta ise 20–25 veya daha fazlası önerilir."
    }
];

const pageTitle = "Fertilite Koruma: Yumurta, Sperm ve Embriyo Dondurma | tupbebek.com";
const pageDescription = "Vitrifikasyon yöntemiyle yumurta, sperm ve embriyo dondurma; kanser hastalarında fertilite koruma (onkofertilite); yumurtalık doku dondurma ve 2025 ASCO kılavuzu güncellemeleri. Doç. Dr. Senai Aksoy tarafından hazırlanmıştır.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <Header />
    <main id="main-content" tabindex="-1" class="pb-24">

        <!-- JSON-LD: MedicalWebPage -->
        <script is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "MedicalWebPage",
            "name": "Fertilite Koruma: Yumurta, Sperm ve Embriyo Dondurma",
            "url": "https://tupbebek.com/fertilite-koruma",
            "description": pageDescription,
            "datePublished": "2026-04-12",
            "dateModified": "2026-04-14",
            "lastReviewed": "2026-04-12",
            "reviewedBy": {
                "@type": "Person",
                "name": "Doç. Dr. Senai Aksoy",
                "jobTitle": "Kadın Hastalıkları ve Doğum Uzmanı, Üreme Tıbbı Uzmanı",
                "url": "https://tupbebek.com/hakkimizda"
            },
            "about": {
                "@type": "MedicalProcedure",
                "name": "Fertilite Koruma — Kriyoprezervasyon (Yumurta, Sperm, Embriyo, Yumurtalık Doku Dondurma)"
            },
            "medicalAudience": {
                "@type": "MedicalAudience",
                "audienceType": "Patient"
            },
            "publisher": {
                "@type": "Organization",
                "name": "tupbebek.com",
                "url": "https://tupbebek.com"
            }
        })} type="application/ld+json" />

        <!-- JSON-LD: FAQPage -->
        <script is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": faqItems.map(item => ({
                "@type": "Question",
                "name": item.question,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": item.answer
                }
            }))
        })} type="application/ld+json" />

        <!-- Hero Section -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-12">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        Akademik Makale
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        Fertilite Koruma: <span class="text-primary-600 italic">Geleceğinizi</span> Güvence Altına Alın
                    </h1>
                    <EEATBadge
                        author="Doç. Dr. Senai Aksoy"
                        authorTitle="Kadın Hastalıkları, Doğum ve Üreme Tıbbı Uzmanı"
                        authorYoutube="https://www.youtube.com/@DocentDrSenaiAksoy"
                        medicalReviewer="tupbebek.com Tıbbi Danışma Kurulu"
                        reviewerTitle="Tıbbi Danışma Kurulu"
                        reviewDate="12 Nisan 2026"
                        lastModified="3 Nisan 2026"
                        status="published"
                        referenceCount={8}
                    />
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl">
                    <img class="w-full h-full object-cover grayscale opacity-80" src="/images/fertilite-koruma/hero.webp" alt="Fertilite koruma — vitrifikasyon ile yumurta, sperm ve embriyo dondurma" width="512" height="512" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <!-- BLUF / Quick Summary -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-12">
            <div class="border-l-4 border-primary bg-primary-50/30 p-6 rounded-r-xl">
                <h2 class="font-bold text-gray-900 mb-3 flex items-center gap-2 text-lg">
                    <span class="material-symbols-outlined text-primary-600">summarize</span>
                    Hızlı Özet
                </h2>
                <p class="text-gray-700 leading-relaxed">
                    <strong>Fertilite koruma (üreme potansiyelini saklama)</strong>, yumurtaların, spermin veya embriyonun ileride kullanılmak üzere dondurularak saklanmasıdır. Vitrifikasyon (ultra hızlı dondurma) sayesinde yumurtalarda çözme sonrası sağkalım oranı %80–97 düzeyine ulaştı. 2025 yılında güncellenen ASCO kılavuzu, kanser hastalarında doğurganlığı korumayı yalnızca tedavi öncesinde değil, tedavi boyunca ve sonrasında da ele alınması gereken bir standart olarak tanımladı. 35 yaşından önce yapılan yumurta dondurma en iyi sonuçları veriyor.
                </p>
            </div>
        </section>

        <!-- Bu yazıda öğrenecekleriniz -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-12">
            <div class="bg-gray-50 p-6 rounded-xl">
                <h2 class="font-bold text-gray-900 mb-4 flex items-center gap-2 text-base">
                    <span class="material-symbols-outlined text-primary-600">list_alt</span>
                    Bu yazıda öğrenecekleriniz
                </h2>
                <ol class="space-y-2 text-sm text-gray-700">
                    <li><a href="#vitrifikasyon" class="hover:text-primary-600 transition-colors">1. Vitrifikasyon nedir, neden önemli?</a></li>
                    <li><a href="#yumurta-dondurma" class="hover:text-primary-600 transition-colors">2. Yumurta dondurma: kimler için, ne zaman?</a></li>
                    <li><a href="#sperm-dondurma" class="hover:text-primary-600 transition-colors">3. Sperm dondurma: hangi durumlarda gerekli?</a></li>
                    <li><a href="#embriyo-dondurma" class="hover:text-primary-600 transition-colors">4. Embriyo dondurma ve dondurulmuş transfer</a></li>
                    <li><a href="#onkofertilite" class="hover:text-primary-600 transition-colors">5. Kanser hastalarında fertilite koruma (Onkofertilite)</a></li>
                    <li><a href="#doku-dondurma" class="hover:text-primary-600 transition-colors">6. Yumurtalık doku dondurma</a></li>
                    <li><a href="#yasal" class="hover:text-primary-600 transition-colors">7. Türkiye'de yasal çerçeve ve SGK</a></li>
                    <li><a href="#sss" class="hover:text-primary-600 transition-colors">8. Sık sorulan sorular</a></li>
                </ol>
            </div>
        </section>

        <!-- Sticky Quick-Nav -->
        <nav id="quick-nav" class="sticky top-20 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm mb-16">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 flex gap-1 overflow-x-auto" style="scrollbar-width: none;">
                <a href="#vitrifikasyon" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">Vitrifikasyon</a>
                <a href="#yumurta-dondurma" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">Yumurta</a>
                <a href="#sperm-dondurma" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">Sperm</a>
                <a href="#embriyo-dondurma" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">Embriyo</a>
                <a href="#onkofertilite" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">Onkofertilite</a>
                <a href="#doku-dondurma" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">Doku</a>
                <a href="#sss" class="quick-nav-link px-4 py-3 text-sm font-semibold text-gray-500 whitespace-nowrap hover:text-primary-600 transition-colors border-b-2 border-transparent">SSS</a>
            </div>
        </nav>

        <!-- Giriş + YouTube -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <h2 class="font-headline text-2xl text-gray-900 mb-6">Giriş: Zamanı Durdurmak Mümkün mü?</h2>
            <div class="space-y-4 text-gray-600 leading-relaxed mb-8">
                <p>Biyolojik saatimiz durmuyor. Kadın doğuştan kaç yumurtayla geliyorsa, ömrü boyunca onları kullanıyor — yenisi üretilmiyor. 35 yaşından sonra bu havuz hem sayı hem kalite olarak hızla azalmaya başlıyor.</p>
                <p>Ama artık zamanı kısmen durdurmanın bir yolu var: vitrifikasyon.</p>
                <p>30 yılı aşkın klinik kariyerimde, Türkiye'de ICSI ve TESE'yi ilk uygulayan ekipler arasında yer aldım. O günden bu yana üreme tıbbında pek çok devrim yaşandı. Vitrifikasyon, yani ultra hızlı dondurma teknolojisi, bu devrimlerin en önemlilerinden biri.</p>
                <p>Bu yazıda doğurganlığı koruma seçeneklerini dürüstçe, güncel bilimsel verilerle ve gerçekçi beklentilerle ele alıyorum.</p>
            </div>
            <YouTubeEmbed id="w29IsrwxHWA" title="Fertilite Koruma: Yumurta ve Embriyo Dondurma — Doç. Dr. Senai Aksoy" />
        </section>

        <!-- Vitrifikasyon -->
        <section id="vitrifikasyon" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <h2 class="font-headline text-3xl text-gray-900 mb-4">Vitrifikasyon Nedir? Neden Bu Kadar Önemli?</h2>
                <p class="text-gray-600 leading-relaxed mb-8">Vitrifikasyon, hücrelerin saniyeler içinde -196°C'ye soğutulduğu ultra hızlı dondurma yöntemidir. Eski yavaş dondurma yönteminin aksine, hücre içinde buz kristali oluşumunu önler. Bu sayede yumurta, sperm ve embriyolar çözüldükten sonra neredeyse hasarsız çıkar.</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                    <!-- Karşılaştırma Tablosu -->
                    <div class="border-l-4 border-primary bg-white p-6 rounded-r-xl shadow-sm">
                        <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary-600">compare_arrows</span>
                            Eski Yöntem vs Vitrifikasyon
                        </h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-gray-200">
                                        <th class="text-left py-2 pr-4 font-semibold text-gray-900">Özellik</th>
                                        <th class="text-left py-2 pr-4 font-semibold text-gray-900">Yavaş Dondurma</th>
                                        <th class="text-left py-2 font-semibold text-gray-900">Vitrifikasyon</th>
                                    </tr>
                                </thead>
                                <tbody class="text-gray-600">
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4">Soğutma hızı</td>
                                        <td class="py-2 pr-4">Saatler</td>
                                        <td class="py-2 font-semibold text-primary-600">Saniyeler</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4">Buz kristali oluşumu</td>
                                        <td class="py-2 pr-4">Olabilir</td>
                                        <td class="py-2 font-semibold text-primary-600">Yok</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4">Yumurta sağkalımı</td>
                                        <td class="py-2 pr-4">%50–70</td>
                                        <td class="py-2 font-semibold text-primary-600">%80–97</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4">Embriyo sağkalımı</td>
                                        <td class="py-2 pr-4">%75–85</td>
                                        <td class="py-2 font-semibold text-primary-600">%95–99</td>
                                    </tr>
                                    <tr>
                                        <td class="py-2 pr-4">Güncel kullanım</td>
                                        <td class="py-2 pr-4 text-gray-400">Terk ediliyor</td>
                                        <td class="py-2 font-semibold text-primary-600">Altın standart</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- İstatistik Kartları -->
                    <div class="space-y-4">
                        <div class="bg-white p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                            <span class="material-symbols-outlined text-primary-600 mb-3">ac_unit</span>
                            <h3 class="font-bold text-sm mb-2">%80–97 Oosit Sağkalım</h3>
                            <p class="text-xs text-gray-600 mb-0">Vitrifikasyon yöntemiyle dondurulmuş yumurtalarda çözme sonrası sağkalım oranı.</p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                            <span class="material-symbols-outlined text-primary-600 mb-3">pregnancy</span>
                            <h3 class="font-bold text-sm mb-2">%95–99 Embriyo Sağkalım</h3>
                            <p class="text-xs text-gray-600 mb-0">Vitrifikasyon sonrası embriyo sağkalım oranı.</p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                            <span class="material-symbols-outlined text-primary-600 mb-3">timer</span>
                            <h3 class="font-bold text-sm mb-2">20+ Yıl Güvenli Saklama</h3>
                            <p class="text-xs text-gray-600 mb-0">Sıvı nitrojen içinde -196°C'de saklanan hücrelerin güvenli saklama süresi.</p>
                        </div>
                    </div>
                </div>

                <p class="text-gray-600 text-sm">Vitrifikasyon bugün dünyanın önde gelen tüp bebek merkezlerinde standart yöntem. Artık yavaş dondurma neredeyse tarih oldu.</p>
            </div>
        </section>

        <!-- Yumurta Dondurma -->
        <section id="yumurta-dondurma" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row gap-16 items-start">
                <div class="md:w-3/5">
                    <h2 class="font-headline text-3xl text-gray-900 mb-4">Yumurta Dondurma: Kimler İçin, Ne Zaman?</h2>
                    <p class="text-gray-600 leading-relaxed mb-8">Yumurta dondurma, kadının olgun yumurtalarının toplanarak vitrifikasyonla saklandığı işlemdir. 35 yaşından önce yapıldığında en iyi sonuçları veriyor. Kanser tedavisi öncesi, endometriozis, erken menopoz aile öyküsü ve kişisel tercihle yapılan sosyal doğurganlık koruması başlıca nedenlerdir.</p>

                    <!-- Yaşa Göre Başarı Tablosu -->
                    <div class="border-l-4 border-primary bg-white p-6 rounded-r-xl shadow-sm mb-6">
                        <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary-600">biotech</span>
                            Yaşa Göre Başarı Oranları
                        </h3>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-gray-200">
                                        <th class="text-left py-2 pr-4 font-semibold text-gray-900">Yaş</th>
                                        <th class="text-left py-2 pr-4 font-semibold text-gray-900">Sağkalım</th>
                                        <th class="text-left py-2 font-semibold text-gray-900">Canlı Doğum/Transfer</th>
                                    </tr>
                                </thead>
                                <tbody class="text-gray-600">
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4 font-semibold">&lt;35</td>
                                        <td class="py-2 pr-4">%90–97</td>
                                        <td class="py-2">%24–30</td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-2 pr-4 font-semibold">35–39</td>
                                        <td class="py-2 pr-4">%85–92</td>
                                        <td class="py-2">%17–20</td>
                                    </tr>
                                    <tr>
                                        <td class="py-2 pr-4 font-semibold">40+</td>
                                        <td class="py-2 pr-4">%75–85</td>
                                        <td class="py-2">%5–10</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-xs text-gray-500 mt-3">Kaynak: Garratt ve ark., RBMO 2025 — 15 yıllık tek merkez verisi</p>
                    </div>

                    <!-- Doktor Notu -->
                    <blockquote class="border-l-4 border-apricot bg-apricot-50/30 p-5 rounded-r-xl mb-6">
                        <p class="text-gray-700 text-sm italic leading-relaxed">"Yumurta dondurma, geleceğe yazılan bir sigorta poliçesidir. Ama her sigorta gibi, ne kadar erken alınırsa o kadar değerli. 35 yaşından sonra yapılan her seans, kapsamı daralan bir poliçe gibi düşünülebilir."</p>
                        <footer class="text-xs text-gray-500 mt-2 font-semibold">— Doç. Dr. Senai Aksoy</footer>
                    </blockquote>

                    <!-- Kaç yumurta -->
                    <div class="border-l-4 border-mint bg-white p-6 rounded-r-xl shadow-sm mb-6">
                        <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
