                                <tr class="border-b border-gray-200">
                                    <td class="py-2 pr-4 font-semibold">Yumurta dondurma</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet</td>
                                    <td class="py-2">Serbest</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="py-2 pr-4 font-semibold">Embriyo dondurma</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet</td>
                                    <td class="py-2 pr-4 text-red-500 font-semibold">Hayır</td>
                                    <td class="py-2">Yalnızca evli çift</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="py-2 pr-4 font-semibold">Sperm dondurma</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet (eş için)</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet</td>
                                    <td class="py-2">Serbest</td>
                                </tr>
                                <tr>
                                    <td class="py-2 pr-4 font-semibold">Yumurtalık doku</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet</td>
                                    <td class="py-2 pr-4 text-mint-600 font-semibold">Evet</td>
                                    <td class="py-2">Tıbbi gerekçeyle</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- SGK Kapsamı -->
                <div class="border-l-4 border-mint bg-white p-6 rounded-r-xl shadow-sm">
                    <h3 class="font-bold text-gray-900 mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-mint-600">health_and_safety</span>
                        SGK Kapsamı
                    </h3>
                    <p class="text-sm text-gray-600">SGK, belirli tıbbi durumlarda (kanser, erken menopoz riski, kalıtsal hastalık) doğurganlığı koruma işlemlerine kısmi destek sağlayabilmektedir. Tıbbi gerekçe olmaksızın yapılan yumurta dondurma SGK kapsamında değildir. Güncel bilgi için kliniğinizle görüşmenizi öneririz.</p>
                </div>
            </div>
        </section>

        <!-- SSS / FAQ -->
        <section id="sss" class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <h2 class="font-headline text-3xl text-gray-900 mb-8">Sık Sorulan Sorular</h2>
            <div class="space-y-3">
                {faqItems.map((item) => (
                    <details class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                        <summary class="flex items-center justify-between cursor-pointer p-5 text-gray-900 font-semibold text-sm hover:bg-gray-50 transition-colors">
                            <span>{item.question}</span>
                            <span class="material-symbols-outlined text-primary-600 transition-transform group-open:rotate-180 shrink-0 ml-4">expand_more</span>
                        </summary>
                        <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed">
                            <p>{item.answer}</p>
                        </div>
                    </details>
                ))}
            </div>
