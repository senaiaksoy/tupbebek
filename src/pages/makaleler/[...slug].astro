---
import { getCollection } from 'astro:content';
import { sanitizeImage } from '../../utils/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleReviewInfo from '../../components/ArticleReviewInfo.astro';
import EEATBadge from '../../components/EEATBadge.astro';
import EvidenceGradeCard from '../../components/EvidenceGradeCard.astro';
import ReferenceList from '../../components/ReferenceList.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import DoctorNote from '../../components/global/DoctorNote.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { resolveCanonicalUrl, resolveSiteUrl } from '../../utils/seo';
import { getArticleHub } from '../../utils/articleHub';
import { getResponsiveImageSrcSet, resolveImageDimensions } from '../../utils/imageMetadata';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const publishable = articles.filter(entry => entry.data.status === 'published');
  return publishable.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Resolve author identity without rewriting an editorial-board author as a physician.
const DEFAULT_AUTHOR_TITLE = 'Kadın Hastalıkları ve Doğum Uzmanı';
const DEFAULT_AUTHOR_CREDENTIALS = 'Üreme Tıbbı ve Yardımcı Üreme Teknikleri';
const DEFAULT_AUTHOR_YOUTUBE = 'https://www.youtube.com/@DocentDrSenaiAksoy';

const rawAuthorName = typeof entry.data.author === 'string'
    ? entry.data.author
    : entry.data.author?.name;
const rawAuthorTitle = typeof entry.data.author === 'string'
    ? entry.data.authorTitle
    : entry.data.author?.title;
const rawAuthorCredentials = typeof entry.data.author === 'string'
    ? entry.data.authorCredentials
    : entry.data.author?.credentials;
const rawAuthorUrl = typeof entry.data.author === 'string'
    ? undefined
    : entry.data.author?.url;

const isSenaiAksoy = /senai\s+aksoy/i.test(rawAuthorName || '');
const authorName = rawAuthorName;
const authorTitle = rawAuthorTitle || (isSenaiAksoy ? DEFAULT_AUTHOR_TITLE : undefined);
const authorCredentials = rawAuthorCredentials || (isSenaiAksoy ? DEFAULT_AUTHOR_CREDENTIALS : undefined);
const authorYoutube =
    entry.data.authorYoutube
    || (rawAuthorUrl && /youtube\.com/i.test(rawAuthorUrl) ? rawAuthorUrl : undefined)
    || (isSenaiAksoy ? DEFAULT_AUTHOR_YOUTUBE : undefined);
const authorProfileUrl = isSenaiAksoy
    ? '/yazar/senai-aksoy/'
    : (rawAuthorUrl && !/youtube\.com/i.test(rawAuthorUrl) ? rawAuthorUrl : undefined);

const lastModifiedStr = entry.data.lastModified
    ? entry.data.lastModified.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })
    : undefined;
const reviewDateStr = entry.data.reviewDate
    ? entry.data.reviewDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })
    : undefined;
const siteUrl = resolveSiteUrl(Astro.site);
const articleUrl = resolveCanonicalUrl({
    siteUrl,
    pathname: `/makaleler/${entry.slug}/`,
    canonical: entry.data.canonical,
});
const sanitizedImage = sanitizeImage(entry.data.image);
const articleHub = getArticleHub(entry.slug);
const isEditorColumn = entry.data.contentType === 'editor_column';
const imageSourceLabels = {
    original: 'Özgün görsel',
    licensed: 'Lisanslı görsel',
    'ai-assisted': 'AI destekli görsel',
} as const;
const imageSourceLabel = entry.data.imageSourceType
    ? imageSourceLabels[entry.data.imageSourceType]
    : undefined;

// Hero görsel boyutları: frontmatter override > disk metadata > 1600x900 fallback.
// Schema/OG/img intrinsic boyutları aynı kaynaktan beslenir — tutarlılık garanti.
const heroDimensions = resolveImageDimensions({
    image: sanitizedImage,
    frontmatterWidth: entry.data.imageWidth,
    frontmatterHeight: entry.data.imageHeight,
});
const heroSrcSet = getResponsiveImageSrcSet(sanitizedImage);
---

<BaseLayout
    title={`${entry.data.seoTitle || entry.data.title} | tupbebek.com`}
    description={entry.data.description}
    image={sanitizedImage}
    imageAlt={entry.data.imageAlt || entry.data.title}
    imageSrcSet={heroSrcSet}
    imageSizes="(min-width: 1024px) 768px, 100vw"
    imageWidth={entry.data.image ? heroDimensions.width : undefined}
    imageHeight={entry.data.image ? heroDimensions.height : undefined}
    ogType="article"
    pageType="MedicalWebPage"
    canonical={articleUrl}
    noindex={entry.data.noindex}
>
    <Header />
    <ReadingProgress />

    <!-- Article-specific JSON-LD -->
    <ArticleSchema entry={entry} url={articleUrl} />

    <main id="main-content" tabindex="-1" class="pt-32 pb-24">
        <!-- Full-width article header -->
        <div class="max-w-3xl mx-auto px-4 md:px-6">
            <header class="mb-8">
                {isEditorColumn && (
                    <a
                        href="/bas-editor-kosesi/"
                        class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary-700 hover:text-primary-900"
                    >
                        <span>Baş Editör Köşesi</span>
                        <span aria-hidden="true">·</span>
                        <span>İmzalı perspektif</span>
                    </a>
                )}

                <!-- Title -->
                <h1 class="font-serif text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-gray-900 leading-[1.18] mb-5">
                    {entry.data.title}
                </h1>

                <!-- Description -->
                {!entry.data.summary && entry.data.description && (
                    <p class="text-lg text-gray-500 leading-relaxed mb-8">{entry.data.description}</p>
                )}

                <!-- Yazar ve tıbbi inceleme -->
                <EEATBadge
                    author={authorName}
                    authorTitle={authorTitle}
                    authorCredentials={authorCredentials}
                    authorUrl={authorProfileUrl}
                    authorYoutube={authorYoutube}
                    medicalReviewer={entry.data.medicalReviewer}
                    reviewerTitle={entry.data.reviewerTitle}
                    reviewType={entry.data.reviewType}
                    reviewDate={reviewDateStr}
                    lastModified={lastModifiedStr}
                />

                {entry.data.summary && (
                    <section class="mt-5 border-l-4 border-primary-500 bg-primary-50/60 px-5 py-4" aria-labelledby="article-summary-title">
                        <h2 id="article-summary-title" class="text-sm font-bold text-primary-900 uppercase tracking-wider mb-2">
                            {isEditorColumn ? 'Baş editörün notu' : 'Kısa cevap'}
                        </h2>
                        <p class="text-sm md:text-base text-gray-700 leading-relaxed">{entry.data.summary}</p>
                        {entry.data.summaryReferences && entry.data.summaryReferences.length > 0 && (
                            <p class="mt-3 text-xs md:text-sm text-gray-600 leading-relaxed">
                                <span class="font-semibold text-gray-700">Başlıca kaynaklar:</span>{' '}
                                {entry.data.summaryReferences.map((source, index) => (
                                    <>
                                        {index > 0 && <span aria-hidden="true"> · </span>}
                                        <a
                                            href={source.url}
                                            class="font-semibold text-primary-700 underline underline-offset-2 hover:text-primary-900"
                                            rel="noopener noreferrer"
                                        >
                                            {source.title}
                                        </a>
                                    </>
                                ))}
                            </p>
                        )}
                    </section>
                )}

                {!entry.data.hideEvidenceGrade && entry.data.recommendationGrade && (
                    <EvidenceGradeCard grade={entry.data.recommendationGrade} />
                )}

                <!-- Hero Image — başlık, kimlik ve kısa cevaptan sonra -->
                {entry.data.image && (
                    <figure class="mt-6 mb-0">
                        <div class="aspect-video overflow-hidden rounded-xl border border-gray-100">
                            <img
                                src={sanitizedImage}
                                alt={entry.data.imageAlt || entry.data.title}
                                class="w-full h-full object-cover"
                                width={heroDimensions.width}
                                height={heroDimensions.height}
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                srcset={heroSrcSet}
                                sizes="(min-width: 1024px) 768px, 100vw"
                            />
                        </div>
                        {(entry.data.imageCaption || entry.data.imageCredit || imageSourceLabel) && (
                            <figcaption class="mt-2 text-xs leading-relaxed text-gray-500">
                                {entry.data.imageCaption && <span>{entry.data.imageCaption}</span>}
                                {entry.data.imageCaption && (entry.data.imageCredit || imageSourceLabel) && <span aria-hidden="true"> · </span>}
                                {(entry.data.imageCredit || imageSourceLabel) && (
                                    <span>
                                        {entry.data.imageCredit && <>Görsel: {entry.data.imageCredit}</>}
                                        {entry.data.imageCredit && imageSourceLabel && <span aria-hidden="true"> · </span>}
                                        {imageSourceLabel}
                                    </span>
                                )}
                            </figcaption>
                        )}
                    </figure>
                )}

            </header>

            <!-- Video Embed (if article has videoId) -->
            {entry.data.videoId && (
                <YouTubeEmbed
                    id={entry.data.videoId}
                    title={entry.data.videoTitle || entry.data.title}
                    caption={entry.data.videoDescription}
                />
            )}
        </div>

        <!-- Two-column layout: Content + Sidebar -->
        <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
            <div class="lg:grid lg:grid-cols-[minmax(0,_3fr)_minmax(220px,_1fr)] lg:gap-12 xl:gap-16">

                <!-- Main Content Column -->
                <article class="max-w-3xl" data-pagefind-body>
                    <div class="hidden" data-pagefind-meta={`image:${sanitizedImage}`}></div>
                    <div class="hidden" data-pagefind-meta={`category:${entry.data.category || ''}`}></div>
                    <TableOfContents headings={headings} variant="mobile" />
                    <!-- Article Content — prose -->
                    <div class="prose-medical">
                        <Content />
                    </div>

                    {entry.data.expertContribution && entry.data.expertContribution.approvalStatus === 'approved' && (
                        <DoctorNote
                          title={entry.data.expertContribution.title}
                          topic={entry.data.category}
                          question={entry.data.expertContribution.question}
                          note={entry.data.expertContribution.text}
                          evidenceNote={entry.data.expertContribution.evidenceNote}
                          author={entry.data.expertContribution.author}
                          authorTitle={entry.data.expertContribution.authorTitle}
                          authorUrl={entry.data.expertContribution.authorUrl}
                          answeredAt={entry.data.expertContribution.answeredAt}
                        />
                    )}

                    <ArticleReviewInfo
                        evidenceAsOf={entry.data.evidenceAsOf}
                        reviewScope={entry.data.reviewScope}
                        editorialMethodNote={entry.data.editorialMethodNote}
                        reviewType={entry.data.reviewType}
                    />

                    <nav class="mt-5 text-sm leading-relaxed text-gray-600" aria-label="Konu merkezi">
                        <span>Bu konuyla ilgili diğer başlıklar: </span>
                        <a href={articleHub.href} class="font-semibold text-primary-700 underline underline-offset-2 hover:text-primary-900">
                            {articleHub.label}
                        </a>
                        <span class="sr-only"> — {articleHub.description}</span>
                    </nav>

                    <!-- Scientific References -->
                    {entry.data.references && (
                        <ReferenceList references={entry.data.references} />
                    )}

                    <!-- Share Buttons -->
                    <div class="mt-10 pt-8 border-t border-gray-200">
                        <ShareButtons title={entry.data.title} url={articleUrl} />
                    </div>

                    <!-- Medical Disclaimer -->
                    <div class="mt-8">
                        <MedicalDisclaimer reviewType={entry.data.reviewType} />
                    </div>
                </article>

                <!-- Sidebar Column (sticky) -->
                <aside class="hidden lg:block">
                    <div class="sticky top-28 space-y-8 max-h-[calc(100vh-8rem)] overflow-y-auto">
                        <!-- Table of Contents -->
                        <TableOfContents headings={headings} variant="desktop" />

                        <!-- Sidebar Related Articles -->
                        <div class="pt-6 border-t border-gray-200">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">İlgili Makaleler</p>
                            <RelatedArticles currentSlug={entry.slug} category={entry.data.category} variant="sidebar" />
                        </div>
                    </div>
                </aside>
            </div>
        </div>

        <!-- Mobile Related Articles (below content) -->
        <div class="lg:hidden max-w-3xl mx-auto px-4 md:px-6 mt-14">
            <RelatedArticles currentSlug={entry.slug} category={entry.data.category} />
        </div>
    </main>

    <Footer />
</BaseLayout>
