---
import Title from "@components/Title.astro";
import Layout from "@layouts/Layout.astro";
import styles from "@styles/videos.module.scss";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const posts = (await getCollection("videos")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Videolar"
  description="Dr. Senai Aksoy tüp bebek tedavisi, aşamaları ve bağlantılı konularda bilgilerini sizlerle paylaşıyor."
>
  <div class={styles.videos}>
    <header class={styles.header}>
      <Title size="large">Videolar</Title>
    </header>

    <div class={styles.posts}>
      {
        posts.map((post) => (
          <article>
            <a href={`/videolar/${post.slug}`}>
              <div class={styles.image}>
                <Image
                  src={`https://img.youtube.com/vi/${post.data.id}/0.jpg`}
                  width={480}
                  height={360}
                  alt={post.data.title}
                />
              </div>

              <Title size="big">{post.data.title}</Title>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
