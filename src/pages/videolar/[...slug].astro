---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Title from "@components/Title.astro";
import Video from "@components/Video.astro";
import Icon from "@icons/index.astro";
import Layout from "@layouts/Layout.astro";
import styles from "@styles/article.module.scss";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const blogEntries = await getCollection("videos");
  return blogEntries.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const videoSource = `https://www.youtube.com/embed/${post.data.id}`;
---

<Layout title={post.data.title} description={post.data.description}>
  <article class={styles.article}>
    <header class={styles.header}>
      <Breadcrumbs>
        <a href="/videolar/"
          ><Icon name="arrowLeft" size="small" /> Tüm videolar</a
        >
      </Breadcrumbs>
      <Title size="large">
        {post.data.title}
      </Title>
    </header>

    <Video id={post.data.id} />

    <p>{post.data.description}</p>
  </article>
</Layout>
