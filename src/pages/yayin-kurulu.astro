  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#editorial-board`,
      name: 'tupbebek.com Tıbbi Yayın Kurulu',
      numberOfItems: boardMembers.length,
      itemListOrder: 'https://schema.org/ItemListUnordered',
      itemListElement: boardMembers.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@id': `${pageUrl}#${memberSlug(m.name)}` },
      })),
    },
    ...personNodes,
  ],
};

const isEditor = (member: (typeof boardMembers)[number]) =>
  member.role.toLocaleLowerCase('tr').includes('edit');

const editorMember = boardMembers.find((member) => isEditor(member));

const sortedBoardMembers = boardMembers
  .filter((member) => !isEditor(member))
  .sort((a, b) => {
    const getGroupOrder = (member: (typeof boardMembers)[number]) => {
      const name = member.name.toLocaleLowerCase('tr');
      const title = member.title.toLocaleLowerCase('tr');

      const isProfessor = name.startsWith('prof.');
      if (isProfessor) return 1;

      const isAssociateProfessor = name.startsWith('doç.') || name.startsWith('doã§.');
      if (isAssociateProfessor) return 2;

      const isEmbryologist = title.includes('embriyolog') || title.includes('embriyoloji');
      const isSpecialistDoctor = (name.startsWith('dr.') || title.includes('uzman')) && !isEmbryologist;
      if (isSpecialistDoctor) return 3;

      if (isEmbryologist) return 4;

      return 5;
    };

    const groupCompare = getGroupOrder(a) - getGroupOrder(b);
    if (groupCompare !== 0) {
      return groupCompare;
    }

    return getLastName(a.name).localeCompare(getLastName(b.name), 'tr');
  });
