const getLastName = (name: string) => {
  const parts = name.trim().split(/\s+/);
  return parts[parts.length - 1] ?? name;
};

// Slug-safe id for each board member (used as schema @id fragment + DOM anchor)
const memberSlug = (name: string) =>
  name
    .toLocaleLowerCase('tr')
    .replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i')
    .replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Heuristic: derive knowsAbout topics from jobTitle
const knowsAboutFor = (title: string): string[] => {
  const t = title.toLocaleLowerCase('tr');
  const topics: string[] = [];
  if (t.includes('üreme') || t.includes('infertil') || t.includes('tüp bebek') || t.includes('yardımcı üreme')) {
    topics.push('Üreme Tıbbı', 'İnfertilite', 'Tüp Bebek (İVF)');
  }
  if (t.includes('kadın hastalıkları') || t.includes('doğum')) topics.push('Kadın Hastalıkları ve Doğum');
  if (t.includes('endokrinol')) topics.push('Endokrinoloji');
  if (t.includes('embriy')) topics.push('Embriyoloji', 'Embriyo Kültürü', 'Vitrifikasyon');
  if (t.includes('üroloj') || t.includes('androl') || t.includes('erkek üreme')) topics.push('Üroloji', 'Erkek Üreme Sağlığı');
  if (t.includes('kardiyoloj')) topics.push('Kardiyoloji');
  if (t.includes('hukuk')) topics.push('Sağlık Hukuku', 'ÜYTE Mevzuatı', 'KVKK');
  if (t.includes('fizyoter')) topics.push('Fizyoterapi', 'Pelvik Rehabilitasyon');
  return topics.length ? topics : ['Üreme Sağlığı'];
};

// Short bio for schema description — first ~280 chars, no markdown
const shortBio = (bio: string): string =>
  bio.length <= 280 ? bio : bio.slice(0, 277).replace(/\s+\S*$/, '') + '...';

const pageUrl = 'https://tupbebek.com/yayin-kurulu/';
const orgId = 'https://tupbebek.com/#organization';

// Build Person nodes + ItemList wrapper
const personNodes = boardMembers.map((m) => ({
  '@type': 'Person',
  '@id': `${pageUrl}#${memberSlug(m.name)}`,
  name: m.name,
  jobTitle: m.title,
  description: shortBio(m.bio),
  knowsAbout: knowsAboutFor(m.title),
  memberOf: { '@id': orgId },
  affiliation: { '@id': orgId },
}));

