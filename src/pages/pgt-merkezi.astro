---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HizliCevap from '../components/HizliCevap.astro';
import QuoteBlock from '../components/global/QuoteBlock.astro';
import { buildHubItemListSchema } from '../utils/hubStructuredData';

// FAQPage JSON-LD — AI motorlarının (AI Overviews, ChatGPT, Perplexity) "pgt nedir"
// sorgusunda alıntılayabilmesi için yapılandırılmış Q&A. Yanıtlar ASRM 2024 komite
// görüşü ve Yan 2021 (NEJM) RKÇ ile uyumlu; PGT-A faydası abartılmadan çerçevelendi.
const pgtFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "PGT (preimplantasyon genetik test) nedir?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PGT, tüp bebek (IVF) sürecinde elde edilen embriyolardan transfer öncesi alınan birkaç hücrenin (trofektoderm biyopsisi) genetik olarak analiz edilmesidir. Üç tipi vardır: kromozom sayısını tarayan PGT-A, tek gen hastalıklarını tarayan PGT-M ve yapısal kromozom rearanjmanlarını tarayan PGT-SR."
      }
    },
    {
      "@type": "Question",
      "name": "PGT-A, PGT-M ve PGT-SR arasındaki fark nedir?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PGT-A embriyodaki kromozom sayısı anormalliklerini (aneuploidi) tarar; en sık ileri yaş, tekrarlayan düşük ve başarısız IVF denemelerinde gündeme gelir. PGT-M kistik fibrozis, SMA veya talasemi gibi tek gen kaynaklı kalıtsal hastalıkları tarar. PGT-SR ise translokasyon veya inversiyon gibi yapısal kromozom rearanjmanı taşıyıcılarında dengeli embriyoyu belirlemek için kullanılır."
      }
    },
    {
      "@type": "Question",
      "name": "PGT-A tüp bebekte canlı doğum oranını artırır mı?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Genel ve iyi prognozlu hasta grubunda artırmaz. Çok merkezli randomize kontrollü çalışmalar (Yan 2021, NEJM) ve ASRM 2024 komite görüşü, PGT-A ile konvansiyonel IVF arasında kümülatif canlı doğum oranının benzer olduğunu bildirir. PGT-A seçilmiş gruplarda (ileri yaş, tekrarlayan düşük veya implantasyon başarısızlığı) transfer başına gebelik şansını ve düşük oranını iyileştirebilir; rutin bir tarama testi değildir."
      }
    },
    {
      "@type": "Question",
      "name": "PGT kimlere önerilir?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Karar kişiye özeldir. PGT-A daha çok ileri kadın yaşı, tekrarlayan gebelik kaybı veya tekrarlayan implantasyon başarısızlığında değerlendirilir. PGT-M ailede bilinen tek gen hastalığı taşıyıcılığında, PGT-SR ise yapısal kromozom rearanjmanı taşıyıcılığında önerilir. Endikasyon, hekim değerlendirmesi ve genetik danışmanlıkla birlikte belirlenir."
      }
    },
    {
      "@type": "Question",
      "name": "PGT ile NİPT arasındaki fark nedir?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PGT, embriyo seviyesinde, gebelik öncesinde biyopsi ile yapılır. NİPT (non-invaziv prenatal test) ise gebelik sırasında annenin kanından alınan DNA ile yapılan bir tarama testidir ve kesin tanı değildir. İkisi farklı aşamalarda kullanılır ve aynı hastaya sırayla uygulanabilir."
      }
    },
    {
      "@type": "Question",
      "name": "Türkiye'de cinsiyet seçimi amacıyla PGT yapılabilir mi?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hayır. Türkiye'de tıbbi gerekçesi olmayan (sosyal) cinsiyet seçimi yasaktır. PGT yalnızca ciddi genetik hastalıkların önlenmesi gibi tıbbi endikasyonlarla, Sağlık Bakanlığı düzenlemeleri çerçevesinde uygulanabilir."
      }
    }
  ]
};

const pgtHubLinks = [
  {
    href: '/makaleler/pgt-a-bas-editor-kosesi/',
    title: 'PGT-A rehberi',
    description: 'Aneuploidi taraması, mozaiklik, transfer başına ve kümülatif başarı beklentisi.'
  },
  {
    href: '/makaleler/pgt-m/',
    title: 'PGT-M tek gen rehberi',
    description: 'SMA, talasemi ve kalıtsal hastalık riski için hedefli embriyo testi.'
  },
  {
    href: '/makaleler/pgt-cinsiyet-secimi/',
    title: 'PGT ve cinsiyet seçimi',
    description: 'Türkiye mevzuatı, etik sınırlar ve tıbbi endikasyon dışı seçimin neden yapılamadığı.'
  },
  {
    href: '/genetik-testler/',
    title: 'Genetik testler',
    description: 'Karyotip, taşıyıcılık taraması ve çift düzeyinde genetik değerlendirme.'
  },
  {
    href: '/basari-oranlari/',
    title: 'Başarı oranları',
    description: 'PGT, yaş ve embriyo sayısı kararlarının başarı oranlarıyla birlikte yorumlanması.'
  }
];

const itemListSchema = buildHubItemListSchema({
  site: Astro.site,
  pagePath: '/pgt-merkezi/',
  name: 'PGT merkezi konu haritası',
  description: 'PGT-A, PGT-M, PGT ve cinsiyet seçimi, çift genetik testleri ve başarı oranları arasındaki okuma yolu.',
  items: pgtHubLinks
});
---

<BaseLayout title="PGT Nedir? PGT-A, PGT-M ve PGT-SR Rehberi | tupbebek.com" description="PGT (preimplantasyon genetik test) nedir? PGT-A, PGT-M ve PGT-SR farkları, endikasyonları, sınırlamaları ve Türkiye'deki yasal çerçeve hakkında kanıta dayalı rehber.">
    <Header />

    <main id="main-content" tabindex="-1" class="pb-24">
        <!-- Hero Section -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-20">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        Akademik Makale
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        PGT Nedir? <span class="text-primary-600 italic">Preimplantasyon Genetik Test</span> Rehberi
                    </h1>
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border-l-4 border-primary">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200">
                            <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                        </div>
                        <div>
                            <p class="font-headline italic text-gray-900 text-sm">İnceleme:</p>
                            <p class="font-bold text-primary-600">Yayın Kurulu</p>
                            <p class="text-xs text-gray-500 mt-1">Son güncelleme: 11 Temmuz 2026</p>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl">
                    <img class="w-full h-full object-cover grayscale opacity-80" src="/images/library/embriyo/pgt_sex.webp" alt="Genetik analiz" width="512" height="512" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <!-- BLUF / Hızlı Cevap — AI Overview / ChatGPT / Perplexity citability -->
        <div class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <HizliCevap question="PGT (preimplantasyon genetik test) nedir?">
            PGT, tüp bebek (IVF) sürecinde elde edilen embriyolardan transfer öncesi alınan birkaç hücrenin (trofektoderm biyopsisi) genetik analizidir. Üç tipi vardır: kromozom sayısını tarayan <strong>PGT-A</strong>, tek gen hastalıklarını tarayan <a href="/makaleler/pgt-m/" class="font-semibold text-primary-700 underline hover:no-underline">PGT-M</a> ve yapısal kromozom rearanjmanlarını tarayan <strong>PGT-SR</strong>. PGT-A öploid (kromozomal olarak normal) embriyoyu seçer; seçilmiş gruplarda transfer başına gebelik şansını ve düşük oranını iyileştirebilir, ancak genel ve iyi prognozlu hastalarda kümülatif canlı doğum oranını artırmadığı çok merkezli randomize çalışmalarda gösterilmiştir (<a href="https://pubmed.ncbi.nlm.nih.gov/38762806/">ASRM 2024</a>; <a href="https://pubmed.ncbi.nlm.nih.gov/34818479/">Yan 2021, NEJM</a>). Bu nedenle PGT-A rutin bir “başarı artırma” testi değil; yaş, embriyo sayısı, genetik risk ve önceki öyküye göre değerlendirilen bir karar aracıdır.
            </HizliCevap>
        </div>

        <!-- Scientific Introduction -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <aside class="mb-10 rounded-2xl border border-primary-100 bg-primary-50/70 p-5 text-sm leading-relaxed text-gray-700" aria-label="Sayfa kapsamı">
                <strong class="block text-primary-900 mb-2">Bu sayfa: embriyoya uygulanan preimplantasyon genetik testler (PGT-A, PGT-M, PGT-SR).</strong>
                PGT-M özelinde tek gen hastalıkları, prob hazırlığı ve Türkiye'deki yasal çerçeve için <a href="/makaleler/pgt-m/" class="text-primary-700 underline hover:no-underline">PGT-M rehberini</a>; çiftin kendisinde uygulanan kromozomal/taşıyıcı testler (karyotip, Y-mikrodelezyon, CFTR, talasemi) için <a href="/genetik-testler/" class="text-primary-700 underline hover:no-underline">Genetik Testler</a> sayfasını inceleyebilirsiniz.
            </aside>
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-body italic mb-12">
                PGT en sık "Embriyoyu daha sağlıklı seçebilir miyiz?" sorusuyla gündeme gelir. Güvenli cevap şudur: PGT tek bir test değildir ve herkese aynı nedenle önerilmez. Kimi zaman kromozom sayısını taramak, kimi zaman ailede bilinen tek gen hastalığını ayırt etmek, kimi zaman da yapısal kromozom taşıyıcılığı olan çiftlerde riski daha doğru okumak için kullanılır. Seçilmiş endikasyonlarda transfer başına gebelik şansını ve düşük oranını iyileştirebilir; ancak rutin kullanımda kümülatif canlı doğum oranını artırdığı gösterilmemiştir (ASRM 2024; Yan 2021, NEJM).
            </p>
            <QuoteBlock author="Doç. Dr. Senai Aksoy">
                PGT'nin değeri daha çok test yapmakta değil; doğru soruya doğru testi seçmekte yatar.
            </QuoteBlock>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">science</span>
                    <p class="font-bold text-sm mb-2">%98+</p>
                    <p class="text-xs text-gray-600 mb-0">PGT-A doğruluk oranı (aneuploidi)</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">biotech</span>
                    <p class="font-bold text-sm mb-2">2-3 gün</p>
                    <p class="text-xs text-gray-600 mb-0">Biyopsiden sonra sonuç zamanı</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-xl shadow-sm border-t-2 border-primary-200">
                    <span class="material-symbols-outlined text-primary-600 mb-3">monitoring</span>
                    <p class="font-bold text-sm mb-2">ESHRE</p>
                    <p class="text-xs text-gray-600 mb-0">Avrupa Üreme Tıbbı standartları</p>
                </div>
            </div>
        </section>

        <!-- Quick-Nav Bar -->
        <nav id="quick-nav" class="sticky top-20 z-40 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm mb-16">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 overflow-x-auto whitespace-nowrap">
                <div class="flex items-center gap-1 py-3">
                    <a href="#pgt-a" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">PGT-A</a>
                    <a href="#pgt-m" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">PGT-M</a>
                    <a href="#pgt-sr" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">PGT-SR</a>
                    <a href="#nipt" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">NİPT Farkı</a>
                    <a href="#sinirlamalar" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">Sınırlamalar</a>
                    <a href="#sss" class="quick-nav-link px-4 py-2 text-sm font-semibold text-gray-500 hover:text-primary-600 rounded-lg transition-colors shrink-0">SSS</a>
                </div>
            </div>
        </nav>

        <!-- Section 1: PGT Nedir? -->
        <section id="pgt-nedir" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">1. PGT Nedir?</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                PGT, embriyodan alınan birkaç hücrenin genetik olarak incelenmesidir. Bu işlem genellikle blastokist evresinde, embriyonun dış hücre tabakasından (trofektoderm) biyopsi alınarak yapılır. Amaç "mükemmel embriyoyu" bulmak değil; belirli bir genetik soruya daha doğru yanıt verebilmektir.
                            </p>
                            <p>
                                PGT-A, embriyolar arasında kromozom sayısı normal görünenleri belirlemeye çalışır. Bu bilgi özellikle ileri yaş, tekrarlayan düşük veya önceki başarısız denemeler gibi seçilmiş durumlarda klinik karar vermeyi kolaylaştırabilir. Yine de modern NGS (Next Generation Sequencing) ile bildirilen %98-99 analitik doğruluk, canlı doğum garantisi anlamına gelmez; test sonucu her zaman hastanın yaşı, embriyo sayısı ve önceki öyküsüyle birlikte yorumlanır.
                            </p>
                            <!-- Clinical Info Box -->
                            <div class="bg-white border-l-4 border-primary rounded-xl p-6 mrd-container">
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="material-symbols-outlined text-primary-600 text-lg">biotech</span>
                                    <span class="text-sm font-semibold uppercase tracking-wide text-primary-600">Klinik Bilgi</span>
                                </div>
                                <h3 class="font-bold text-gray-900 text-sm mb-3">PGT Türleri ve Uygulama Alanları</h3>
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="border-b border-gray-200/20">
                                            <th class="text-left py-2 pr-4 font-semibold text-gray-600">Test</th>
                                            <th class="text-left py-2 pr-4 font-semibold text-gray-600">Hedef</th>
                                            <th class="text-left py-2 pr-4 font-semibold text-gray-600">Endikasyon</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="border-b border-gray-200">
                                            <td class="py-2 pr-4 font-mono font-bold text-primary-600">PGT-A</td>
                                            <td class="py-2 pr-4 text-gray-600">Kromozomal aneuploidi</td>
                                            <td class="py-2 pr-4 text-gray-600">Yaş, tekrarlayan düşük, başarısız IVF</td>
                                        </tr>
                                        <tr class="border-b border-gray-200">
                                            <td class="py-2 pr-4 font-mono font-bold text-primary-600">PGT-M</td>
                                            <td class="py-2 pr-4 text-gray-600">Monogenik hastalık</td>
                                            <td class="py-2 pr-4 text-gray-600">Kalıtsal genetik bozukluk</td>
                                        </tr>
                                        <tr>
                                            <td class="py-2 pr-4 font-mono font-bold text-primary-600">PGT-SR</td>
                                            <td class="py-2 pr-4 text-gray-600">Yapısal rearanjman</td>
                                            <td class="py-2 pr-4 text-gray-600">Translokasyon/inversiyon taşıyıcılığı</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p class="text-xs text-gray-600 mt-3">Kaynak: ESHRE Guideline, 2022</p>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <div class="relative group">
                            <img class="rounded-2xl shadow-xl w-full" src="/images/library/embriyo/pgt.webp" alt="PGT genetik analiz" width="512" height="512" loading="lazy"/>
                            <div class="absolute -bottom-6 -right-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                                <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Doğruluk</p>
                                <p class="text-2xl font-headline">%98-99</p>
                                <p class="text-[10px] text-gray-600">NGS ile PGT-A doğruluğu</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 2: PGT-A -->
        <section id="pgt-a" class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <div class="flex flex-col md:flex-row-reverse gap-16 items-center">
                <div class="md:w-1/2">
                    <h2 class="font-headline text-3xl text-gray-900 mb-6">2. PGT-A (Aneuploidi Taraması)</h2>
                    <div class="space-y-6 text-gray-600">
                        <p>
                            PGT-A, embriyodaki kromozom sayısı fazlalığı veya eksikliğini (aneuploidi) tarar. Normal insan hücrelerinde 23 çift kromozom bulunur; embriyoda kromozom sayısının eksik ya da fazla olması tutunma şansını azaltabilir, düşük riskini artırabilir veya gebeliğin hiç başlamamasına yol açabilir.
                        </p>
                        <p>
                            Yaş ilerledikçe yumurtalarda kromozomal hata olasılığı artar. Bu nedenle PGT-A özellikle ileri yaşta ya da tekrarlayan kayıp öyküsünde gündeme gelebilir. Buradaki amaç her hastaya test eklemek değil, transfer edilecek embriyoyu seçerken belirsizliği azaltmaktır.
                        </p>
                        <!-- Clinical Info Box -->
                        <div class="bg-gray-50 border-l-4 border-primary rounded-xl p-6 mrd-container">
                            <div class="flex items-center gap-2 mb-4">
                                <span class="material-symbols-outlined text-primary-600 text-lg">biotech</span>
                                <span class="text-sm font-semibold uppercase tracking-wide text-primary-600">Klinik Bilgi</span>
                            </div>
                            <h3 class="font-bold text-gray-900 text-sm mb-3">Yaş Grubuna Göre Aneuploidi Oranları</h3>
                            <div class="space-y-4 text-sm">
                                <div class="flex items-start gap-4">
                                    <span class="font-mono font-bold text-green-700 shrink-0">&lt;30</span>
                                    <span class="text-gray-600">%15-20 aneuploidi oranı</span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-amber-600 shrink-0">35-37</span>
                                    <span class="text-gray-600">%40-50 aneuploidi oranı</span>
                                </div>
                                <div class="flex items-start gap-4 border-t border-gray-200 pt-3">
                                    <span class="font-mono font-bold text-red-600 shrink-0">&gt;40</span>
                                    <span class="text-gray-600">%60-70 aneuploidi oranı</span>
                                </div>
                            </div>
                            <p class="text-xs text-gray-600 mt-3">Kaynak: Franasiak et al., Fertil Steril, 2020</p>
                        </div>
                        <a href="/genetik-testler/" class="inline-flex items-center gap-2 text-primary-600 font-semibold text-sm hover:underline">
                            <span class="material-symbols-outlined text-base">arrow_forward</span>
                            Genetik testler hakkında detaylı makale
                        </a>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <div class="relative group">
                        <img class="rounded-2xl shadow-xl w-full" src="/images/library/embriyo/kimyasal-gebelik.webp" alt="PGT-A analiz" width="512" height="512" loading="lazy"/>
                        <div class="absolute -bottom-6 -left-6 bg-gray-100 p-4 rounded-lg hidden md:block">
                            <p class="text-xs font-bold text-primary-600 tracking-widest uppercase mb-1">Klinik Veri</p>
                            <p class="text-2xl font-headline">%98</p>
                            <p class="text-[10px] text-gray-600">Doğruluk oranı (NGS)</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 3: PGT-M -->
        <section id="pgt-m" class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row gap-16 items-center">
                    <div class="md:w-1/2">
                        <h2 class="font-headline text-3xl text-gray-900 mb-6">3. PGT-M (Monogenik Hastalıklar)</h2>
                        <div class="space-y-6 text-gray-600">
                            <p>
                                PGT-M, ailede bilinen tek gen hastalığı riski olduğunda kullanılan hedefli bir testtir. Kistik fibrozis, SMA (spinal musküler atrofi), talasemi veya Huntington hastalığı gibi durumlarda amaç, embriyoları genel olarak "iyi-kötü" diye ayırmak değil; ailedeki belirli genetik riski taşıyıp taşımadığını anlamaktır.
                            </p>
                            <p>
