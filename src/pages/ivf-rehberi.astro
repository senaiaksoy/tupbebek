---
import { safeJsonLdStringify } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildHubItemListSchema } from '../utils/hubStructuredData';

const faqs = [
    {
        q: "IVF tedavisi ağrılı mıdır?",
        a: "Yumurta toplama işlemi sedasyon altında yapıldığı için ağrı hissedilmez. İğne uygulamaları hafif bir batma hissi verebilir. Embriyo transferi genellikle ağrısızdır."
    },
    {
        q: "Kaç embriyo transfer edilmelidir?",
        a: "Güncel tıbbi kılavuzlar, çoğul gebelik riskini azaltmak için tek embriyo transferini (eSET) önermektedir. Doktorunuz yaş ve embriyo kalitesine göre en uygun sayıyı belirleyecektir."
    },
    {
        q: "Transfer sonrası yatak istirahati gerekli midir?",
        a: "Güncel kanıtlar, transfer sonrası uzun süreli yatak istirahatinin gerekli olmadığını göstermektedir. Normal günlük aktivitelere devam edilebilir; ancak ağır egzersizden kaçınılması önerilir."
    },
    {
        q: "IVF kaç kez denenebilir?",
        a: "Tıbbi bir üst sınır yoktur. Ancak her deneme sonrası doktorunuz tedavi yanıtını değerlendirecek ve en uygun stratejiyi birlikte belirleyeceksiniz. Araştırmalar, kümülatif başarı oranının 3-6 siklusa kadar artmaya devam ettiğini göstermektedir."
    }
];

const ivfDecisionLinks = [
    {
        href: '/tani-sureci',
        label: '1. Tanı ve uygunluk',
        title: 'IVF ne zaman gündeme gelir?',
        description: 'Kadın ve erkek değerlendirmesi, infertilite süresi, yaş, AMH, semen analizi ve rahim/tüp bulguları birlikte okunur.'
    },
    {
        href: '/makaleler/ivf-protokolleri',
        label: '2. Uyarım planı',
        title: 'Protokol, ilaç ve yumurta sayısı',
        description: 'Kısa/uzun protokol, beklenen yanıt ve kaç yumurta gerekir sorusu kişisel rezervle ilişkilidir.'
    },
    {
        href: '/makaleler/laboratuvar-raporu-yorumlama',
        label: '3. Laboratuvar',
        title: 'Döllenme, ICSI ve embriyo gelişimi',
        description: 'IVF/ICSI ayrımı, kültür süreci, embriyo kalitesi ve laboratuvar raporundaki terimler aynı karar zincirinin parçalarıdır.'
    },
    {
        href: '/transfer-sureci',
        label: '4. Transfer ve takip',
        title: 'Taze/FET, beta-hCG ve bekleme dönemi',
        description: 'Transfer günü, dondurulmuş embriyo transferi, progesteron desteği ve beta-hCG sonucu ayrı başlıklarda ele alınır.'
    },
    {
        href: '/basari-oranlari',
        label: '5. Başarı beklentisi',
        title: 'Yaş, rezerv ve embriyo kalitesi',
        description: 'Başarı oranı tek bir yüzdeyle değil; yaş grubu, over rezervi, sperm faktörü ve önceki denemelerle birlikte değerlendirilir.'
    },
    {
        href: '/makaleler/era-testi-iluzyon',
        label: '6. Add-on kararları',
        title: 'ERA, EmbryoGlue ve bağışıklık tedavileri',
        description: 'Ek uygulamalar rutin çözüm gibi değil, kanıt düzeyi ve kişisel öykü üzerinden tartışılması gereken seçeneklerdir.'
    }
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "https://tupbebek.com/ivf-rehberi/#faq",
    "isPartOf": { "@id": "https://tupbebek.com/ivf-rehberi/#webpage" },
    "mainEntity": faqs.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
    }))
};

const itemListSchema = buildHubItemListSchema({
    site: Astro.site,
    pagePath: '/ivf-rehberi/',
    name: 'IVF rehberi konu haritası',
    description: 'Tüp bebek tanı ve uygunluk, uyarım planı, laboratuvar, transfer, başarı beklentisi ve add-on kararlarını bağlayan ana IVF okuma yolu.',
    items: ivfDecisionLinks
});
---

<BaseLayout title="Tüp Bebek (IVF) Nasıl Olur? Adım Adım Rehber | tupbebek.com" description="Tüp bebek nasıl olur? IVF tedavisinin aşamaları: hazırlık, yumurta toplama, embriyo kültürü, transfer işlemleri, bekleme süreci ve üreme sağlığı açısından başarı beklentisi.">
    <Header />

    <script type="application/ld+json" is:inline set:html={safeJsonLdStringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLdStringify(itemListSchema)} />

    <main id="main-content" tabindex="-1" class="pt-20">
        <!-- Hero -->
        <header class="bg-surface-container-low pt-24 pb-20 px-4 md:px-8">
            <div class="max-w-4xl mx-auto">
                <nav class="flex items-center gap-2 mb-6 text-sm text-on-surface-variant font-label">
                    <a href="/">Anasayfa</a>
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                    <a href="/tedavi-yontemleri">Tedavi Yöntemleri</a>
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                    <span>IVF Rehberi</span>
                </nav>
                <h1 class="font-headline text-4xl md:text-5xl font-bold text-on-surface leading-tight mb-6">
                    Tüp Bebek (IVF) Nasıl Olur? <span class="text-primary">Adım Adım Rehber</span>
                </h1>
                <p class="text-lg text-on-surface-variant leading-relaxed max-w-3xl">
                    In vitro fertilizasyon (IVF), yumurta ve spermin laboratuvar ortamında birleştirilip oluşan embriyonun rahime yerleştirilmesidir. Bu rehber, tüp bebek tedavisinin başlıca aşamalarını sade bir harita olarak anlatır.
                </p>
                <p class="text-sm text-on-surface-variant leading-relaxed max-w-3xl mt-4">
                    İleri yaş veya azalmış rezerv varsa kararlar daha kişiselleşir. Seçim aşamasındaysanız tedavi akışını bu sayfayla; hekim ve laboratuvar değerlendirmesini <a href="/makaleler/istanbul-tup-bebek-doktoru" class="text-primary hover:underline">İstanbul tüp bebek doktoru seçimi</a> ve <a href="/makaleler/iyi-tup-bebek-merkezi" class="text-primary hover:underline">tüp bebek merkezi kontrol listesi</a> ile birlikte okumak daha net bir çerçeve verir.
                </p>
            </div>
        </header>

        <!-- İçerik -->
        <div class="max-w-4xl mx-auto px-4 md:px-8 py-16 space-y-16">

            <section id="konu-haritasi">
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-primary text-2xl">account_tree</span>
                    <h2 class="font-headline text-2xl font-bold text-on-surface">IVF Karar ve Okuma Haritası</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {ivfDecisionLinks.map((item) => (
                        <a href={item.href} class="rounded-2xl border border-outline-variant/15 bg-surface-container-lowest p-6 hover:bg-surface-container-low transition-colors">
                            <span class="text-xs font-semibold uppercase tracking-wider text-primary">{item.label}</span>
                            <h3 class="font-bold text-on-surface mt-2 mb-2">{item.title}</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">{item.description}</p>
                        </a>
                    ))}
                </div>
                <p class="text-xs text-on-surface-variant leading-relaxed mt-4">
                    Bu sayfa, <a href="/kadin-infertilitesi" class="text-primary hover:underline">kadın infertilitesi</a>, <a href="/erkek-infertilitesi" class="text-primary hover:underline">erkek infertilitesi</a>, <a href="/tedavi-yontemleri" class="text-primary hover:underline">tedavi yöntemleri</a> ve <a href="/transfer-sureci" class="text-primary hover:underline">transfer süreci</a> hub sayfalarına bağlanan ana IVF rehberidir.
                    Tedavi sürecindeki yaygın yanlış anlamaları ayrıca <a href="/makaleler/tup-bebek-yanlis-bilinenler" class="text-primary hover:underline">tüp bebekte yanlış bilinenler</a> rehberiyle kontrol edebilirsiniz.
                </p>
            </section>

            <!-- Kimler İçin Uygundur -->
            <section>
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-primary text-2xl">people</span>
                    <h2 class="font-headline text-2xl font-bold text-on-surface">IVF Kimlere Uygulanır?</h2>
                </div>
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-2xl p-8">
                    <ul class="space-y-4 text-on-surface-variant">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-tertiary mt-0.5 text-lg">check_circle</span>
                            <span>Tüp tıkanıklığı veya ciddi hasarı olan kadınlar</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-tertiary mt-0.5 text-lg">check_circle</span>
                            <span>Orta-ağır erkek kaynaklı infertilite (düşük sperm sayısı veya motilitesi)</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-tertiary mt-0.5 text-lg">check_circle</span>
                            <span>Endometriozis kaynaklı infertilite</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-tertiary mt-0.5 text-lg">check_circle</span>
                            <span>Açıklanamayan infertilite (diğer tedavilere yanıt alınamadığında)</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-tertiary mt-0.5 text-lg">check_circle</span>
                            <span>Azalmış over rezervi</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-tertiary mt-0.5 text-lg">check_circle</span>
                            <span>Genetik tarama gereksinimi olan çiftler (PGT ile birlikte)</span>
                        </li>
                    </ul>
                </div>
            </section>

            <!-- Tedavi Aşamaları -->
            <section>
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-primary text-2xl">timeline</span>
                    <h2 class="font-headline text-2xl font-bold text-on-surface">Tüp bebek nasıl olur? Tedavi aşamaları</h2>
                </div>

                <div class="space-y-6">
                    {[
                        { step: "1", icon: "clinical_notes", title: "Ön Değerlendirme ve Planlama", desc: "Hormon testleri (FSH, AMH, E2), ultrason ile antral folikül sayımı, sperm analizi ve gerekirse histeroskopi yapılır. Sonuçlara göre kişiye özel tedavi protokolü belirlenir." },
                        { step: "2", icon: "medication", title: "Over Stimülasyonu (8-14 Gün)", desc: "Gonadotropin iğneleri ile yumurtalıkların uyarılması başlar. Düzenli ultrason ve kan testi takipleriyle folikül büyümesi izlenir. Foliküller yeterli büyüklüğe ulaştığında tetikleme iğnesi (hCG veya GnRH agonist) yapılır." },
                        { step: "3", icon: "egg", title: "Yumurta Toplama (OPU)", desc: "Tetikleme iğnesinden 34-36 saat sonra, hafif sedasyon altında transvajinal ultrason eşliğinde yumurtalar toplanır. İşlem yaklaşık 15-20 dakika sürer." },
                        { step: "4", icon: "science", title: "Döllenme ve Embriyo Kültürü", desc: "Toplanan yumurtalar aynı gün sperm ile birleştirilir. Klasik IVF veya ICSI (mikroenjeksiyon) yöntemi kullanılır. Embriyolar 3-5 gün boyunca laboratuvarda kültüre edilir." },
                        { step: "5", icon: "transfer_within_a_station", title: "Embriyo Transferi", desc: "En kaliteli embriyo(lar) ince bir kateter ile rahim içine yerleştirilir. İşlem ağrısızdır ve anestezi gerektirmez. Güncel kılavuzlar tek embriyo transferini önerir." },
                        { step: "6", icon: "monitor_heart", title: "Bekleme Süreci ve Beta-hCG", desc: "Transferden 12-14 gün sonra kan testi (beta-hCG) ile gebelik kontrolü yapılır. Bu süreçte progesteron desteği uygulanır." }
                    ].map(item => (
                        <div class="flex gap-6 items-start">
                            <div class="shrink-0 w-14 h-14 rounded-2xl bg-primary-container flex items-center justify-center">
                                <span class="material-symbols-outlined text-primary text-xl">{item.icon}</span>
                            </div>
                            <div>
                                <h3 class="font-headline text-lg font-bold text-on-surface mb-2">
                                    <span class="text-primary mr-2">Adım {item.step}:</span>{item.title}
                                </h3>
                                <p class="text-on-surface-variant leading-relaxed">{item.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Karar Noktaları -->
            <section>
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-primary text-2xl">route</span>
                    <h2 class="font-headline text-2xl font-bold text-on-surface">Tüp bebek sürecinde hangi kritik kararlar verilir?</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <a href="/makaleler/embryoscope-yapay-zeka" class="rounded-2xl border border-outline-variant/15 bg-surface-container-lowest p-6 hover:bg-surface-container-low transition-colors">
                        <span class="material-symbols-outlined text-primary mb-3">movie_filter</span>
                        <h3 class="font-bold text-on-surface mb-2">EmbryoScope ve yapay zeka</h3>
                        <p class="text-sm text-on-surface-variant leading-relaxed">Time-lapse izleme ve algoritmalar embriyo seçimini nasıl destekler?</p>
                    </a>
                    <a href="/makaleler/era-testi-iluzyon" class="rounded-2xl border border-outline-variant/15 bg-surface-container-lowest p-6 hover:bg-surface-container-low transition-colors">
                        <span class="material-symbols-outlined text-primary mb-3">biotech</span>
                        <h3 class="font-bold text-on-surface mb-2">ERA testi ve reseptivite</h3>
                        <p class="text-sm text-on-surface-variant leading-relaxed">Rutin kullanım, tekrarlayan başarısızlık ve canlı doğum verileri.</p>
                    </a>
                    <a href="/makaleler/bagisiklik-tedavileri" class="rounded-2xl border border-outline-variant/15 bg-surface-container-lowest p-6 hover:bg-surface-container-low transition-colors">
                        <span class="material-symbols-outlined text-primary mb-3">immunology</span>
                        <h3 class="font-bold text-on-surface mb-2">Bağışıklık tedavileri</h3>
                        <p class="text-sm text-on-surface-variant leading-relaxed">İmmün serumlar ve add-on tedavilerde beklenti nasıl kurulmalı?</p>
                    </a>
                    <a href="/makaleler/kimyasal-gebelik" class="rounded-2xl border border-outline-variant/15 bg-surface-container-lowest p-6 hover:bg-surface-container-low transition-colors">
                        <span class="material-symbols-outlined text-primary mb-3">labs</span>
                        <h3 class="font-bold text-on-surface mb-2">Kimyasal gebelik</h3>
                        <p class="text-sm text-on-surface-variant leading-relaxed">Beta-hCG pozitifliği sonrası erken kayıp nasıl yorumlanır?</p>
                    </a>
                </div>
            </section>

            <!-- Başarı Oranları -->
            <section>
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-primary text-2xl">trending_up</span>
                    <h2 class="font-headline text-2xl font-bold text-on-surface">Tüp bebek başarı oranları nelerdir?</h2>
                </div>
                <div class="bg-primary-container/30 border border-primary/10 rounded-2xl p-8">
                    <p class="text-on-surface-variant leading-relaxed mb-4">
                        IVF başarı oranları yaş, over rezervi, infertilite nedeni ve embriyo kalitesine göre değişkenlik gösterir. Genel olarak:
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6">
                        <div class="text-center">
                            <div class="text-3xl font-bold text-primary mb-1">%40-50</div>
                            <div class="text-sm text-on-surface-variant">35 yaş altı</div>
                        </div>
                        <div class="text-center">
                            <div class="text-3xl font-bold text-primary mb-1">%25-35</div>
                            <div class="text-sm text-on-surface-variant">35-40 yaş arası</div>
                        </div>
                        <div class="text-center">
                            <div class="text-3xl font-bold text-primary mb-1">%10-20</div>
                            <div class="text-sm text-on-surface-variant">40 yaş üstü</div>
                        </div>
                    </div>
                    <p class="text-xs text-on-surface-variant mt-6 italic">
                        Bu oranlar genel literatür verilerine dayanmaktadır. Bireysel başarı oranları doktorunuz tarafından değerlendirilmelidir.
                    </p>
                    <p class="text-sm text-on-surface-variant mt-4">
                        Daha ayrıntılı yorum için <a href="/makaleler/yasa-gore-tup-bebek-basari-oranlari" class="text-primary hover:underline">yaşa göre tüp bebek başarı oranları</a> ve <a href="/makaleler/kac-yumurta-gerekir" class="text-primary hover:underline">yumurta sayısı beklentisi</a> rehberlerini birlikte okuyabilirsiniz.
                    </p>
                </div>
            </section>

            <!-- Sık Sorulan Sorular -->
            <section>
                <div class="flex items-center gap-3 mb-6">
                    <span class="material-symbols-outlined text-primary text-2xl">help</span>
                    <h2 class="font-headline text-2xl font-bold text-on-surface">Sık Sorulan Sorular</h2>
                </div>
                <div class="space-y-6">
                    {faqs.map(({ q, a }) => (
                        <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-6">
                            <h3 class="font-bold text-on-surface mb-2">{q}</h3>
                            <p class="text-on-surface-variant text-sm leading-relaxed">{a}</p>
                        </div>
                    ))}
                </div>
            </section>

            <!-- CTA -->
            <section class="bg-surface-container-low border border-outline-variant/15 rounded-2xl p-8 md:p-12 text-center">
                <span class="material-symbols-outlined text-primary text-4xl mb-4 block">medical_information</span>
                <h2 class="font-headline text-2xl font-bold text-on-surface mb-4">Tedavi Sürecinize Hazır Olun</h2>
                <p class="text-on-surface-variant leading-relaxed max-w-2xl mx-auto mb-6">
                    Her hastanın tedavi süreci farklıdır. Kişiye özel değerlendirme için doktorunuzla görüşmenizi öneririz.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/tedavi-yontemleri" class="px-6 py-3 bg-primary text-on-primary rounded-xl font-semibold text-sm hover:bg-primary-dim transition-colors inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">arrow_back</span>
                        Tüm Tedavi Yöntemleri
                    </a>
                    <a href="/basari-oranlari/" class="px-6 py-3 bg-surface-container-lowest border border-outline-variant/30 text-on-surface rounded-xl font-semibold text-sm hover:bg-surface-container transition-colors inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">insights</span>
                        Başarı Oranları
                    </a>
                </div>
            </section>
        </div>
    </main>

    <Footer />
</BaseLayout>
