---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatsStrip from '../components/StatsStrip.astro';
import RelatedContent from '../components/RelatedContent.astro';
import DisclaimerBar from '../components/DisclaimerBar.astro';
import ReferenceList from '../components/ReferenceList.astro';

// Her kaynak PubMed üzerinden doğrulandı (Eylül 2026).
const references = [
    { title: "Female age-related fertility decline. Committee Opinion No. 589", type: "guideline" as const, authors: "American College of Obstetricians and Gynecologists; Practice Committee of the American Society for Reproductive Medicine", journal: "Fertility and Sterility", year: 2014, doi: "10.1016/j.fertnstert.2013.12.032", pmid: "24559617" },
    { title: "The nature of aneuploidy with increasing age of the female partner: a review of 15,169 consecutive trophectoderm biopsies evaluated with comprehensive chromosomal screening", authors: "Franasiak JM, Forman EJ, Hong KH et al.", journal: "Fertility and Sterility", year: 2014, doi: "10.1016/j.fertnstert.2013.11.004", pmid: "24355045" },
    { title: "Consistent age-dependent declines in human semen quality: a systematic review and meta-analysis", type: "systematicReview" as const, authors: "Johnson SL, Dunleavy J, Gemmell NJ, Nakagawa S", journal: "Ageing Research Reviews", year: 2015, doi: "10.1016/j.arr.2014.10.007", pmid: "25462195" },
    { title: "Predicting the chances of a live birth after one or more complete cycles of in vitro fertilisation: population based study of linked cycle data from 113 873 women", authors: "McLernon DJ, Steyerberg EW, Te Velde ER, Lee AJ, Bhattacharya S", journal: "BMJ", year: 2016, doi: "10.1136/bmj.i5735", pmid: "27852632" }
];
---

<BaseLayout title="Yaş ve Fertilite: Üreme Başarısı Üzerinde Yaşın Etkileri | tupbebek.com" description="Kadın ve erkek yaşının fertilite ve tüp bebek başarısı üzerindeki etkisi, yaşlanma ve oosit kalitesi, erkek yaşının sperm parametrelerine etkisi.">
    <Header />

    <main id="main-content" tabindex="-1" class="pb-24">
        <!-- Hero Section -->
        <header class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-20">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="flex-1">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-mint-100 text-mint-700 rounded-full text-xs font-semibold uppercase tracking-wider mb-6">
                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">schedule</span>
                        Biyolojik Etken
                    </div>
                    <h1 class="font-headline text-5xl md:text-6xl text-gray-900 leading-tight mb-8">
                        Yaş ve Doğurganlık: <span class="text-primary-600 italic">Zaman</span> Belirleyici Unsur
                    </h1>
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border-l-4 border-primary">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200">
                            <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                        </div>
                        <div>
                            <p class="font-headline italic text-gray-900 text-sm">İnceleme:</p>
                            <p class="font-bold text-primary-600">Yayın Kurulu</p>
                        </div>
                    </div>
                </div>
                <div class="hidden md:block w-72 shrink-0 aspect-[4/5] bg-gray-100 rounded-2xl overflow-hidden shadow-2xl">
                    <img class="w-full h-full object-cover" src="/images/library/embriyo/yumurta-sayisi.webp" alt="Mikroenjeksiyon pipetleri arasında ışıkla aydınlatılmış yumurta hücreleri" width="512" height="512" loading="eager" fetchpriority="high"/>
                </div>
            </div>
        </header>

        <!-- Introduction -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-body italic mb-12">
                Üreme sağlığında yaş, en belirleyici etkenlerden biridir. Kadınlar sınırlı sayıda yumurta ile doğar; bu rezerv zamanla azalır ve yumurtaların kromozom açısından normal olma oranı düşer. Erkeklerde ise yaş, sperm parametrelerini ve DNA fragmentasyonunu etkiler. Bu rehberde yaşın üreme başarı üzerindeki bilimsel etkisini inceleyeceğiz.
            </p>
            <StatsStrip items={[
              { icon: 'fertile', heading: '32 yaş', text: 'Doğurganlık bu yaştan itibaren yavaş ama belirgin azalır [1]' },
              { icon: 'trending_down', heading: '37+ hızlanma', text: '37 yaşından sonra düşüş hızlanır [1]' },
              { icon: 'science', heading: 'Kromozom', text: 'Yaş arttıkça kromozomu bozuk yumurta (anöploidi) oranı artıyor' }
            ]} />
        </section>

        <!-- Kadın Yaşı -->
        <section class="bg-gray-50 py-24 mb-24">
            <div class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8">
                <h2 class="font-headline text-3xl text-gray-900 mb-12">Kadın yaşı tüp bebek başarısını nasıl etkiler?</h2>
                <div class="space-y-6 text-gray-600">
                    <p>
                        Kadının yaşı, tüp bebek (IVF) sonucunu belirleyen en güçlü etkendir.<sup>[4]</sup> Bunun nedeni, doğuştan var olan yumurta (oosit) havuzunun yaşla hem sayıca azalması hem de kromozomu normal yumurta oranının düşmesidir. Bu biyolojik süreç hormon tedavisiyle geri çevrilemez.
                    </p>
                    <div class="bg-white border-l-4 border-primary rounded-xl p-6">
                        <h4 class="font-bold text-gray-900 mb-4">Yaşa göre doğurganlık:</h4>
                        <ul class="space-y-2 text-sm">
                            <li>• <strong>32 yaşa kadar:</strong> Doğurganlık en yüksek düzeydedir.</li>
                            <li>• <strong>32-37 yaş:</strong> Yavaş ama belirgin bir azalma başlar.<sup>[1]</sup></li>
                            <li>• <strong>37 yaş sonrası:</strong> Düşüş hızlanır; düşük riski de artar.<sup>[1]</sup></li>
                            <li>• <strong>42-44 yaş:</strong> IVF'te blastokist elde edilen kadınların 42 yaşta yaklaşık üçte birinde, 44 yaşta yarısından fazlasında hiç kromozomu normal embriyo bulunmaz.<sup>[2]</sup></li>
                        </ul>
                        <p class="text-sm mt-4">Bu nedenle 35 yaş üzerinde 6 ay denemeden sonra, 40 yaş üzerinde ise beklemeden değerlendirme önerilir.<sup>[1]</sup></p>
                    </div>
                    <p>
                        IVF başarısı da benzer trend gösterir. Yaşa göre ayrıntılı veriler <a href="/basari-oranlari/" class="text-primary-600 hover:underline">başarı oranları</a> sayfasında yer alıyor. Daha fazla bilgi için <a href="/kadin-infertilitesi/" class="text-primary-600 hover:underline">kadın kısırlığı</a> rehberine bakabilirsiniz.
                    </p>
                </div>
            </div>
        </section>

        <!-- Erkek Yaşı -->
        <section class="max-w-5xl mx-auto px-4 md:px-6 lg:px-8 mb-24">
            <h2 class="font-headline text-3xl text-gray-900 mb-12">Erkek yaşı sperm kalitesi ve fertiliteyi nasıl etkiler?</h2>
            <div class="space-y-6 text-gray-600">
                <p>
                    Erkek yaşının etkisi kadın yaşı kadar belirgin değildir, ama yok sayılmamalıdır. 90 çalışmayı ve 93 binden fazla erkeği kapsayan bir meta-analizde, yaş ilerledikçe semen hacmi, hareketlilik ve normal şekilli sperm oranı azaldı, DNA hasarı arttı; sperm yoğunluğu ise yaşla belirgin değişmedi.<sup>[3]</sup>
                </p>
                <div class="bg-white border-l-4 border-primary rounded-xl p-6">
                    <h4 class="font-bold text-gray-900 mb-4">Yaşla değişen sperm özellikleri:<sup>[3]</sup></h4>
                    <ul class="space-y-2 text-sm">
                        <li>• <strong>Azalanlar:</strong> Semen hacmi, toplam ve ileri hareketlilik, normal şekil oranı</li>
                        <li>• <strong>Artan:</strong> Sperm DNA hasarı (fragmantasyon)</li>
                        <li>• <strong>Belirgin değişmeyen:</strong> Sperm yoğunluğu</li>
                    </ul>
                </div>
                <p>
                    Erkek üreme etkenleri için <a href="/erkek-infertilitesi" class="text-primary-600 hover:underline">erkek kısırlığı rehberine</a> bakabilirsiniz.
                </p>
            </div>
        </section>

        <!-- İlgili Kaynaklar -->
        <RelatedContent items={[
          { href: '/kadin-infertilitesi', icon: 'woman', title: 'Kadınlarda Kısırlık', description: 'Yaşın nedenler üzerindeki etkisi' },
          { href: '/erkek-infertilitesi', icon: 'man', title: 'Erkeklerde Kısırlık', description: 'Erkek yaşının etkisi' },
          { href: '/basari-oranlari', icon: 'trending_up', title: 'Başarı Oranları', description: 'Yaşa göre IVF başarı verileri' }
        ]} />

        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <ReferenceList references={references} />
        </section>

        <!-- Doktor Onay -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-primary flex flex-col md:flex-row items-center gap-8">
                <div class="w-20 h-20 rounded-full overflow-hidden bg-gray-200 shrink-0">
                    <span class="material-symbols-outlined text-primary-600 text-2xl">verified</span>
                </div>
                <div>
                    <p class="font-headline text-lg text-gray-900 mb-1">Yayın Kurulu</p>
                    <p class="text-sm text-gray-600">
                        Bu rehber, üreme sağlığı alanında uzman <strong class="text-primary-600">tupbebek.com yayın kurulu</strong> tarafından tıbbi açıdan incelenmiş ve onaylanmıştır.
                    </p>
                </div>
            </div>
        </section>

        <!-- Yasal Uyarı -->
        <section class="max-w-3xl mx-auto px-4 md:px-6 lg:px-8">
            <DisclaimerBar title="Yasal Uyarı">
                Bu rehber genel bilgilendirme amaçlıdır. Yaş ve fertilite hakkında kişisel kararlar için lütfen bir üreme sağlığı uzmanına danışınız. tupbebek.com, bu bilgilere dayanılarak alınan kararlardan sorumlu tutulamaz.
            </DisclaimerBar>
        </section>
    </main>

    <Footer />
</BaseLayout>
