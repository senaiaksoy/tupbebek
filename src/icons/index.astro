---
import ArrowLeft from "./ArrowLeft.astro";
import ArrowRight from "./ArrowRight.astro";
import Envelope from "./Envelope.astro";
import Exclamation from "./Exclamation.astro";
import Facebook from "./Facebook.astro";
import Globe from "./Globe.astro";
import Instagram from "./Instagram.astro";
import Whatsapp from "./Whatsapp.astro";
import Youtube from "./Youtube.astro";
import MapPin from "./MapPin.astro";
import Navigation from "./Navigation.astro";
import Copy from "./Copy.astro";
import Menu from "./Menu.astro";

const Icons = {
  arrowLeft: ArrowLeft,
  arrowRight: ArrowRight,
  envelope: Envelope,
  mail: Envelope,
  phone: Whatsapp,
  globe: Globe,
  instagram: Instagram,
  facebook: Facebook,
  youtube: Youtube,
  whatsapp: Whatsapp,
  exclamation: Exclamation,
  "map-pin": MapPin,
  mapPin: MapPin,
  navigation: Navigation,
  copy: Copy,
  menu: Menu,
};

const { name = "arrowRight", size = "medium" } = Astro.props;
const IconComponent = Icons[name];
const classNames = `icon ${size}`;
---

<span class={classNames}>{IconComponent ? <IconComponent /> : <span>Icon not found: {name}</span>}</span>

<style is:global lang="scss">
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    width: var(--spacing-medium);

    svg {
      width: 100%;
      height: 100%;
    }

    &.small {
      width: var(--spacing-small);
    }

    &.medium {
      width: var(--spacing-medium);
    }

    &.big {
      width: var(--spacing-big);
    }

    &.large {
      width: var(--spacing-large);
    }
  }
</style>
