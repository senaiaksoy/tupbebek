{
  "name": "stitch-tupbebek",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/enrich-pmids.mjs --apply && node scripts/build-image-manifest.mjs && node scripts/build-search-index.mjs",
    "build": "astro build && node scripts/postbuild-seo.mjs && echo _worker.js > dist/.assetsignore && npx pagefind --site dist --glob \"makaleler/**/*.html\"",
    "deploy": "node scripts/deploy-pages.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "verify:seo": "node scripts/verify-seo-canonicalization.mjs",
    "verify:preflight": "node scripts/run-qa-preflight.mjs",
    "verify:placeholder-links": "node scripts/verify-no-placeholder-links.mjs",
    "verify:link-hygiene": "node scripts/verify-link-hygiene.mjs",
    "verify:broken-links": "node scripts/verify-broken-links.mjs",
    "verify:html-weight": "node scripts/verify-html-weight.mjs",
    "verify:ai-search": "npm run verify:article-template && npm run verify:llms-hygiene && npm run verify:llms-priority-targets && npm run verify:preferred-source-cta",
    "verify:article-template": "node scripts/verify-ai-search-readiness.mjs",
    "verify:ai-search-readiness": "node scripts/verify-ai-search-readiness.mjs",
    "verify:llms-hygiene": "node scripts/verify-llms-hygiene.mjs",
    "verify:llms-priority-targets": "node scripts/verify-llms-priority-targets.mjs",
    "verify:preferred-source-cta": "node scripts/verify-preferred-source-cta.mjs",
    "verify:nosnippet-boilerplate": "node scripts/verify-nosnippet-boilerplate.mjs",
    "verify:title-lengths": "node scripts/verify-title-lengths.mjs",
    "verify:article-entities": "node scripts/verify-article-entities.mjs",
    "verify:hub-itemlists": "node scripts/verify-hub-itemlists.mjs",
    "verify:article-clusters": "node scripts/verify-article-clusters.mjs",
    "verify:structured-data": "node scripts/verify-structured-data.mjs",
    "verify:semrush-audit": "node scripts/verify-semrush-audit.mjs",
    "verify:live-semrush": "node scripts/verify-live-semrush.mjs",
    "verify:live-semrush:pending-hsts": "node scripts/verify-live-semrush.mjs --allow-pending-www-hsts",
    "verify:deploy-target": "node scripts/verify-deploy-target.mjs",
    "verify:agentic-seo": "agentic-seo",
    "pmid:enrich": "node scripts/enrich-pmids.mjs",
    "pmid:enrich:apply": "node scripts/enrich-pmids.mjs --apply"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/mdx": "^3.1.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.15.0",
    "pdf-to-img": "^4.5.0",
    "resend": "^6.10.0",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "agentic-seo": "^1.0.0",
    "pagefind": "^1.5.0",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
